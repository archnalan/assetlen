@implements IDisposable
@inject ILogger<ArtifactThumb> Logger

@*
    A stored picture — a search result, a frame in the brief, a receipt being
    marked up. Artifact bytes sit behind the authenticated endpoint, so an
    <img src> cannot reach them — the frame is fetched through the Refit
    pipeline and shown from memory. Shimmer while it comes, an icon when there
    is no picture to show.
*@

<span class="athumb @(Cover ? "athumb--cover" : "") @(Natural ? "athumb--natural" : "") @(phase == LoadPhase.Loading ? "al-shimmer" : "")">
    @if (phase == LoadPhase.Ready && src is not null)
    {
        @if (Natural)
        {
            @* A markup layer is drawn in fractions of the image, so it sits
               over the picture's own box — never over letterboxing. *@
            <span class="athumb__frame">
                <img class="athumb__img" src="@src" alt="@Alt" loading="@(Full ? "eager" : "lazy")" />
                @if (Overlay is not null)
                {
                    <span class="athumb__overlay">@Overlay</span>
                }
            </span>
        }
        else
        {
            <img class="athumb__img" src="@src" alt="@Alt" loading="lazy" />
        }
    }
    else if (phase != LoadPhase.Loading)
    {
        <Icon Name="@(IsImage ? "image" : "document")" Size="22" Class="athumb__icon" Weight="1.5" />
    }
</span>

@code {
    [Parameter, EditorRequired] public string ArtifactId { get; set; } = "";
    [Parameter] public bool HasThumbnail { get; set; }
    [Parameter] public string? MimeType { get; set; }

    /// <summary>Fill the frame rather than fit it — for a site photo, where the edges are sky, not the total on a receipt.</summary>
    [Parameter] public bool Cover { get; set; }

    /// <summary>The original rather than the scaled copy — a receipt has to be legible to be marked up.</summary>
    [Parameter] public bool Full { get; set; }

    /// <summary>Show the picture at its own aspect, so an overlay drawn in fractions of it lines up.</summary>
    [Parameter] public bool Natural { get; set; }

    [Parameter] public RenderFragment? Overlay { get; set; }
    [Parameter] public string Alt { get; set; } = "";

    private LoadPhase phase = LoadPhase.Loading;
    private string? src;
    private string? loadedKey;
    private readonly CancellationTokenSource cts = new();

    private bool IsImage => MimeType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{ArtifactId}/{Full}";
        if (loadedKey == key) return;
        loadedKey = key;
        src = null;

        if (!HasThumbnail && !(Full && IsImage))
        {
            phase = LoadPhase.Empty;
            return;
        }

        phase = LoadPhase.Loading;
        try
        {
            using var response = Full
                ? await _artifactsApi.Download(ArtifactId)
                : await _artifactsApi.DownloadThumbnail(ArtifactId);
            if (cts.IsCancellationRequested) return;
            if (!response.IsSuccessStatusCode)
            {
                phase = LoadPhase.Error;
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var type = response.Content.Headers.ContentType?.MediaType ?? "image/jpeg";
            src = $"data:{type};base64,{Convert.ToBase64String(bytes)}";
            phase = LoadPhase.Ready;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Picture {ArtifactId} did not load", ArtifactId);
            phase = LoadPhase.Error;
        }
    }

    public void Dispose() => cts.Cancel();
}
