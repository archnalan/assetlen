@*
    One navigation component, two presentations: a permanent rail from 900px up,
    and the contents of the summoned drawer below it. Writing it twice is how
    the two old shells drifted apart.

    The rail lists projects by name, with sub-projects indented under their
    parent — because a guest wing is part of a residence, and a flat list of
    "projects" was the mistake that turned one engagement into nine.

    The order and the pins are the reader's own and are stored per user: two
    people on one engagement each arrange their own sidebar.

    Two markers, and only two (see AttentionState):

      · a **number** when the reader owes something here. It clears when the
        item is resolved, never by being looked at.
      · a **dot** when something moved here since the reader last opened it. It
        clears on the visit.

    A project never carries both. If you owe something on it, the number is the
    stronger statement and the dot would only add noise. Nothing appears at all
    until the scan finishes, so the rail never flashes a row of zeroes.
*@

@implements IAsyncDisposable
@inject ShellState Shell
@inject AttentionState Attention
@inject ProjectMenuState Menu
@inject NavigationManager Nav
@inject ILogger<NavRail> Logger

<nav class="rail @(InDrawer ? "rail--drawer" : "rail--fixed")" aria-label="Projects and sections">

    @if (InDrawer)
    {
        <div class="rail__head">
            <a href="/" class="rail__brand">
                <BrandMark Size="22" />
                <span class="rail__wordmark">ASSETLEN</span>
            </a>
            <button type="button" class="al-iconbtn" @onclick="Shell.CloseDrawer" aria-label="Close navigation">
                <Icon Name="close" Size="20" />
            </button>
        </div>
    }

    <div class="rail__scroll">
        <ul class="rail__list">
            <li>
                <a href="/" class="rail__link @Active("/", exact: true)">
                    <Icon Name="grid" Size="18" />
                    <span>Home</span>
                </a>
            </li>
            <li>
                <a href="/needs-you" class="rail__link @Active("/needs-you")">
                    <Icon Name="decision" Size="18" />
                    <span>Needs you</span>
                    @if (Attention.Loaded && Attention.Count > 0)
                    {
                        <span class="al-spacer"></span>
                        <span class="al-count @(Attention.OverdueCount > 0 ? "al-count--overdue" : "")"
                              title="@CountLabel(Attention.Count)" aria-label="@CountLabel(Attention.Count)">
                            @Attention.Count
                        </span>
                    }
                </a>
            </li>
            <li>
                <a href="/search" class="rail__link @Active("/search")">
                    <Icon Name="search" Size="18" />
                    <span>Search</span>
                </a>
            </li>
        </ul>

        @if (!Shell.ProjectsLoaded)
        {
            <div class="rail__section">
                <span class="al-label">Your projects</span>
            </div>
            <div class="rail__loading" aria-hidden="true">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="al-shimmer rail__ghost"></div>
                }
            </div>
        }
        else if (Shell.Cards.Count == 0)
        {
            <div class="rail__section">
                <span class="al-label">Your projects</span>
            </div>
            <p class="rail__empty">No projects yet.</p>
        }
        else
        {
            @* Pinned rows are not draggable: a pin says this one stays put. *@
            @if (Shell.PinnedCount > 0)
            {
                <div class="rail__section">
                    <span class="al-label">Pinned</span>
                </div>

                <ul class="rail__list rail__list--pinned">
                    @foreach (var project in Shell.Pinned)
                    {
                        @ProjectRow(project, pinned: true)
                    }
                </ul>
            }

            <div class="rail__section">
                <span class="al-label">@(Shell.PinnedCount > 0 ? "Everything else" : "Your projects")</span>
            </div>

            @* The drop reports two indices and Blazor re-renders; the script
               never reorders the DOM itself, so screen and saved order agree. *@
            <ul class="rail__list rail__list--sortable" @ref="sortHost">
                @foreach (var project in Shell.Unpinned)
                {
                    @ProjectRow(project, pinned: false)
                }
            </ul>

            @if (Shell.Unpinned.Count() > 1 && !hintDismissed)
            {
                <p class="rail__hint">
                    <Icon Name="grip" Size="13" />
                    <span>Drag to rearrange. Right-click for more.</span>
                </p>
            }
        }

        <div class="rail__foot-action">
            @if (CanCreateProject)
            {
                <a href="/project/create" class="rail__link rail__link--muted">
                    <Icon Name="plus" Size="18" />
                    <span>New project</span>
                </a>
            }

            @* The bin sits under "New project" — a reader who has just deleted
               something looks for it where they made it. *@
            <a href="/archive" class="rail__link rail__link--muted @Active("/archive")">
                <Icon Name="archive" Size="18" />
                <span>Archive</span>
            </a>
        </div>
    </div>

    <div class="rail__foot">
        <span class="al-label">@FootNote</span>
    </div>
</nav>

@code {
    /// <summary>True when rendered inside the mobile drawer rather than as the permanent rail.</summary>
    [Parameter] public bool InDrawer { get; set; }

    private ElementReference sortHost;
    private DotNetObjectReference<NavRail>? selfRef;
    private bool sortRegistered;
    private bool dragging;
    private bool hintDismissed;

    // Distinct per presentation: the rail and the drawer are both live on a
    // tablet, and one id would have the visible list reorder the hidden one.
    private string SortId => InDrawer ? "rail-drawer" : "rail-fixed";

    protected override void OnInitialized()
    {
        Shell.OnChange += Refresh;
        Attention.OnChange += Refresh;
        Nav.LocationChanged += OnLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Shell.OnChange -= Refresh;
        Attention.OnChange -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;

        if (sortRegistered)
        {
            try { await JS.InvokeVoidAsync("assetlen.dragsort.unregister", SortId); }
            catch (Exception ex) { Logger.LogDebug(ex, "Could not release the rail sortable"); }
        }

        selfRef?.Dispose();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? _, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs __)
        => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Wait for the list to exist; binding to a null element silently leaves
        // the rail unsortable for the rest of the session.
        if (sortRegistered || !Shell.ProjectsLoaded || Shell.Cards.Count == 0) return;

        sortRegistered = true;
        selfRef ??= DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync("assetlen.dragsort.register", SortId, sortHost, selfRef);
        }
        catch (Exception ex)
        {
            // Without the script the rail is still a list of links.
            sortRegistered = false;
            Logger.LogDebug(ex, "Could not attach the rail sortable");
        }
    }

    /// <summary>Called by the sortable on drop, with positions within the unpinned list.</summary>
    [JSInvokable]
    public async Task OnReorder(int from, int to)
    {
        hintDismissed = true;

        if (!await Shell.ReorderAsync(from, to))
            ToastService.ShowWarning("That order didn't save. It will go back on the next refresh.");
    }

    [JSInvokable]
    public Task OnDragStateChanged(bool isDragging)
    {
        dragging = isDragging;
        if (isDragging) hintDismissed = true;
        return InvokeAsync(StateHasChanged);
    }

    // ── One row, parent or child ────────────────────────────────────────────

    private RenderFragment ProjectRow(ProjectCardDto project, bool pinned) =>
    @<li data-al-drag="@(pinned ? null : project.Id)" class="rail__item">

        <div class="rail__rowwrap">
            <a href="/project/@project.Id"
               class="rail__link @Active($"/project/{project.Id}")"
               @oncontextmenu="e => OpenMenu(e, project)" @oncontextmenu:preventDefault>

                @if (!pinned)
                {
                    <span class="rail__grip" data-al-grip aria-hidden="true">
                        <Icon Name="grip" Size="14" />
                    </span>
                }

                <ProjectMark Source="@Face(project)" Size="18" Fallback="project" />

                <span class="al-truncate rail__label">@project.ProjectName</span>

                @if (pinned)
                {
                    <Icon Name="pushpin" Size="12" Class="rail__pinmark" />
                }

                @Markers(project.Id)
            </a>

            @* A right-click is not a gesture a thumb has. *@
            <button type="button" class="rail__more al-iconbtn al-iconbtn--sm"
                    data-al-nodrag
                    @onclick="e => OpenMenu(e, project)"
                    aria-label="Actions for @project.ProjectName">
                <Icon Name="more" Size="16" />
            </button>
        </div>

        @if (project.SubProjects.Count > 0)
        {
            <ul class="rail__list rail__list--nested">
                @foreach (var child in project.SubProjects)
                {
                    <li>
                        <div class="rail__rowwrap">
                            <a href="/project/@child.Id"
                               class="rail__link rail__link--nested @Active($"/project/{child.Id}")"
                               @oncontextmenu="e => OpenMenu(e, child)" @oncontextmenu:preventDefault>

                                @* A wing wears the house's face until given one
                                   of its own; the fallback mark still differs. *@
                                <ProjectMark Source="@Face(child)" Size="16" Fallback="wing" />

                                <span class="al-truncate rail__label">@child.ProjectName</span>
                                @Markers(child.Id)
                            </a>

                            <button type="button" class="rail__more al-iconbtn al-iconbtn--sm"
                                    data-al-nodrag
                                    @onclick="e => OpenMenu(e, child)"
                                    aria-label="Actions for @child.ProjectName">
                                <Icon Name="more" Size="16" />
                            </button>
                        </div>
                    </li>
                }
            </ul>
        }
    </li>;

    private RenderFragment Markers(string projectId) =>
    @<text>
        @if (Attention.Loaded)
        {
            var owed = Attention.OwedOn(projectId);

            if (owed > 0)
            {
                <span class="al-spacer"></span>
                <span class="al-count" title="@CountLabel(owed)" aria-label="@CountLabel(owed)">@owed</span>
            }
            else if (Attention.HasUnseen(projectId))
            {
                <span class="al-spacer"></span>
                <span class="al-moved" role="img"
                      title="@Attention.UnseenReason(projectId)"
                      aria-label="@Attention.UnseenReason(projectId)"></span>
            }
        }
    </text>;

    /// <summary>A cover the reader chose wins; otherwise the most recent frame posted here.</summary>
    private static string? Face(ProjectCardDto p)
        => (string.IsNullOrWhiteSpace(p.CoverImageUrl) ? null : p.CoverImageUrl)
           ?? p.RecentImageUrls.FirstOrDefault(u => !string.IsNullOrWhiteSpace(u))
           ?? (string.IsNullOrWhiteSpace(p.LatestImageUrl) ? null : p.LatestImageUrl);

    private void OpenMenu(MouseEventArgs e, ProjectCardDto project)
    {
        // A menu opened mid-drag would be anchored to a pointer that has moved on.
        if (dragging) return;
        Menu.Open(project, e.ClientX, e.ClientY);
    }

    private static string CountLabel(int n)
        => n == 1 ? "1 item waiting on you" : $"{n} items waiting on you";

    private string Active(string href, bool exact = false)
    {
        var path = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/');
        var target = href.TrimEnd('/');

        if (exact) return path.Equals(target, StringComparison.OrdinalIgnoreCase) || (target.Length == 0 && path.Length == 0)
            ? "is-active" : "";

        return path.Equals(target, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(target + "/", StringComparison.OrdinalIgnoreCase)
            ? "is-active" : "";
    }

    // Only the account owner creates projects. The delivery side is invited in
    // and can be replaced without the record moving (assetlen.md D1).
    private bool CanCreateProject => _sd.CurrentUser?.RolesDto is { } r && (r.Contractor || r.Manager || r.SystemAdmin);

    /// <summary>
    /// The seat, not a side. A side is per project — the same person is client on
    /// one and mediator on another (CLAUDE.md §5.5) — so this used to tell Peter,
    /// who funds the work, that he was on the "Delivery side".
    /// </summary>
    private string FootNote => _sd.CurrentUser?.RolesDto switch
    {
        null => "Signed in",
        { SystemAdmin: true } => "Platform",
        { Contractor: true } => "Developer",
        { Manager: true } => "Mediator",
        { Client: true } => "Representative",
        { Crew: true } => "Delivery",
        _ => "Observer"
    };
}
