@*
    ASSETLEN icon set.

    One component, one visual language: 24-unit grid, stroked not filled,
    round caps and joins, 1.75 weight. Stroked marks sit correctly next to
    hairline rules; filled glyphs would read as heavier than the rules
    around them and break the drawing-sheet calm.

    Replaces FluentIcon everywhere. Usage:  <Icon Name="search" Size="16" />
*@

<svg class="al-icon @Class"
     width="@Size" height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="@Weight"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="@(Title is null ? "true" : "false")"
     role="@(Title is null ? null : "img")"
     focusable="false">
    @if (Title is not null)
    {
        <title>@Title</title>
    }
    @((MarkupString)Path(Name))
</svg>

