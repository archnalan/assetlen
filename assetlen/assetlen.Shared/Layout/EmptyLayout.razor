@using Radzen.Blazor
@inherits LayoutComponentBase


<div style=" width:100%; height:100vh ; overflow-y:scroll ">
    @Body

    <FluentDialogProvider />
    <FluentToastProvider MaxToastCount="10" />
    <RouteTracker />

</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Restore roles in case the user is already authenticated (e.g. navigated
        // back to login while still logged in) so that role-gated controls render
        // correctly if the layout is reused in other scenarios.
        await _userSession.RestoreUserRolesAsync();
    }
}




