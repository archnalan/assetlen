@using System.Diagnostics
@using Microsoft.AspNetCore.Authorization
@using Newtonsoft.Json
@* @attribute [Authorize] *@
@inject NavigationService NavService
@inject NavigationManager NavigationManager
@inject ISD _sd
@implements IDisposable

@* Mobile backdrop - positioned outside sidebar for proper layering *@
<div class="sidebar-backdrop @(mobileMenuOpen ? "sidebar-backdrop-visible" : "")" @onclick="CloseMobileMenu"></div>

<aside class="sidebar @(sidebarExpanded ? "" : "sidebar-collapsed") @(mobileMenuOpen ? "sidebar-mobile-open" : "")"
       @onkeydown="HandleKeyDown"       aria-label="Main navigation">

    @* === HEADER: Logo + Toggle === *@
    <div class="sidebar-header">
        <div class="sidebar-brand @(sidebarExpanded ? "" : "sidebar-brand-hidden")">
            <FluentIcon Value="@(new Icons.Regular.Size24.DocumentBulletList())" Color="Color.Accent" />
            <span class="sidebar-brand-text">ASSETLEN</span>
        </div>
        <div class="sidebar-header-actions">
            @* Close button for mobile *@
            <button class="sidebar-close-mobile" @onclick="CloseMobileMenu"                    title="Close menu"
                    aria-label="Close navigation menu">
                <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" />
            </button>
            @* Collapse/expand toggle for desktop *@
            <button class="sidebar-toggle" @onclick="ToggleSidebar"
                    title="@(sidebarExpanded ? "Collapse menu" : "Expand menu")"                    aria-expanded="@sidebarExpanded"
                    aria-label="Toggle navigation menu">
                @if (sidebarExpanded)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.ChevronLeft())" />
                }
                else
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.ChevronRight())" />
                }
            </button>
        </div>
    </div>

    @* === NAV CONTENT === *@
    <nav class="sidebar-nav" aria-label="Primary navigation">
        <ul class="sidebar-list" role="menubar">
            @foreach (var group in navigationStructure.Where(IsNavGroupVisible))
            {
                @RenderNavGroup(group, 0)
            }
        </ul>
    </nav>
</aside>

@code {
    private bool sidebarExpanded = true;
    private Dictionary<string, bool> expandedState = new();
    private List<NavGroup> navigationStructure = new();
    private Dictionary<string, List<string>> groupRelationships = new();
    private Dictionary<string, string> parentRelationships = new();

    // Flyout state for collapsed mode
    private string? hoveredGroupKey = null;
    private Dictionary<string, bool> flyoutSubgroupExpanded = new();
    private bool flyoutForceClosed = false;

    // Mobile menu state
    private bool mobileMenuOpen = false;

    /// <summary>Toggle mobile menu visibility (called from MainLayout)</summary>
    public void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
        if (mobileMenuOpen)
        {
            sidebarExpanded = true; // Always show expanded on mobile
        }
        StateHasChanged();
    }

    private void CloseMobileMenu()
    {
        mobileMenuOpen = false;
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        navigationStructure = NavService.BuildNavigationStructure();

        foreach (var group in navigationStructure)
        {
            InitializeGroupExpansionState(group);
            BuildGroupRelationships(group);
        }

        // Subscribe to navigation changes for instant active state updates
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Close mobile menu on navigation
        mobileMenuOpen = false;
        // Re-render to update active states immediately
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void ToggleSidebar()
    {
        sidebarExpanded = !sidebarExpanded;
        if (!sidebarExpanded)
        {
            // Reset flyout state when collapsing
            hoveredGroupKey = null;
            flyoutSubgroupExpanded.Clear();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !sidebarExpanded && hoveredGroupKey != null)
        {
            hoveredGroupKey = null;
            flyoutSubgroupExpanded.Clear();
            StateHasChanged();
        }
    }

    private void OnGroupMouseEnter(NavGroup group)
    {
        if (!sidebarExpanded && (group.Items.Count > 1 || group.SubGroups.Count > 0 || !string.IsNullOrEmpty(group.ParentPath)
== false))
        {
            hoveredGroupKey = group.FullPath;
            flyoutSubgroupExpanded.Clear();
            flyoutForceClosed = false; // Reset force close when hovering a new group
        }
    }

    private void OnGroupMouseLeave(NavGroup group)
    {
        // Flyout closing is handled via CSS :hover on the container
    }

    private void ToggleFlyoutSubgroup(string key)
    {
        if (flyoutSubgroupExpanded.ContainsKey(key))
        {
            flyoutSubgroupExpanded[key] = !flyoutSubgroupExpanded[key];
        }
        else
        {
            flyoutSubgroupExpanded[key] = true;
        }
    }

    private void NavigateAndClose(string href)
    {
        flyoutForceClosed = true; // Force close flyout immediately
        hoveredGroupKey = null;
        flyoutSubgroupExpanded.Clear();
        NavigationManager.NavigateTo(href);
    }

    private void InitializeGroupExpansionState(NavGroup group)
    {
        string key = group.FullPath;
        expandedState[key] = group.Expanded;

        foreach (var subGroup in group.SubGroups)
        {
            InitializeGroupExpansionState(subGroup);
        }
    }

    private void BuildGroupRelationships(NavGroup group)
    {
        string key = group.FullPath;

        if (!string.IsNullOrEmpty(group.ParentPath))
        {
            if (!groupRelationships.ContainsKey(group.ParentPath))
            {
                groupRelationships[group.ParentPath] = new List<string>();
            }

            if (!groupRelationships[group.ParentPath].Contains(key))
            {
                groupRelationships[group.ParentPath].Add(key);
            }

            parentRelationships[key] = group.ParentPath;
        }

        if (!groupRelationships.ContainsKey(key))
        {
            groupRelationships[key] = new List<string>();
        }

        foreach (var subGroup in group.SubGroups)
        {
            BuildGroupRelationships(subGroup);
        }
    }

    private void HandleGroupExpandChanged(bool expanded, NavGroup group)
    {
        string key = group.FullPath;
        expandedState[key] = expanded;

        if (expanded)
        {
            EnsureParentGroupsExpanded(group);
            CollapseSiblingGroups(group);
        }
        else
        {
            CollapseAllChildren(key);
        }
    }

    private void EnsureParentGroupsExpanded(NavGroup group)
    {
        string currentPath = group.ParentPath;
        while (!string.IsNullOrEmpty(currentPath))
        {
            expandedState[currentPath] = true;
            if (parentRelationships.ContainsKey(currentPath))
            {
                currentPath = parentRelationships[currentPath];
            }
            else
            {
                break;
            }
        }
    }

    private void CollapseSiblingGroups(NavGroup group)
    {
        string key = group.FullPath;

        if (string.IsNullOrEmpty(group.ParentPath))
        {
            foreach (var topGroup in navigationStructure)
            {
                if (topGroup.FullPath != key)
                {
                    expandedState[topGroup.FullPath] = false;
                    CollapseAllChildren(topGroup.FullPath);
                }
            }
        }
        else if (parentRelationships.ContainsKey(key))
        {
            string parentKey = parentRelationships[key];

            if (groupRelationships.ContainsKey(parentKey))
            {
                foreach (var siblingKey in groupRelationships[parentKey])
                {
                    if (siblingKey != key)
                    {
                        expandedState[siblingKey] = false;
                        CollapseAllChildren(siblingKey);
                    }
                }
            }
        }
    }

    private void CollapseAllChildren(string groupKey)
    {
        if (groupRelationships.ContainsKey(groupKey))
        {
            foreach (var childKey in groupRelationships[groupKey])
            {
                expandedState[childKey] = false;
                CollapseAllChildren(childKey);
            }
        }
    }

    private bool IsCurrentPage(string href)
    {
        var currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return currentUri.Equals(href, StringComparison.OrdinalIgnoreCase) ||
               (string.IsNullOrEmpty(currentUri) && href == "admin/dashboard");
    }

    private bool IsNavItemVisible(NavItem item)
    {
        // Phase-1.1 stub: NavMenu is reskinned around AppModule routes in
        // Phase 1.2 with RolePermissions.HasAccess(module). For now, gate
        // everything on tenant-admin visibility.
        var roles = _sd.CurrentUser?.RolesDto;
        if (roles == null) return true; // still loading
        return roles.IsTenantAdmin;
    }

    private bool IsNavGroupVisible(NavGroup group)
        => group.Items.Any(IsNavItemVisible) || group.SubGroups.Any(IsNavGroupVisible);

    // === RENDER METHODS ===

    private RenderFragment RenderNavGroup(NavGroup group, int depth) => __builder =>
    {
        var isSingleItem = group.Items.Count == 1 && group.SubGroups.Count == 0 && string.IsNullOrEmpty(group.ParentPath);
        var key = group.FullPath;
        var isExpanded = expandedState.ContainsKey(key) && expandedState[key];
        var hasChildren = group.Items.Count > 0 || group.SubGroups.Count > 0;

        if (isSingleItem)
        {
            // Simple nav link (e.g., Dashboard)
            var item = group.Items[0];
            var isActive = IsCurrentPage(item.Href);

            <li class="sidebar-item @(isActive ? "sidebar-item-active" : "")" role="none">
                <a href="@item.Href" class="sidebar-link" role="menuitem" aria-current="@(isActive ? "page" : null)">
                    <span class="sidebar-icon">
                        @if (item.Icon != null)
                        {
                            <FluentIcon Value="@item.Icon" Color="@(isActive? Color.Fill: Color.Accent)" />
                        }
                    </span>
                    <span class="sidebar-label">@item.Title</span>
                    @* Tooltip for collapsed mode *@
                    <span class="sidebar-tooltip" role="tooltip">@item.Title</span>
                </a>
            </li>
        }
        else
        {
            // Group with items/subgroups
            <li class="sidebar-group @(isExpanded && sidebarExpanded ? "sidebar-group-expanded" : "")"                role="none"
                @onmouseenter="() => OnGroupMouseEnter(group)"                @onfocusin="() => OnGroupMouseEnter(group)">

                @if (sidebarExpanded)
                {
                    @* === EXPANDED MODE: Inline accordion === *@
                    <button class="sidebar-group-toggle"                            @onclick="() => HandleGroupExpandChanged(!isExpanded, group)"
                            aria-expanded="@isExpanded"                            aria-controls="@($"nav-group-{key.Replace(" ", "-").Replace(">", "")}")"
                            role="menuitem">
                        <span class="sidebar-icon">
                            @if (group.Icon != null)
                            {
                                <FluentIcon Value="@group.Icon" Color="Color.Accent" />
                            }
                        </span>
                        <span class="sidebar-label">@group.Title</span>
                        <span class="sidebar-chevron @(isExpanded ? "sidebar-chevron-open" : "")">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ChevronDown())" />
                        </span>
                    </button>

                    <ul class="sidebar-submenu @(isExpanded ? "sidebar-submenu-open" : "")"
                        id="@($"nav-group-{key.Replace(" ", "-").Replace(">", "")}")"                        role="menu"                        aria-hidden="@(!isExpanded)">
                        @foreach (var item in group.Items.Where(IsNavItemVisible))
                        {
                            var isActive = IsCurrentPage(item.Href);
                            <li class="sidebar-item sidebar-item-nested @(isActive ? "sidebar-item-active" : "")" role="none">
                                <a href="@item.Href"                                   class="sidebar-link sidebar-link-nested"                                   role="menuitem"
                                       aria-current="@(isActive ? "page" : null)">
                                    <span class="sidebar-icon sidebar-icon-small">
                                        @if (item.Icon != null)
                                        {
                                            <FluentIcon Value="@item.Icon" Color="@(isActive? Color.Fill: Color.Accent)" />
                                        }
                                    </span>
                                    <span class="sidebar-label">@item.Title</span>
                                </a>
                            </li>
                        }
                        @foreach (var subGroup in group.SubGroups)
                        {
                            @RenderNavGroup(subGroup, depth + 1)
                        }
                    </ul>
                }
                else
                {
                    @* === COLLAPSED MODE: Icon + Flyout === *@
                    <div class="sidebar-collapsed-trigger" tabindex="0" role="menuitem" aria-haspopup="true">
                        <span class="sidebar-icon">
                            @if (group.Icon != null)
                            {
                                <FluentIcon Value="@group.Icon" Color="Color.Accent" />
                            }
                        </span>

                        @* Flyout panel *@
                        <div class="sidebar-flyout @(flyoutForceClosed ? "sidebar-flyout-hidden" : "")" role="menu"
                             aria-label="@group.Title submenu">
                            <div class="sidebar-flyout-header">@group.Title</div>
                            <ul class="sidebar-flyout-list">
                                @foreach (var item in group.Items.Where(IsNavItemVisible))
                                {
                                    var isActive = IsCurrentPage(item.Href);
                                    <li class="sidebar-flyout-item @(isActive ? "sidebar-flyout-item-active" : "")" role="none">
                                        <a href="@item.Href" class="sidebar-flyout-link" role="menuitem"
                                               aria-current="@(isActive ? "page" : null)" @onclick="() => NavigateAndClose(item.Href)"
                                               @onclick:preventDefault="false">
                                            <span class="sidebar-flyout-icon">
                                                @if (item.Icon != null)
                                                {
                                                    <FluentIcon Value="@item.Icon" Color="@(isActive? Color.Fill: Color.Accent)" />
                                                }
                                            </span>
                                            <span>@item.Title</span>
                                        </a>
                                    </li>
                                }
                                @foreach (var subGroup in group.SubGroups)
                                {
                                    @RenderFlyoutSubgroup(subGroup)
                                }
                            </ul>
                        </div>
                    </div>
                }
            </li>
        }
    };

    private RenderFragment RenderFlyoutSubgroup(NavGroup subGroup) => __builder =>
    {
        var subKey = subGroup.FullPath;
        var isSubExpanded = flyoutSubgroupExpanded.ContainsKey(subKey) && flyoutSubgroupExpanded[subKey];

        <li class="sidebar-flyout-subgroup" role="none">
            <button class="sidebar-flyout-subgroup-toggle" @onclick="() => ToggleFlyoutSubgroup(subKey)"
                    @onclick:stopPropagation="true" aria-expanded="@isSubExpanded" role="menuitem">
                <span class="sidebar-flyout-icon">
                    @if (subGroup.Icon != null)
                    {
                        <FluentIcon Value="@subGroup.Icon" Color="Color.Accent" />
                    }
                </span>
                <span>@subGroup.Title</span>
                <span class="sidebar-flyout-chevron @(isSubExpanded ? "sidebar-flyout-chevron-open" : "")">
                    <FluentIcon Value="@(new Icons.Regular.Size12.ChevronDown())" />
                </span>
            </button>

            <ul class="sidebar-flyout-nested @(isSubExpanded ? "sidebar-flyout-nested-open" : "")" role="menu">
                @foreach (var item in subGroup.Items.Where(IsNavItemVisible))
                {
                    var isActive = IsCurrentPage(item.Href);
                    <li class="sidebar-flyout-item @(isActive ? "sidebar-flyout-item-active" : "")" role="none">
                        <a href="@item.Href" class="sidebar-flyout-link sidebar-flyout-link-nested" role="menuitem"
                               aria-current="@(isActive ? "page" : null)" @onclick="() => NavigateAndClose(item.Href)"
                               @onclick:preventDefault="false">
                            <span class="sidebar-flyout-icon">
                                @if (item.Icon != null)
                                {
                                    <FluentIcon Value="@item.Icon" Color="@(isActive? Color.Fill: Color.Accent)" />
                                }
                            </span>
                            <span>@item.Title</span>
                        </a>
                    </li>
                }
                @foreach (var nestedSubGroup in subGroup.SubGroups)
                {
                    @RenderFlyoutSubgroup(nestedSubGroup)
                }
            </ul>
        </li>
    };
}