@page "/project/{ProjectId}/brief"
@attribute [Authorize]
@inject ILogger<ProjectBrief> Logger

@*
    The daily brief (assetlen.md §5, plan.md P7).

    **Grouped by the work, never by posting order.** On 25 February the
    contractor posted seventeen photographs inside one minute; two hours later
    the developer replied "Nothing much changed." Chronology is what makes a chat
    unreadable, so this page has no timeline — it has deliverables, and inside
    each one a same-view pair where the frames allow it.

    **It assembles itself.** Everything here comes from what was forwarded and
    captured, filed by the server. Nothing waits for anybody to curate it (Law 0),
    and the truth floor is injected above it for every reader.
*@

<PageTitle>Daily brief — ASSETLEN</PageTitle>

<ProjectPage ProjectId="@ProjectId" Section="brief" Eyebrow="Daily brief"
             Subtitle="Grouped by the work you are paying for — not by the order things were posted." Context="ctx">

    <div class="brief__bar">
        <button type="button" class="al-iconbtn al-iconbtn--bordered" @onclick="() => ShiftDay(-1)"
                aria-label="Previous day">
            <Icon Name="chevron-left" Size="18" />
        </button>

        <div class="brief__day">
            <span class="al-label">@RelativeDayLabel</span>
            <span class="brief__day-date">@DayRangeLabel</span>
        </div>

        <button type="button" class="al-iconbtn al-iconbtn--bordered" @onclick="() => ShiftDay(1)"
                disabled="@(day.Date >= DateTime.Now.Date)" aria-label="Next day">
            <Icon Name="chevron-right" Size="18" />
        </button>

        <span class="al-spacer"></span>

        <div class="al-segmented" role="group" aria-label="Window">
            @foreach (var option in Windows)
            {
                <button type="button" class="al-segmented__item @(windowDays == option.Days ? "is-active" : "")"
                        aria-selected="@(windowDays == option.Days)"
                        @onclick="() => SetWindow(option.Days)">
                    @option.Label
                </button>
            }
        </div>
    </div>

    <StateBlock Phase="phase" OnRetry="LoadAsync"
                ErrorTitle="The brief didn't load"
                ErrorMessage="@errorMessage">
        <Loading>
            <div class="brief__ghosts">
                <div class="al-shimmer al-ghost-row"></div>
                <div class="al-shimmer al-ghost-row"></div>
                <div class="al-shimmer al-ghost-line al-ghost-line--title"></div>
                <div class="al-shimmer al-ghost-thumb brief__ghost-thumb"></div>
            </div>
        </Loading>
        <ChildContent>
            @if (brief is not null)
            {
                @* The trust condition, stated once, plainly, to whichever side is reading. *@
                <div class="al-alert al-alert--info brief__rule">
                    <Icon Name="shield" Size="18" />
                    <div>
                        <strong class="al-alert__title">What always reaches the client</strong>
                        <span>@brief.Rule</span>
                    </div>
                </div>

                <p class="brief__provenance">
                    @if (brief.AssembledWithoutCurator)
                    {
                        <span>Assembled from what was forwarded and captured — nobody curated it.</span>
                    }
                    else
                    {
                        <span>Assembled from what was forwarded and captured, including frames the delivery side shared.</span>
                    }
                    <span>@(brief.IsPublished ? "Published" : "Publishes") at @brief.PublishesAt.ToString("HH:mm", CultureInfo.InvariantCulture)@(brief.IsPublished ? "" : ", touched or not").</span>
                    <span>@BriefFormat.EmphasisLabel(brief.Emphasis).</span>
                </p>

                <TruthFloor Sections="brief.TruthFloor" />

                <div class="al-rule brief__work-rule">
                    <span class="al-label">The work</span>
                    <span class="brief__counts al-num">@CountsLine</span>
                </div>

                @if (brief.Blocks.Count == 0)
                {
                    <div class="al-empty">
                        <Icon Name="brief" Size="40" Class="al-empty__icon" Weight="1.25" />
                        <h3 class="al-empty__title">@EmptyTitle</h3>
                        <p class="al-empty__body">
                            Nothing in the thread or on site named a piece of work in this window.
                            Widen it, or step back a day. The truth floor above still stands.
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var block in brief.Blocks)
                    {
                        <BriefBlockView Block="block" ProjectId="@ProjectId" Days="brief.Days" />
                    }
                }
            }
        </ChildContent>
    </StateBlock>
</ProjectPage>

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [SupplyParameterFromQuery(Name = "day")] public string? DayParam { get; set; }

    private DateTime day = DateTime.Now.Date;
    private int windowDays = 1;
    private DailyBriefDto? brief;
    private LoadPhase phase = LoadPhase.Loading;
    private string? errorMessage;
    private string? loadedKey;

    private static readonly (int Days, string Label)[] Windows =
    [
        (1, "Day"), (7, "Week"), (21, "3 weeks")
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (DateTime.TryParseExact(DayParam, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
            && d.Date <= DateTime.Now.Date)
            day = d.Date;

        var key = $"{ProjectId}|{DayParam}";
        if (loadedKey == key) return;
        loadedKey = key;
        await LoadAsync();
    }

    private async Task ShiftDay(int delta)
    {
        var next = day.AddDays(delta);
        if (next.Date > DateTime.Now.Date) return;
        day = next;
        await LoadAsync();
    }

    private async Task SetWindow(int days)
    {
        windowDays = days;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        phase = LoadPhase.Loading;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var response = await _briefApi.Day(ProjectId, day, windowDays);
            if (!response.IsSuccessStatusCode || response.Content is null)
            {
                phase = LoadPhase.Error;
                errorMessage = _apiResponseHandler.GetApiErrorMessage(response);
                return;
            }

            brief = response.Content;
            phase = LoadPhase.Ready;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Brief failed to load for {ProjectId}", ProjectId);
            phase = LoadPhase.Error;
            errorMessage = ex.Message;
        }
        finally { StateHasChanged(); }
    }

    private string CountsLine
    {
        get
        {
            if (brief is null) return "";
            var c = brief.Counts;
            var parts = new List<string>();
            if (c.MessagesRead > 0) parts.Add(Plural(c.MessagesRead, "message") + " read");
            if (c.AcknowledgementsSetAside > 0) parts.Add(Plural(c.AcknowledgementsSetAside, "acknowledgement") + " set aside");
            if (c.Captures > 0) parts.Add(Plural(c.Captures, "capture"));
            if (c.Frames > 0) parts.Add(Plural(c.Frames, "frame"));
            if (c.Paired > 0) parts.Add($"{c.Paired} same-view {(c.Paired == 1 ? "pair" : "pairs")}");
            if (c.Unfiled > 0) parts.Add($"{c.Unfiled} not tied to a deliverable");
            return string.Join(" · ", parts);
        }
    }

    private static string Plural(int n, string noun) => n == 1 ? $"1 {noun}" : $"{n} {noun}s";

    private string RelativeDayLabel
    {
        get
        {
            var label = day.Date == DateTime.Now.Date ? "Today"
                      : day.Date == DateTime.Now.Date.AddDays(-1) ? "Yesterday"
                      : day.ToString("dddd", CultureInfo.InvariantCulture);

            return windowDays == 1 ? label : $"{windowDays} days to {label.ToLowerInvariant()}";
        }
    }

    private string DayRangeLabel => windowDays == 1
        ? day.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
        : $"{day.AddDays(-(windowDays - 1)).ToString("d MMM", CultureInfo.InvariantCulture)} – {day.ToString("d MMM yyyy", CultureInfo.InvariantCulture)}";

    private string EmptyTitle => windowDays == 1
        ? "No work was named on this day"
        : "No work was named in this window";
}
