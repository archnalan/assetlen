@*
    One commitment: what was agreed, who agreed it with whom, when, where it
    was said, and where it has got to. Every action offered is one the server
    stamped for this reader — a spoken agreement is confirmed by the other side,
    never by the person who wrote it down (assetlen.md §3).
*@

@inject ILogger<CommitmentCard> Logger

<article class="commitment @(Item.IsSuperseded ? "commitment--superseded" : "") @(NeedsReader ? "commitment--needs-you" : "") @(Focused ? "commitment--focused" : "")" id="c-@Item.Id">

    <header class="commitment__head">
        <span class="commitment__kind" title="@KindLabel(Item.Kind)">
            <Icon Name="@KindIcon(Item.Kind)" Size="14" />
            <span>@KindLabel(Item.Kind)</span>
        </span>

        <div class="commitment__badges">
            @if (Item.QueryState == CommitmentQueryState.QueryRaised)
            {
                <span class="al-badge al-badge--accent"><Icon Name="query" Size="11" /> Query raised</span>
            }
            else if (Item.QueryState == CommitmentQueryState.Resolved)
            {
                <span class="al-badge al-badge--success">Resolved</span>
            }
            else if (Item.QueryState == CommitmentQueryState.Cleared)
            {
                <span class="al-badge al-badge--success"><Icon Name="check" Size="11" /> Cleared</span>
            }

            @if (Item.CanConfirm)
            {
                <span class="al-badge al-badge--warning">Needs your word</span>
            }
            else if (Item.IsAwaitingCounterparty)
            {
                <span class="al-badge al-badge--neutral">Awaiting the other side</span>
            }

            @if (Item.IsOverdue)
            {
                <span class="al-badge al-badge--danger"><Icon Name="clock" Size="11" /> Overdue</span>
            }
            @if (Item.VariationStatus is not null)
            {
                <span class="al-badge al-badge--outline" title="On the variation register">
                    <Icon Name="variation" Size="11" /> Variation · @Fmt.Humanise(Item.VariationStatus.ToString())
                </span>
            }
            @if (Item.IsSuperseded)
            {
                <span class="al-badge al-badge--neutral">Superseded</span>
            }
            @if (Item.IsSurfaced && Item.DecideBy is not null)
            {
                <span class="al-badge al-badge--warning" title="@Item.DecideByReason">
                    <Icon Name="clock" Size="11" /> Decide by @Fmt.DateShort(Item.DecideBy)
                </span>
            }
            else if (Item.IsParkedIdea)
            {
                <span class="al-badge al-badge--outline" title="Held quietly until waiting costs something">
                    <Icon Name="idea" Size="11" /> Parked
                </span>
            }
        </div>
    </header>

    <h3 class="commitment__title">@Item.Title</h3>

    @if (!string.IsNullOrWhiteSpace(Item.Body))
    {
        <p class="commitment__body">@Item.Body</p>
    }

    <dl class="commitment__facts">
        @if (Item.Amount is not null)
        {
            <div class="commitment__fact">
                <dt class="al-label">Amount</dt>
                <dd class="al-num">@Fmt.Money(Item.Amount.Value, Item.Currency)</dd>
            </div>
        }
        else if (Item.AmountHidden)
        {
            <div class="commitment__fact">
                <dt class="al-label">Amount</dt>
                <dd class="al-subtle">Priced — not on your seat</dd>
            </div>
        }
        @if (Item.DueDate is not null)
        {
            <div class="commitment__fact">
                <dt class="al-label">@(Item.Kind == CommitmentKind.Date ? "Promised for" : "Due")</dt>
                <dd class="al-num">@Fmt.Date(Item.DueDate)</dd>
            </div>
        }
        <div class="commitment__fact">
            <dt class="al-label">@(Item.Maturity >= CommitmentMaturity.Agreed ? "Agreed" : "Raised")</dt>
            <dd class="al-num">@Fmt.Date(Item.AgreedAt ?? Item.DateTimeCreated)</dd>
        </div>
        <div class="commitment__fact">
            <dt class="al-label">Between</dt>
            <dd>@(Item.AgreedByName ?? "—")@if (!string.IsNullOrEmpty(Item.AgreedWithName)) {<text> and @Item.AgreedWithName</text>}</dd>
        </div>
        <div class="commitment__fact">
            <dt class="al-label">Where</dt>
            <dd>@SourceLabel(Item.SourceChannel)</dd>
        </div>
        @if (Item.OwedBySide is not null && Item.Maturity < CommitmentMaturity.Agreed)
        {
            <div class="commitment__fact">
                <dt class="al-label">Decision owed by</dt>
                <dd>@(Item.OwedBySide == ProjectSide.Client ? "the client side" : "the delivery side")</dd>
            </div>
        }
    </dl>

    @* Idea → In discussion → Agreed → Delivered → Verified *@
    <div class="al-provenance commitment__prov" aria-label="Maturity">
        @foreach (var step in Steps)
        {
            <span class="al-provenance__step @StepClass(step)">@StepLabel(step)</span>
        }
    </div>

    @if (Item.Maturity < CommitmentMaturity.Agreed && !Item.IsSuperseded
         && (Item.IsParkedIdea || Item.EstimateCount > 0 || Item.DependsOnStageName is not null || Item.IsSurfaced))
    {
        @* A parked idea holds its references and estimates quietly and speaks
           only when waiting costs something (assetlen.md Law 4). *@
        <div class="commitment__parked @(Item.IsSurfaced ? "commitment__parked--due" : "")">
            <Icon Name="@(Item.IsSurfaced ? "clock" : "idea")" Size="14" />
            <span>
                @if (Item.IsSurfaced && !string.IsNullOrEmpty(Item.DecideByReason))
                {
                    <strong>@Item.DecideByReason.</strong>
                }
                else if (Item.StageName is not null)
                {
                    <text>Parked for <strong>@Item.StageName</strong>. </text>
                }
                @if (Item.DependsOnStageName is not null && !Item.IsSurfaced)
                {
                    <text>Must be settled before @Item.DependsOnStageName starts. </text>
                }
                @if (Item.EstimateCount > 0)
                {
                    <text>@Item.EstimateCount @(Item.EstimateCount == 1 ? "estimate" : "estimates")</text>
                    @if (Item.EstimateLow is { } lo && Item.EstimateHigh is { } hi)
                    {
                        <text>: <span class="al-num">@(lo == hi ? Fmt.Money(lo, Item.EstimateCurrency) : $"{Fmt.MoneyShort(lo, Item.EstimateCurrency)} – {Fmt.MoneyShort(hi, Item.EstimateCurrency)}")</span></text>
                    }
                    <text>.</text>
                }
            </span>
        </div>
    }

    @if (Item.PreviousAmount is { } was && Item.Amount is { } now && was != now)
    {
        <p class="commitment__note commitment__note--revised">
            <Icon Name="history" Size="14" />
            <span>
                Revised from <span class="al-num">@Fmt.Money(was, Item.Currency)</span>
                (<span class="al-num">@(now > was ? "+" : "−")@Fmt.Money(Math.Abs(now - was), Item.Currency)</span>)@if (Item.PreviousClearedAt is not null) {<text>; the earlier figure was cleared on @Fmt.Date(Item.PreviousClearedAt)</text>}.
            </span>
        </p>
    }

    @if (Item.MarkupArtifactId is not null && Item.ProjectId is not null)
    {
        <MarkupPreview ProjectId="@Item.ProjectId" ArtifactId="@Item.MarkupArtifactId" LayerId="@Item.MarkupLayerId"
                       CommitmentId="@Item.Id" Note="@Item.MarkupNote" />
    }

    @if (Item.DisputedAt is not null)
    {
        <p class="commitment__note commitment__note--dispute">
            <Icon Name="alert" Size="14" />
            <span>
                <strong>@(Item.DisputedByName ?? "The other side") said that is not what was agreed</strong>
                on @Fmt.Date(Item.DisputedAt)@if (!string.IsNullOrWhiteSpace(Item.DisputeNote)) {<text>: “@Item.DisputeNote”</text>}
            </span>
        </p>
    }
    @if (!string.IsNullOrWhiteSpace(Item.ResolutionNote))
    {
        <p class="commitment__note commitment__note--resolved">
            <Icon Name="check-circle" Size="14" />
            <span><strong>Resolved @Fmt.Date(Item.ResolvedAt):</strong> @Item.ResolutionNote</span>
        </p>
    }
    @if (Item.CounterpartyConfirmedAt is not null)
    {
        <p class="commitment__note">
            <Icon Name="check" Size="14" />
            <span>Confirmed by @(Item.CounterpartyConfirmedByName ?? "the other side") on @Fmt.Date(Item.CounterpartyConfirmedAt)</span>
        </p>
    }

    <footer class="commitment__foot">
        <span class="commitment__face" title="The single accountable name on everything that crosses">
            <Icon Name="shield" Size="13" /> @(Item.AccountableName ?? "No mediator appointed")
        </span>

        @if (Item.RestatementCount > 0 || Item.IsSuperseded)
        {
            <button type="button" class="al-btn al-btn--link al-btn--sm" @onclick="ToggleHistoryAsync">
                <Icon Name="history" Size="13" />
                @(Item.RestatementCount > 0 ? $"Restated {Times(Item.RestatementCount)}" : "History")
            </button>
        }
        @if (Item.LinkCount > 0)
        {
            <button type="button" class="al-btn al-btn--link al-btn--sm" @onclick="ToggleLinksAsync">
                <Icon Name="link" Size="13" /> @Item.LinkCount @(Item.LinkCount == 1 ? "link" : "links")
            </button>
        }
        @if (Item.OpenQueryFlagId is not null)
        {
            <a class="al-btn al-btn--link al-btn--sm" href="/project/@Item.ProjectId/register?view=questions#@Item.OpenQueryFlagId">
                <Icon Name="query" Size="13" /> The question
            </a>
        }

        <span class="al-spacer"></span>

        @if (!ReadOnly)
        {
            <div class="commitment__actions">
                @if (Item.CanConfirm)
                {
                    <button type="button" class="al-btn al-btn--primary al-btn--sm" disabled="@busy" @onclick="ConfirmAsync">
                        <Icon Name="check" Size="14" /> Confirm
                    </button>
                }
                @if (Item.CanDispute)
                {
                    <button type="button" class="al-btn al-btn--default al-btn--sm" disabled="@busy" @onclick="() => Open(Pane.Dispute)">
                        That’s not what we said
                    </button>
                }
                @if (Item.CanResolveQuery)
                {
                    <button type="button" class="al-btn al-btn--primary al-btn--sm" disabled="@busy" @onclick="() => Open(Pane.Resolve)">
                        Resolve
                    </button>
                }
                @if (Item.CanClear)
                {
                    <button type="button" class="al-btn al-btn--default al-btn--sm" disabled="@busy" @onclick="ClearAsync">
                        Mark cleared
                    </button>
                }
                @if (Item.CanAdvance || Item.CanVerify || Item.CanRaiseQuery || Item.CanRestate || Item.CanAddEstimate || Item.CanPark)
                {
                    <button type="button" class="al-iconbtn al-iconbtn--sm" aria-label="More actions" aria-expanded="@menuOpen"
                            @onclick="() => menuOpen = !menuOpen">
                        <Icon Name="more" Size="16" />
                    </button>
                }
            </div>
        }
    </footer>

    @if (menuOpen && !ReadOnly)
    {
        <div class="commitment__menu" role="menu">
            @if (Item.CanAdvance && NextStep is { } next)
            {
                <button type="button" role="menuitem" class="al-btn al-btn--quiet al-btn--sm" @onclick="() => AdvanceAsync(next)">
                    Move to @StepLabel(next)
                </button>
            }
            @if (Item.CanVerify)
            {
                <button type="button" role="menuitem" class="al-btn al-btn--quiet al-btn--sm" @onclick="() => AdvanceAsync(CommitmentMaturity.Verified)">
                    Verified against the work
                </button>
            }
            @if (Item.CanRaiseQuery)
            {
                <button type="button" role="menuitem" class="al-btn al-btn--quiet al-btn--sm" @onclick="() => Open(Pane.Query)">
                    Raise a query
                </button>
            }
            @if (Item.CanRestate)
            {
                <button type="button" role="menuitem" class="al-btn al-btn--quiet al-btn--sm" @onclick="() => Open(Pane.Restate)">
                    Restate — a new date, figure or wording
                </button>
            }
            @if (Item.CanAddEstimate)
            {
                <button type="button" role="menuitem" class="al-btn al-btn--quiet al-btn--sm" @onclick="() => Open(Pane.Estimate)">
                    Add an estimate
                </button>
            }
            @if (Item.CanPark)
            {
                <button type="button" role="menuitem" class="al-btn al-btn--quiet al-btn--sm" @onclick="OpenParkAsync">
                    Park — which stage, what it holds up, lead time
                </button>
            }
        </div>
    }

    @if (pane != Pane.None)
    {
        <div class="commitment__pane">
            @switch (pane)
            {
                case Pane.Dispute:
                    <label class="al-label" for="dis-@Item.Id">What was actually said</label>
                    <textarea id="dis-@Item.Id" class="al-textarea" rows="2" maxlength="1000"
                              placeholder="e.g. We said 10M on the call, not 10.5M."
                              @bind="note" @bind:event="oninput"></textarea>
                    <span class="al-field__hint">It becomes a query on this item, owed back to whoever wrote it down.</span>
                    break;

                case Pane.Query:
                    <label class="al-label" for="q-@Item.Id">Your question</label>
                    <textarea id="q-@Item.Id" class="al-textarea" rows="2" maxlength="1000"
                              @bind="note" @bind:event="oninput"></textarea>
                    <span class="al-field__hint">Asking is not an accusation. The answer will land on this item, not in a message.</span>
                    break;

                case Pane.Resolve:
                    <label class="al-label" for="r-@Item.Id">How it was resolved</label>
                    <textarea id="r-@Item.Id" class="al-textarea" rows="2" maxlength="1000"
                              placeholder="e.g. Revised to 4 bags, agreed on site 6 Aug."
                              @bind="note" @bind:event="oninput"></textarea>
                    <div class="commitment__pane-row">
                        @if (Item.Amount is not null || Item.Kind == CommitmentKind.Price)
                        {
                            @if (!Item.AmountHidden)
                            {
                                <div class="al-field">
                                    <label class="al-label" for="ra-@Item.Id">Revised figure (optional)</label>
                                    <input id="ra-@Item.Id" class="al-input al-input--money" type="number" min="0" step="1000" @bind="amount" />
                                </div>
                            }
                        }
                        @if (Item.Kind == CommitmentKind.Date)
                        {
                            <div class="al-field">
                                <label class="al-label" for="rd-@Item.Id">Revised date (optional)</label>
                                <input id="rd-@Item.Id" class="al-input" type="date" @bind="due" />
                            </div>
                        }
                    </div>
                    <span class="al-field__hint">A changed figure becomes a new statement; the questioned one stays on record beside it.</span>
                    break;

                case Pane.Restate:
                    <label class="al-label" for="rt-@Item.Id">Wording</label>
                    <input id="rt-@Item.Id" class="al-input" maxlength="200" @bind="title" @bind:event="oninput" />
                    <div class="commitment__pane-row">
                        @if (!Item.AmountHidden && (Item.Amount is not null || Item.Kind == CommitmentKind.Price))
                        {
                            <div class="al-field">
                                <label class="al-label" for="rsa-@Item.Id">Figure</label>
                                <input id="rsa-@Item.Id" class="al-input al-input--money" type="number" min="0" step="1000" @bind="amount" />
                            </div>
                        }
                        <div class="al-field">
                            <label class="al-label" for="rsd-@Item.Id">@(Item.Kind == CommitmentKind.Date ? "New date" : "Due")</label>
                            <input id="rsd-@Item.Id" class="al-input" type="date" @bind="due" />
                        </div>
                    </div>
                    <span class="al-field__hint">The current statement is kept and marked superseded. Nothing is overwritten.</span>
                    break;

                case Pane.Estimate:
                    <div class="commitment__pane-row">
                        @if (Item.CanPriceEstimate)
                        {
                            <div class="al-field">
                                <label class="al-label" for="es-@Item.Id">Figure (optional)</label>
                                <input id="es-@Item.Id" class="al-input al-input--money" type="number" min="0" step="1000" @bind="amount" />
                            </div>
                        }
                    </div>
                    <label class="al-label" for="esn-@Item.Id">Where it came from</label>
                    <input id="esn-@Item.Id" class="al-input" maxlength="500" placeholder="e.g. Fabricator's quote, seen at a neighbour's"
                           @bind="note" @bind:event="oninput" />
                    <span class="al-field__hint">Kept with the idea quietly. Nobody is asked anything until it has a deadline.</span>
                    break;

                case Pane.Park:
                    @if (stages is null)
                    {
                        <div class="al-shimmer al-ghost-row"></div>
                    }
                    else
                    {
                        <div class="commitment__pane-row">
                            <div class="al-field">
                                <label class="al-label" for="pk-@Item.Id">Parked for</label>
                                <select id="pk-@Item.Id" class="al-select" @bind="parkStageId">
                                    @foreach (var s in stages)
                                    {
                                        <option value="@s.Id">@s.StageName@(s.StartDate is null ? "" : $" · starts {Fmt.DateShort(s.StartDate)}")</option>
                                    }
                                </select>
                            </div>
                            <div class="al-field">
                                <label class="al-label" for="pd-@Item.Id">Must be decided before</label>
                                <select id="pd-@Item.Id" class="al-select" @bind="parkDependsOnId">
                                    <option value="">Nothing in particular</option>
                                    @foreach (var s in stages.Where(s => s.Id != parkStageId))
                                    {
                                        <option value="@s.Id">@s.StageName starts@(s.StartDate is null ? "" : $" ({Fmt.DateShort(s.StartDate)})")</option>
                                    }
                                </select>
                            </div>
                            <div class="al-field">
                                <label class="al-label" for="pl-@Item.Id">Lead time, days</label>
                                <input id="pl-@Item.Id" class="al-input" type="number" min="0" max="730" @bind="parkLead" />
                            </div>
                        </div>
                        <span class="al-field__hint">The decide-by date is worked back from the stage start. It stays silent until waiting costs something.</span>
                    }
                    break;
            }

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="al-alert al-alert--error" role="alert"><Icon Name="error" Size="16" /><span>@error</span></div>
            }

            <div class="commitment__pane-actions">
                <button type="button" class="al-btn al-btn--quiet al-btn--sm" disabled="@busy" @onclick="Close">Cancel</button>
                <button type="button" class="al-btn al-btn--primary al-btn--sm" disabled="@(busy || !PaneReady)" @onclick="SubmitPaneAsync">
                    @if (busy) { <span class="al-spinner"></span> }
                    @PaneAction
                </button>
            </div>
        </div>
    }

    @if (historyOpen)
    {
        <div class="commitment__drawer">
            <span class="al-label">Every statement, oldest first</span>
            @if (history is null)
            {
                <div class="al-shimmer al-ghost-row"></div>
            }
            else
            {
                <ol class="commitment__history">
                    @foreach (var h in history)
                    {
                        <li class="@(h.Id == Item.Id ? "is-this" : "")">
                            <span class="al-num commitment__history-date">@Fmt.DateShort(h.AgreedAt ?? h.DateTimeCreated)</span>
                            <span>
                                @h.Title
                                @if (h.Amount is not null) {<text> · <span class="al-num">@Fmt.Money(h.Amount.Value, h.Currency)</span></text>}
                                @if (h.DueDate is not null) {<text> · for <span class="al-num">@Fmt.Date(h.DueDate)</span></text>}
                            </span>
                        </li>
                    }
                </ol>
            }
        </div>
    }

    @if (linksOpen)
    {
        <div class="commitment__drawer">
            <span class="al-label">Evidence and backlinks</span>
            @if (links is null)
            {
                <div class="al-shimmer al-ghost-row"></div>
            }
            else if (links.Count == 0)
            {
                <span class="al-subtle">Nothing you can see is linked.</span>
            }
            else
            {
                <ul class="commitment__links">
                    @foreach (var l in links)
                    {
                        <li>
                            <Icon Name="@LinkIcon(l.TargetType)" Size="13" />
                            <span class="commitment__link-rel">@Fmt.Humanise(l.Relation.ToString())</span>
                            @if (l.TargetType == CommitmentLinkTarget.Commitment)
                            {
                                <a href="/project/@Item.ProjectId/register#c-@l.TargetId">@l.TargetLabel</a>
                            }
                            else if (l.ArtifactId is not null)
                            {
                                @* Open the file to circle what is wrong with it and ask — Peter's fourth search. *@
                                <a href="/project/@Item.ProjectId/artifact/@l.ArtifactId?commitment=@Item.Id">@l.TargetLabel</a>
                                @if (Item.CanRaiseQuery && l.TargetType == CommitmentLinkTarget.Artifact)
                                {
                                    <a class="commitment__markup-link" href="/project/@Item.ProjectId/artifact/@l.ArtifactId?commitment=@Item.Id">
                                        <Icon Name="markup" Size="12" /> Mark up &amp; ask
                                    </a>
                                }
                            }
                            else
                            {
                                <span>@l.TargetLabel</span>
                            }
                            @if (l.TargetDate is not null)
                            {
                                <span class="al-subtle al-num">@Fmt.DateShort(l.TargetDate)</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public CommitmentDto Item { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>The item a search result pointed at — marked so the reader sees which one they came for.</summary>
    [Parameter] public bool Focused { get; set; }

    /// <summary>Raised with the fresh item after any change — a restatement or resolution may hand back a new id.</summary>
    [Parameter] public EventCallback<CommitmentDto> OnChanged { get; set; }

    private enum Pane { None, Dispute, Query, Resolve, Restate, Estimate, Park }

    private List<StageDto>? stages;
    private string? parkStageId;
    private string? parkDependsOnId;
    private int? parkLead;

    private Pane pane;
    private bool menuOpen;
    private bool busy;
    private string? error;
    private string note = "";
    private string title = "";
    private decimal? amount;
    private DateTime? due;

    private bool historyOpen;
    private List<CommitmentDto>? history;
    private bool linksOpen;
    private List<CommitmentLinkDto>? links;

    private static readonly CommitmentMaturity[] Steps = Enum.GetValues<CommitmentMaturity>();

    private bool NeedsReader => Item.CanConfirm;

    private CommitmentMaturity? NextStep => Item.Maturity switch
    {
        CommitmentMaturity.Idea => CommitmentMaturity.InDiscussion,
        CommitmentMaturity.InDiscussion => CommitmentMaturity.Agreed,
        CommitmentMaturity.Agreed => CommitmentMaturity.Delivered,
        _ => null
    };

    private string StepClass(CommitmentMaturity step)
        => Item.Maturity > step ? "is-done" : Item.Maturity == step ? "is-current" : "";

    private static string StepLabel(CommitmentMaturity m) => m switch
    {
        CommitmentMaturity.InDiscussion => "In discussion",
        _ => m.ToString()
    };

    private void Open(Pane p)
    {
        pane = p;
        menuOpen = false;
        error = null;
        note = "";
        title = Item.Title ?? "";
        amount = Item.Amount;
        due = Item.DueDate?.ToLocalTime().Date;
    }

    private void Close() { pane = Pane.None; error = null; }

    private async Task OpenParkAsync()
    {
        Open(Pane.Park);
        amount = null;
        parkStageId = Item.StageId;
        parkDependsOnId = Item.DependsOnStageId ?? "";
        parkLead = Item.LeadTimeDays;
        if (stages is not null || Item.ProjectId is null) return;
        try
        {
            var response = await _stagesApi.GetStagesByProjectId(Item.ProjectId);
            stages = response.IsSuccessStatusCode ? (response.Content ?? new()).OrderBy(s => s.DisplayOrder).ToList() : new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Stages failed to load for {ProjectId}", Item.ProjectId);
            stages = new();
        }
    }

    /// <summary>An estimate is not a change to the item, so it has its own call — then the card reads itself again.</summary>
    private async Task EstimateAsync()
    {
        busy = true;
        error = null;
        StateHasChanged();
        try
        {
            var response = await _commitmentsApi.AddEstimate(new CommitmentEstimateCreateDto
            {
                CommitmentId = Item.Id,
                Amount = amount is > 0 ? amount : null,
                Note = Clean(note)
            });
            if (!response.IsSuccessStatusCode)
            {
                error = _apiResponseHandler.GetApiErrorMessage(response) ?? "That did not go through.";
                return;
            }
            pane = Pane.None;
            ToastService.ShowSuccess("Kept with the idea. Nobody has been asked anything.");
            var fresh = await _commitmentsApi.GetCommitment(Item.Id!);
            if (fresh.IsSuccessStatusCode && fresh.Content is not null && OnChanged.HasDelegate)
                await OnChanged.InvokeAsync(fresh.Content);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Estimate failed on {Id}", Item.Id);
            error = "That did not go through.";
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private bool PaneReady => pane switch
    {
        Pane.Dispute => true,
        Pane.Query or Pane.Resolve => !string.IsNullOrWhiteSpace(note),
        Pane.Restate => !string.IsNullOrWhiteSpace(title),
        Pane.Estimate => amount is > 0 || !string.IsNullOrWhiteSpace(note),
        Pane.Park => stages is not null && !string.IsNullOrEmpty(parkStageId),
        _ => false
    };

    private string PaneAction => pane switch
    {
        Pane.Dispute => "Send back as a query",
        Pane.Query => "Raise query",
        Pane.Resolve => "Resolve on the item",
        Pane.Restate => "Restate",
        Pane.Estimate => "Keep the estimate",
        Pane.Park => "Park it",
        _ => ""
    };

    private static DateTime? Utc(DateTime? d) => d is null ? null : DateTime.SpecifyKind(d.Value.Date, DateTimeKind.Utc);

    private Task SubmitPaneAsync() => pane switch
    {
        Pane.Dispute => RunAsync(() => _commitmentsApi.Dispute(new CommitmentNoteDto { CommitmentId = Item.Id, Note = Clean(note) }),
                                 "Sent back. It stays a query until it is resolved on the item."),
        Pane.Query => RunAsync(() => _commitmentsApi.RaiseQuery(new CommitmentNoteDto { CommitmentId = Item.Id, Note = note.Trim() }),
                               "Query raised. The answer will land on this item."),
        Pane.Resolve => RunAsync(() => _commitmentsApi.ResolveQuery(new CommitmentResolveDto
                                 {
                                     CommitmentId = Item.Id,
                                     Note = note.Trim(),
                                     Amount = amount != Item.Amount ? amount : null,
                                     DueDate = Utc(due) != Utc(Item.DueDate?.ToLocalTime()) ? Utc(due) : null
                                 }), "Resolved. The answer now lives on the item."),
        Pane.Restate => RunAsync(() => _commitmentsApi.Restate(new CommitmentRestateDto
                                 {
                                     CommitmentId = Item.Id,
                                     Title = title.Trim() != Item.Title ? title.Trim() : null,
                                     Amount = amount != Item.Amount ? amount : null,
                                     DueDate = Utc(due) != Utc(Item.DueDate?.ToLocalTime()) ? Utc(due) : null
                                 }), "Restated. The earlier statement is kept beside it."),
        Pane.Estimate => EstimateAsync(),
        Pane.Park => RunAsync(() => _commitmentsApi.Park(new CommitmentParkDto
                                 {
                                     CommitmentId = Item.Id,
                                     StageId = parkStageId != Item.StageId ? parkStageId : null,
                                     DependsOnStageId = string.IsNullOrEmpty(parkDependsOnId) ? null : parkDependsOnId,
                                     ClearDependency = string.IsNullOrEmpty(parkDependsOnId) && Item.DependsOnStageId is not null,
                                     LeadTimeDays = parkLead ?? 0
                                 }), "Parked. It stays quiet until waiting costs something."),
        _ => Task.CompletedTask
    };

    private static string? Clean(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private Task ConfirmAsync() => RunAsync(() => _commitmentsApi.Confirm(Item.Id!), "Confirmed. It is now agreed on both sides.");
    private Task ClearAsync() => RunAsync(() => _commitmentsApi.Clear(Item.Id!), "Cleared. It can still be queried later.");
    private Task AdvanceAsync(CommitmentMaturity to)
        => RunAsync(() => _commitmentsApi.SetMaturity(new CommitmentMaturityDto { CommitmentId = Item.Id, Maturity = to }),
                    $"Moved to {StepLabel(to)}.");

    private async Task RunAsync(Func<Task<Refit.IApiResponse<CommitmentDto>>> call, string done)
    {
        busy = true;
        error = null;
        menuOpen = false;
        StateHasChanged();

        try
        {
            var response = await call();
            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                pane = Pane.None;
                history = null;
                historyOpen = false;
                ToastService.ShowSuccess(done);
                if (OnChanged.HasDelegate) await OnChanged.InvokeAsync(response.Content);
            }
            else
            {
                error = _apiResponseHandler.GetApiErrorMessage(response) ?? "That did not go through.";
                if (pane == Pane.None) ToastService.ShowError(error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Commitment action failed on {Id}", Item.Id);
            error = "That did not go through.";
            if (pane == Pane.None) ToastService.ShowError(error);
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private async Task ToggleHistoryAsync()
    {
        historyOpen = !historyOpen;
        if (!historyOpen || history is not null) return;
        try
        {
            var response = await _commitmentsApi.GetChain(Item.Id!);
            history = response.IsSuccessStatusCode ? response.Content ?? new() : new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "History failed for {Id}", Item.Id);
            history = new();
        }
    }

    private async Task ToggleLinksAsync()
    {
        linksOpen = !linksOpen;
        if (!linksOpen || links is not null) return;
        try
        {
            var response = await _commitmentsApi.GetLinks(Item.Id!);
            links = response.IsSuccessStatusCode ? response.Content ?? new() : new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Links failed for {Id}", Item.Id);
            links = new();
        }
    }

    private static string Times(int n) => n == 1 ? "once" : n == 2 ? "twice" : $"{n} times";

    public static string KindLabel(CommitmentKind k) => k switch
    {
        CommitmentKind.Spec => "Spec",
        CommitmentKind.Price => "Price",
        CommitmentKind.Date => "Date",
        CommitmentKind.Material => "Material",
        _ => "Choice"
    };

    public static string KindIcon(CommitmentKind k) => k switch
    {
        CommitmentKind.Spec => "drawing",
        CommitmentKind.Price => "money",
        CommitmentKind.Date => "calendar",
        CommitmentKind.Material => "stage",
        _ => "decision"
    };

    private static string SourceLabel(CommitmentSource s) => s switch
    {
        CommitmentSource.Verbal => "On a call",
        CommitmentSource.Meeting => "At a meeting",
        CommitmentSource.Ingested => "In the thread",
        _ => "Recorded here"
    };

    private static string LinkIcon(CommitmentLinkTarget t) => t switch
    {
        CommitmentLinkTarget.Commitment => "commitment",
        CommitmentLinkTarget.Artifact => "image",
        CommitmentLinkTarget.IngestedMessage => "message",
        CommitmentLinkTarget.ProgressUpdate => "camera",
        CommitmentLinkTarget.FundingEntry or CommitmentLinkTarget.Claim => "money",
        CommitmentLinkTarget.Flag => "query",
        CommitmentLinkTarget.Document => "drawing",
        CommitmentLinkTarget.Variation => "variation",
        _ => "link"
    };
}
