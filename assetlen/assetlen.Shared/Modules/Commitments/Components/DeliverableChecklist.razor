@*
    The checklist capture and commitments are aimed at (assetlen.md §3) — one
    stage's lines on the stage page, or with no stage the project-wide work plan
    grouped by area (works-report.md §4.5). Either way a line is knocked off the
    same way, on one photo, through PlanLine. The principals write the lines; the
    delivery side ticks them; the client side reads them.
*@

@inject ILogger<DeliverableChecklist> Logger

<div class="checklist">
    @if (StageId is null && phase == LoadPhase.Ready)
    {
        <p class="checklist__summary">
            <span class="al-num">@items.Count(i => i.Status == DeliverableStatus.Done) of @items.Count</span> done
            @if (items.Where(i => i.PlannedEnd is not null).Select(i => i.PlannedEnd).Max() is { } last)
            {
                <span class="checklist__sep" aria-hidden="true">·</span>
                <span>works planned to finish <span class="al-num">@last.ToString("ddd d MMM", CultureInfo.InvariantCulture)</span></span>
            }
        </p>
    }

    <StateBlock Phase="phase" OnRetry="LoadAsync"
                ErrorTitle="@(StageId is null ? "The work plan didn't load" : "The checklist didn't load")"
                ErrorMessage="@errorMessage"
                EmptyIcon="check-circle"
                EmptyTitle="@(StageId is null ? "No work planned yet" : "No deliverables yet")"
                EmptyBody="@(StageId is null
                    ? "Lines are added on each stage's page. Once they carry a trade and planned dates, the plan reads here by area."
                    : "Five to eight lines per stage is the right grain — each one a thing that can be seen done.")">
        <Loading>
            <div class="al-shimmer al-ghost-row"></div>
            <div class="al-shimmer al-ghost-row"></div>
            <div class="al-shimmer al-ghost-row"></div>
        </Loading>
        <ChildContent>
            @if (StageId is null)
            {
                @foreach (var group in Groups)
                {
                    <section class="checklist__area" aria-label="@group.Key">
                        <div class="al-rule">
                            <span class="al-label">@group.Key</span>
                            <span class="checklist__count al-num">@group.Count(i => i.Status == DeliverableStatus.Done)/@group.Count()</span>
                        </div>
                        <ol class="checklist__list">
                            @foreach (var d in group)
                            {
                                <PlanLine @key="d.Id" Item="d" Detailed="true" ShowStage="true" OnChanged="Replace" />
                            }
                        </ol>
                    </section>
                }
            }
            else
            {
                <ol class="checklist__list">
                    @foreach (var d in items)
                    {
                        <PlanLine @key="d.Id" Item="d" Detailed="true" ShowStage="false" OnChanged="Replace" />
                    }
                </ol>
            }
        </ChildContent>
    </StateBlock>

    @if (StageId is not null && CanWrite && phase is LoadPhase.Ready or LoadPhase.Empty)
    {
        <form class="checklist__add" @onsubmit="AddAsync" @onsubmit:preventDefault>
            <label class="al-sr-only" for="dl-@StageId">New deliverable</label>
            <input id="dl-@StageId" class="al-input" maxlength="200" placeholder="Add a deliverable — e.g. Second half cast"
                   @bind="newTitle" @bind:event="oninput" />
            <button type="submit" class="al-btn al-btn--default" disabled="@(adding || string.IsNullOrWhiteSpace(newTitle))">
                <Icon Name="plus" Size="14" /> Add
            </button>
        </form>
        @if (items.Count >= 9)
        {
            <p class="al-field__hint">More than eight lines usually means this stage is two stages.</p>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    /// <summary>One stage's checklist; null for the project-wide plan.</summary>
    [Parameter] public string? StageId { get; set; }

    /// <summary>Whether this reader writes the lines (not whether they tick them — the server stamps that per line).</summary>
    [Parameter] public bool CanWrite { get; set; }

    private List<DeliverableDto> items = new();
    private LoadPhase phase = LoadPhase.Loading;
    private string? errorMessage;
    private string newTitle = "";
    private bool adding;
    private string? loadedKey;

    // Areas read in the order the work reaches them; handover, and anything
    // nobody has placed, come last.
    private IEnumerable<IGrouping<string, DeliverableDto>> Groups => items
        .GroupBy(i => string.IsNullOrWhiteSpace(i.Area) ? "Other lines" : i.Area!)
        .OrderBy(g => g.Key == "Other lines" ? 2 : g.Key == "Handover" ? 1 : 0)
        .ThenBy(g => g.Min(i => i.PlannedStart ?? DateTime.MaxValue));

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{ProjectId}/{StageId}";
        if (loadedKey == key) return;
        loadedKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        phase = LoadPhase.Loading;
        errorMessage = null;
        StateHasChanged();
        try
        {
            var response = await _workPlanApi.GetPlan(ProjectId, StageId);
            if (!response.IsSuccessStatusCode || response.Content is null)
            {
                phase = LoadPhase.Error;
                errorMessage = _apiResponseHandler.GetApiErrorMessage(response);
                return;
            }
            items = response.Content.Items;
            phase = items.Count == 0 ? LoadPhase.Empty : LoadPhase.Ready;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Work plan failed for {ProjectId}/{StageId}", ProjectId, StageId);
            phase = LoadPhase.Error;
            errorMessage = ex.Message;
        }
        finally { StateHasChanged(); }
    }

    private void Replace(DeliverableDto updated)
    {
        var i = items.FindIndex(x => x.Id == updated.Id);
        if (i >= 0) items[i] = updated;
        if (updated.Status == DeliverableStatus.Done) ToastService.ShowSuccess($"{updated.Title} — done, photo on record.");
        StateHasChanged();
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(newTitle) || StageId is null) return;
        adding = true;
        try
        {
            var response = await _commitmentsApi.AddDeliverable(new DeliverableCreateDto
            {
                ProjectId = ProjectId,
                StageId = StageId,
                Title = newTitle.Trim()
            });
            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                newTitle = "";
                await LoadAsync();
            }
            else
            {
                ToastService.ShowError(_apiResponseHandler.GetApiErrorMessage(response) ?? "Could not add that line.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not add deliverable to {StageId}", StageId);
            ToastService.ShowError("Could not add that line.");
        }
        finally
        {
            adding = false;
            StateHasChanged();
        }
    }
}
