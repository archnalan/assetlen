@page "/project/{ProjectId}/entry/{EntryId}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ShellState Shell
@inject IStreamHubService StreamHub
@inject ILogger<EntryDetail> Logger

@*
    One entry.

    This is where curation actually happens, and it happens **per frame**. The
    mediator picks three of eighteen rather than flipping a batch across — the
    evidence for why is a single minute in which seventeen photographs were
    posted and the reply, two hours later, was "nothing much changed".

    A client-side reader sees the exposed subset and, deliberately, the true
    denominator. Being told the feed is filtered is the developer's stated trust
    condition; hiding the total would break it.
*@

<PageTitle>Entry — ASSETLEN</PageTitle>

<div class="al-page">

    <StateBlock Phase="phase" OnRetry="LoadAsync"
                ErrorTitle="This entry didn't load"
                ErrorMessage="@errorMessage"
                EmptyIcon="log"
                EmptyTitle="Entry not found"
                EmptyBody="It may have been removed, or it may belong to the other side's record.">
        <ChildContent>

            <TitleBlock Eyebrow="@EyebrowText" Title="@TitleText" Subtitle="@entry!.Description">
                <Meta>
                    <div class="al-meta">
                        <span class="al-label">Posted</span>
                        <span class="al-meta__value">@Fmt.DateTimeFull(entry.DateTimeCreated)</span>
                    </div>
                    <div class="al-meta">
                        <span class="al-label">By</span>
                        <span class="al-meta__value">@AuthorLabel</span>
                    </div>
                </Meta>

                <Below>
                    @if (entry.HasIssues)
                    {
                        <span class="al-badge al-badge--warning"><Icon Name="alert" Size="11" /> Issue raised</span>
                    }
                    <span class="al-badge @(entry.Channel == Channel.Client ? "al-badge--client" : "al-badge--delivery")">
                        @(entry.Channel == Channel.Client ? "Shared with the client" : "Site Diary only")
                    </span>
                    @if (entry.CompletionPercentage is not null)
                    {
                        <span class="al-badge al-badge--neutral">@Fmt.Percent(entry.CompletionPercentage.Value) built</span>
                    }
                    <a class="al-btn al-btn--link" href="@BackHref">
                        <Icon Name="chevron-left" Size="14" /> Back
                    </a>
                </Below>
            </TitleBlock>

            @* ── Frames ─────────────────────────────────────────────────── *@
            @if (entry.ImageCount > 0)
            {
                <section class="entry__section">
                    <div class="al-rule">
                        <span class="al-label">Frames</span>
                        @if (IsClientSide && entry.Images.Count < entry.ImageCount)
                        {
                            <span class="al-subtle entry__denominator">
                                @entry.Images.Count of @entry.ImageCount shared with you
                            </span>
                        }
                    </div>

                    <EntryPhotoPanel Images="entry.Images"
                                     TotalCount="entry.ImageCount"
                                     CanExpose="@(standing?.CanExposeToClient == true)"
                                     OnChanged="OnEntryChanged" />
                </section>
            }

            @* ── Whole-entry exposure ───────────────────────────────────── *@
            @if (standing?.CanExposeToClient == true)
            {
                <section class="entry__section">
                    <div class="al-sheet entry__curate">
                        <div class="al-sheet__body">
                            <div class="al-row al-row--between">
                                <div class="entry__curate-copy">
                                    <strong>@(entry.Channel == Channel.Client ? "This entry is on the client's brief" : "This entry is internal")</strong>
                                    <span>
                                        You control emphasis, not truth. Anything that moves money, moves a date
                                        or changes an agreed spec reaches the client side regardless of this switch.
                                    </span>
                                </div>

                                <button type="button" class="al-btn al-btn--default"
                                        disabled="@changingChannel" @onclick="ToggleChannelAsync">
                                    @if (changingChannel)
                                    {
                                        <span class="al-spinner"></span>
                                    }
                                    else
                                    {
                                        <Icon Name="@(entry.Channel == Channel.Client ? "eye-off" : "eye")" Size="16" />
                                    }
                                    @(entry.Channel == Channel.Client ? "Withdraw from the brief" : "Put on the brief")
                                </button>
                            </div>
                        </div>
                    </div>
                </section>
            }

            @* ── Questions raised here ──────────────────────────────────── *@
            <section class="entry__section">
                <div class="al-rule">
                    <span class="al-label">Questions on this entry</span>
                    @if (standing?.CanWrite == true && !raising)
                    {
                        <button type="button" class="al-btn al-btn--link" @onclick="() => raising = true">
                            Raise one
                        </button>
                    }
                </div>

                @if (raising)
                {
                    <div class="al-sheet entry__raise">
                        <div class="al-sheet__body">
                            <FlagRaiseForm ProjectId="@ProjectId"
                                           ProgressUpdateId="@EntryId"
                                           StageId="@entry.StageId"
                                           OnRaised="OnQuestionRaised"
                                           OnCancel="() => raising = false" />
                        </div>
                    </div>
                }

                @if (questions.Count == 0 && !raising)
                {
                    <p class="entry__none">Nothing has been queried on this entry.</p>
                }
                else
                {
                    <div class="al-stack">
                        @foreach (var flag in questions)
                        {
                            <FlagCard Flag="flag" OnChanged="OnQuestionChanged" />
                        }
                    </div>
                }
            </section>

            @* ── Discussion ─────────────────────────────────────────────── *@
            <section class="entry__section">
                <div class="al-rule"><span class="al-label">On the record</span></div>

                @if (entry.Comments.Count == 0)
                {
                    <p class="entry__none">
                        Nothing said here yet. A remark on this entry stays attached to it — which is the
                        difference between an answer and a message that dissolves.
                    </p>
                }
                else
                {
                    <div class="entry__comments">
                        @foreach (var comment in entry.Comments.OrderBy(c => c.DateTimeCreated))
                        {
                            <article class="entry__comment">
                                <span class="al-avatar al-avatar--sm">
                                    @Fmt.Initials(null, null, comment.AuthorName)
                                </span>
                                <div class="entry__comment-body">
                                    <div class="entry__comment-head">
                                        <strong>@(comment.AuthorName ?? "Someone")</strong>
                                        <span class="al-subtle">@Fmt.Ago(comment.DateTimeCreated)</span>
                                    </div>
                                    <p>@comment.CommentText</p>
                                </div>
                            </article>
                        }
                    </div>
                }

                @if (standing?.CanWrite == true)
                {
                    <div class="entry__composer">
                        <textarea class="al-textarea" rows="2" maxlength="2000"
                                  placeholder="Add a remark. It stays attached to this entry."
                                  @bind="newComment" @bind:event="oninput"></textarea>

                        @if (!string.IsNullOrEmpty(commentError))
                        {
                            <span class="al-field__error">@commentError</span>
                        }

                        <div class="al-row al-row--end">
                            <button type="button" class="al-btn al-btn--primary"
                                    disabled="@(postingComment || string.IsNullOrWhiteSpace(newComment))"
                                    @onclick="PostCommentAsync">
                                @if (postingComment)
                                {
                                    <span class="al-spinner"></span>
                                }
                                else
                                {
                                    <Icon Name="send" Size="15" />
                                }
                                Post
                            </button>
                        </div>
                    </div>
                }
            </section>

        </ChildContent>
    </StateBlock>
</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public string EntryId { get; set; } = "";

    private ProgressUpdateDto? entry;
    private ProjectAccessDto? standing;
    private List<FlagDto> questions = new();

    private LoadPhase phase = LoadPhase.Loading;
    private string? errorMessage;
    private bool changingChannel;
    private bool postingComment;
    private bool raising;
    private string newComment = "";
    private string? commentError;
    private string? mediatorName;
    private bool joinedStream;

    private bool IsClientSide => standing?.Side == ProjectSide.Client;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await ConnectStreamAsync();
    }

    private async Task LoadAsync()
    {
        phase = LoadPhase.Loading;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var entryTask = _progressApi.GetProgressUpdate(EntryId);
            var standingTask = _projectMembersApi.GetMyStanding(ProjectId);
            var flagsTask = _flagsApi.GetFlagsByEntry(EntryId);
            var membersTask = _projectMembersApi.GetMembersByProject(ProjectId);

            await Task.WhenAll(entryTask, standingTask, flagsTask, membersTask);

            if (!entryTask.Result.IsSuccessStatusCode || entryTask.Result.Content is null)
            {
                // A Crew entry answers 404 rather than 403 to a client-side
                // reader — a refusal would confirm the Site Diary exists.
                phase = (int)entryTask.Result.StatusCode is 404 or 403 ? LoadPhase.Empty : LoadPhase.Error;
                errorMessage = _apiResponseHandler.GetApiErrorMessage(entryTask.Result);
                return;
            }

            entry = entryTask.Result.Content;

            // Fail closed: no standing means no curation controls. The server
            // would reject the call anyway; this only keeps the UI honest.
            standing = standingTask.Result.IsSuccessStatusCode ? standingTask.Result.Content : null;

            questions = flagsTask.Result.IsSuccessStatusCode ? flagsTask.Result.Content ?? new() : new();

            mediatorName = membersTask.Result.IsSuccessStatusCode
                ? membersTask.Result.Content?.FirstOrDefault(m => m.IsMediator && m.IsActive)?.UserFullName
                : null;

            phase = LoadPhase.Ready;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Entry {EntryId} failed to load", EntryId);
            phase = LoadPhase.Error;
            errorMessage = ex.Message;
        }
        finally { StateHasChanged(); }
    }

    private async Task ConnectStreamAsync()
    {
        try
        {
            StreamHub.StreamCommentReceived += OnStreamComment;
            await StreamHub.JoinStreamAsync(EntryId);
            joinedStream = true;
        }
        catch (Exception ex)
        {
            // Live updates are a convenience; the page is complete without them.
            Logger.LogWarning(ex, "Could not join stream {EntryId}", EntryId);
        }
    }

    private void OnStreamComment(StreamCommentEvent evt)
    {
        if (evt.StreamId != EntryId || evt.Comment is null || entry is null) return;

        // Our own post arrives twice — once from the REST call, once from the
        // hub — and appending both duplicates it on screen.
        if (entry.Comments.Any(c => c.Id == evt.Comment.Id)) return;

        entry.Comments.Add(evt.Comment);
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        StreamHub.StreamCommentReceived -= OnStreamComment;
        if (!joinedStream) return;
        try { await StreamHub.LeaveStreamAsync(EntryId); } catch { /* teardown */ }
    }

    private void OnEntryChanged(ProgressUpdateDto updated)
    {
        entry = updated;
        StateHasChanged();
    }

    private async Task ToggleChannelAsync()
    {
        if (entry is null || changingChannel) return;

        changingChannel = true;
        StateHasChanged();

        try
        {
            var target = entry.Channel == Channel.Client ? Channel.Crew : Channel.Client;
            var response = await _progressApi.SetChannel(entry.Id!, target);

            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                entry = response.Content;
                ToastService.ShowSuccess(target == Channel.Client
                    ? "On the client's brief."
                    : "Withdrawn from the brief.");
            }
            else
            {
                ToastService.ShowError(_apiResponseHandler.GetApiErrorMessage(response));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not change channel on {EntryId}", EntryId);
            ToastService.ShowError("Could not change who sees this entry.");
        }
        finally
        {
            changingChannel = false;
            StateHasChanged();
        }
    }

    private void OnQuestionRaised(FlagDto flag)
    {
        raising = false;
        questions.Insert(0, flag);
        StateHasChanged();
    }

    private void OnQuestionChanged(FlagDto flag)
    {
        var i = questions.FindIndex(f => f.Id == flag.Id);
        if (i >= 0) questions[i] = flag;
        StateHasChanged();
    }

    private async Task PostCommentAsync()
    {
        if (entry is null || string.IsNullOrWhiteSpace(newComment)) return;

        postingComment = true;
        commentError = null;
        StateHasChanged();

        try
        {
            var response = await _progressApi.AddComment(new ProgressCommentCreateDto
            {
                ProgressUpdateId = entry.Id,
                CommentText = newComment.Trim()
            });

            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                if (!entry.Comments.Any(c => c.Id == response.Content.Id))
                    entry.Comments.Add(response.Content);

                newComment = "";
            }
            else
            {
                commentError = _apiResponseHandler.GetApiErrorMessage(response) ?? "Could not post that.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not post comment on {EntryId}", EntryId);
            commentError = "Could not post that.";
        }
        finally
        {
            postingComment = false;
            StateHasChanged();
        }
    }

    private string EyebrowText => entry?.StageName is { Length: > 0 } stage ? stage : "Site Diary";

    private string TitleText => Fmt.Date(entry?.DateTimeCreated);

    /// <summary>
    /// One accountable face: a client-side reader sees the mediator's name on
    /// whatever crossed, whoever actually captured it (§10.1). The delivery side
    /// keeps true authorship, which is their own defensible record.
    /// </summary>
    private string AuthorLabel => IsClientSide
        ? mediatorName ?? "the delivery side"
        : entry?.CreatedByName ?? "—";

    private string BackHref => standing?.CanSeeSiteLog == true
        ? $"/project/{ProjectId}/log"
        : $"/project/{ProjectId}/brief";
}
