@using assetlen.Shared.Components.Media
@using assetlen.Shared.Models.Models.RemoteSite
@using assetlen.Shared.Models.Models.ViewModels.RemoteSiteDtos
@inject ILogger<EntryPhotoPanel> Logger

@*
    Nalan posts 13–18 frames in a batch. Forwarding all of them is what WhatsApp
    already does, so exposure is per frame and defaults to crew-only. The client
    still sees the denominator — being told the feed is curated is what makes the
    curation acceptable.
*@

@if (frames is { Count: > 0 })
{
    var ordered = frames.OrderBy(i => i.DisplayOrder).ToList();
    var active = ordered[Math.Clamp(activeIndex, 0, ordered.Count - 1)];
    var exposedCount = ordered.Count(i => i.Channel == Channel.Client);

    <div class="entry-photos">

        @if (CanExpose)
        {
            <div class="entry-photos__bar">
                <span class="entry-photos__tally al-num">
                    <b>@exposedCount</b> of @ordered.Count shown to the client
                </span>

                @if (!curating)
                {
                    <button type="button" class="entry-photos__bar-btn" @onclick="StartCurating">
                        Choose what they see
                    </button>
                }
                else
                {
                    <div class="entry-photos__bar-actions">
                        <span class="entry-photos__selected al-num">@selected.Count selected</span>
                        <button type="button" class="entry-photos__bar-btn"
                                disabled="@(saving || selected.Count == 0)"
                                @onclick="() => ApplySelection(Channel.Client)">
                            Show to client
                        </button>
                        <button type="button" class="entry-photos__bar-btn"
                                disabled="@(saving || selected.Count == 0)"
                                @onclick="() => ApplySelection(Channel.Crew)">
                            Withdraw
                        </button>
                        <button type="button" class="entry-photos__bar-btn entry-photos__bar-btn--quiet"
                                disabled="@saving" @onclick="StopCurating">
                            Done
                        </button>
                    </div>
                }
            </div>
        }

        <button type="button"
                class="entry-photos__hero"
                @onclick="() => OpenLightbox(activeIndex)"
                aria-label="Open photo">
            <img class="entry-photos__hero-img"
                 src="@(active.ImageUrl)"
                 alt="@(active.Caption ?? "Site photo")"
                 loading="lazy" />
            @if (!string.IsNullOrWhiteSpace(active.Caption))
            {
                <span class="entry-photos__hero-caption">@active.Caption</span>
            }
            @if (ordered.Count > 1)
            {
                <span class="entry-photos__hero-counter al-num">@(activeIndex + 1) / @ordered.Count</span>
            }
            @if (CanExpose && active.Channel == Channel.Client)
            {
                <span class="entry-photos__hero-state">Client</span>
            }
        </button>

        @if (ordered.Count > 1)
        {
            <div class="entry-photos__strip" role="@(curating ? "group" : "tablist")">
                @for (var i = 0; i < ordered.Count; i++)
                {
                    var idx = i;
                    var img = ordered[idx];
                    var isSelected = selected.Contains(img.Id!);
                    var isExposed = img.Channel == Channel.Client;

                    <button type="button"
                            role="@(curating ? "checkbox" : "tab")"
                            class="entry-photos__thumb @(!curating && idx == activeIndex ? "is-active" : "") @(curating && isSelected ? "is-selected" : "") @(CanExpose && isExposed ? "is-exposed" : "")"
                            aria-selected="@(curating ? null : (bool?)(idx == activeIndex))"
                            aria-checked="@(curating ? (bool?)isSelected : null)"
                            aria-label="@ThumbLabel(idx, isExposed)"
                            disabled="@saving"
                            @onclick="() => OnThumbClick(idx, img)">
                        <img src="@(img.ThumbnailUrl ?? img.ImageUrl)" alt="" loading="lazy" />
                        @if (curating)
                        {
                            <span class="entry-photos__check" aria-hidden="true">
                                @if (isSelected)
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 6 9 17l-5-5" />
                                    </svg>
                                }
                            </span>
                        }
                    </button>
                }
            </div>
        }

        @* Told the feed is filtered, rather than left to assume it is complete. *@
        @if (!CanExpose && total > ordered.Count)
        {
            <p class="entry-photos__note">
                Showing @ordered.Count of @total frames. The rest is internal site record.
            </p>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="entry-photos__error" role="alert">@error</p>
        }
    </div>

    <PhotoLightbox @bind-IsOpen="lightboxOpen"
                   StartIndex="lightboxStart"
                   Images="@(ordered.Select(i => new PhotoLightbox.LightboxImage(i.ImageUrl ?? string.Empty, i.Caption)).ToList())" />
}
else if (total > 0)
{
    @* Saying so beats rendering nothing, which reads as "no photos were posted". *@
    <p class="entry-photos__note">
        @total frame@(total > 1 ? "s" : "") on this entry, none released to the client side yet.
    </p>
}

@code {
    [Parameter, EditorRequired] public List<ProgressImageDto> Images { get; set; } = new();

    /// <summary>
    /// True total including frames this reader cannot see. Defaults to the visible
    /// count, so an un-updated caller shows no denominator rather than a wrong one.
    /// </summary>
    [Parameter] public int TotalCount { get; set; }

    /// <summary>Mediator, owner or manager. The server re-checks every call.</summary>
    [Parameter] public bool CanExpose { get; set; }

    /// <summary>Fires with the refreshed entry after frames are exposed or withdrawn.</summary>
    [Parameter] public EventCallback<ProgressUpdateDto> OnChanged { get; set; }

    private int activeIndex;
    private bool lightboxOpen, curating, saving;
    private int lightboxStart;
    private string? error;
    private readonly HashSet<string> selected = new();

    // Local mirrors: writing back into [Parameter] properties is not durable —
    // Blazor reassigns them from the parent and the update silently reverts.
    private List<ProgressImageDto> frames = new();
    private int total;

    protected override void OnParametersSet()
    {
        frames = Images;
        total = Math.Max(TotalCount, Images.Count);
    }

    private void StartCurating()
    {
        curating = true;
        selected.Clear();
    }

    private void StopCurating()
    {
        curating = false;
        selected.Clear();
        error = null;
    }

    private void OnThumbClick(int idx, ProgressImageDto img)
    {
        if (!curating)
        {
            activeIndex = idx;
            return;
        }

        if (string.IsNullOrEmpty(img.Id)) return;
        if (!selected.Add(img.Id)) selected.Remove(img.Id);
    }

    private async Task ApplySelection(Channel channel)
    {
        if (selected.Count == 0) return;
        saving = true;
        error = null;
        StateHasChanged();
        try
        {
            var resp = await _progressApi.SetImageChannel(new ProgressImageExposureDto
            {
                ImageIds = selected.ToList(),
                Channel = channel
            });

            if (resp.IsSuccessStatusCode && resp.Content is not null)
            {
                // Take the server copy: exposure changes what the entry reports, so a
                // local patch would drift from what other readers are shown.
                frames = resp.Content.Images;
                total = resp.Content.ImageCount;
                activeIndex = 0;
                selected.Clear();
                await OnChanged.InvokeAsync(resp.Content);
            }
            else
            {
                error = _apiResponseHandler.GetApiErrorMessage(resp) ?? "Could not change what the client sees.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing frame exposure");
            error = "Could not change what the client sees.";
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    private string ThumbLabel(int idx, bool isExposed)
    {
        var n = idx + 1;
        if (!curating) return $"Photo {n}";
        return isExposed ? $"Photo {n}, currently shown to the client" : $"Photo {n}, internal only";
    }

    private void OpenLightbox(int from)
    {
        if (curating) return;
        lightboxStart = from;
        lightboxOpen = true;
    }
}
