@*
    A project on the home screen.

    Media is the hero and the chrome recedes, but the card has to answer three
    questions without being opened: how far through is it, what is happening
    now, and are the sub-projects part of it. The third is why sub-projects are
    rendered *inside* the parent card rather than as siblings in the grid — a
    guest wing that looks like its own project is precisely the misreading that
    turned one engagement into nine.
*@

@using assetlen.Shared.Models.Models.RemoteSite
@using assetlen.Shared.Models.Models.ViewModels.RemoteSiteDtos
@implements IDisposable

<article class="pcard">

    <a class="pcard__cover" href="/project/@Project.Id"
       @onmouseenter="() => paused = true"
       @onmouseleave="() => paused = false"
       aria-label="@Project.ProjectName">

        @if (Frames.Count > 0)
        {
            @for (var i = 0; i < Frames.Count; i++)
            {
                var idx = i;
                <img class="pcard__frame @(idx == activeFrame ? "is-active" : "")"
                     src="@Frames[idx]" alt=""
                     loading="@(idx == 0 && Eager ? "eager" : "lazy")" />
            }
        }
        else
        {
            <div class="pcard__cover-blank al-gridded">
                <Icon Name="project" Size="34" Weight="1" Class="pcard__cover-icon" />
            </div>
        }

        <div class="pcard__cover-scrim"></div>

        <div class="pcard__cover-head">
            <span class="al-badge @RiskBadgeClass">@Project.TimelineStatus</span>
            @if (Project.SubProjectCount > 0)
            {
                <span class="al-badge al-badge--neutral pcard__nest">
                    <Icon Name="wing" Size="11" />
                    @Project.SubProjectCount sub-project@(Project.SubProjectCount == 1 ? "" : "s")
                </span>
            }
        </div>

        <div class="pcard__cover-foot">
            <h3 class="pcard__title">@Project.ProjectName</h3>
            @if (!string.IsNullOrEmpty(Project.Location))
            {
                <span class="pcard__location">
                    <Icon Name="pin" Size="12" /> @Project.Location
                </span>
            }
        </div>

        @if (Frames.Count > 1)
        {
            <div class="pcard__dots">
                @for (var i = 0; i < Frames.Count; i++)
                {
                    <span class="pcard__dot @(i == activeFrame ? "is-active" : "")"></span>
                }
            </div>
        }
    </a>

    <div class="pcard__body">

        <div class="pcard__stage">
            <span class="al-label">Now</span>
            <span class="pcard__stage-name">@(Project.CurrentStageName ?? "Not started")</span>
        </div>

        <div class="pcard__meter">
            <div class="al-meter">
                <span class="al-meter__seg al-meter__seg--cleared"
                      style="width:@(Clamp(Project.CompletedPercentage))%"></span>
                <span class="al-meter__seg al-meter__seg--funded"
                      style="width:@(Clamp(Math.Max(0, Project.FundedPercentage - Project.CompletedPercentage)))%"></span>
            </div>
            <div class="pcard__figures al-num">
                <span><b>@Fmt.Percent(Project.CompletedPercentage)</b> built</span>
                <span><b>@Fmt.Percent(Project.FundedPercentage)</b> funded</span>
            </div>
        </div>

        @if (ShowMoney)
        {
            <div class="pcard__money">
                <div class="al-stat">
                    <span class="al-label">Budget</span>
                    <span class="al-stat__value al-stat__value--sm">@Fmt.MoneyShort(Project.TotalBudget, Project.Currency)</span>
                </div>
                <div class="al-stat">
                    <span class="al-label">Released</span>
                    <span class="al-stat__value al-stat__value--sm">@Fmt.MoneyShort(Project.TotalFunded, Project.Currency)</span>
                </div>
            </div>
        }

        <footer class="pcard__foot">
            <span class="al-subtle">
                @(Project.LastUpdateDate.HasValue ? $"Last posted {Fmt.Ago(Project.LastUpdateDate)}" : "Nothing posted yet")
            </span>
            <a class="al-btn al-btn--link" href="/project/@Project.Id">
                Open <Icon Name="arrow-right" Size="14" />
            </a>
        </footer>
    </div>

    @if (Project.SubProjects.Count > 0)
    {
        <ul class="pcard__children">
            @foreach (var sub in Project.SubProjects)
            {
                <li>
                    <a class="pcard__child" href="/project/@sub.Id">
                        <Icon Name="wing" Size="15" />
                        <span class="al-truncate">@sub.ProjectName</span>
                        <span class="al-spacer"></span>
                        <span class="al-subtle al-num">@Fmt.Percent(sub.CompletedPercentage)</span>
                        <Icon Name="chevron-right" Size="14" Class="al-subtle" />
                    </a>
                </li>
            }
        </ul>
    }

    @if (!Project.IsSubscriptionActive && Project.Status == ProjectStatus.Active)
    {
        <div class="pcard__notice">
            <Icon Name="alert" Size="15" />
            <span>Billing is not active on this project.</span>
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public ProjectCardDto Project { get; set; } = default!;

    /// <summary>False for Crew and Guest, who have no financial visibility anywhere.</summary>
    [Parameter] public bool ShowMoney { get; set; } = true;

    /// <summary>Set on the first card only; everything below the fold lazy-loads.</summary>
    [Parameter] public bool Eager { get; set; }

    private int activeFrame;
    private System.Threading.Timer? timer;
    private bool paused;

    private List<string> Frames =>
        Project.RecentImageUrls.Count > 0
            ? Project.RecentImageUrls
            : string.IsNullOrEmpty(Project.LatestImageUrl) ? new List<string>() : new() { Project.LatestImageUrl! };

    protected override void OnAfterRender(bool firstRender)
    {
        // 5000ms dwell, per the motion spec. Pauses on hover so a reader can
        // look at one frame without it sliding out from under them.
        if (firstRender && Frames.Count > 1)
            timer = new System.Threading.Timer(_ => Tick(), null, 5000, 5000);
    }

    private void Tick()
    {
        if (paused || Frames.Count <= 1) return;
        activeFrame = (activeFrame + 1) % Frames.Count;
        InvokeAsync(StateHasChanged);
    }

    private static decimal Clamp(decimal v) => Math.Clamp(v, 0m, 100m);

    private string RiskBadgeClass => Project.RiskLevel switch
    {
        RiskLevel.Green => "al-badge--success",
        RiskLevel.Yellow => "al-badge--warning",
        RiskLevel.Red => "al-badge--danger",
        _ => "al-badge--neutral"
    };

    public void Dispose() => timer?.Dispose();
}
