@page "/project/{ProjectId}/add-funding"
@attribute [Authorize]
@inject NavigationManager Nav
@inject ILogger<AddFunding> Logger

@*
    Record that a stage was funded.

    **Assetlen never holds or moves money.** Funds on the real project moved
    through three named agents, two banks, mobile money and a third party's
    account — rails this product could not see if it tried. So this screen
    records a fact about a transfer that happened at the bank, and the value of
    the record is that the other side then acknowledges it. That acknowledgement
    is what the reconciliation meeting was standing in for.
*@

<PageTitle>Record a release — ASSETLEN</PageTitle>

<div class="al-page al-page--reading">

    <TitleBlock Eyebrow="Stages &amp; money" Title="Record a release"
                Subtitle="A release you have already made at the bank. The other side confirms receipt here.">
        <Actions>
            <a class="al-btn al-btn--quiet" href="/project/@ProjectId/money">Cancel</a>
        </Actions>
    </TitleBlock>

    <div class="al-alert al-alert--info">
        <Icon Name="info" Size="18" />
        <span>
            Assetlen records that a stage was funded. It never holds or moves money — the transfer
            happens at your bank, exactly as it does now.
        </span>
    </div>

    <div class="funding">

        @* The catalogue is reachable from here, not only at project creation:
           naming a specific allocation of funds is exactly when a reader
           discovers the stage they need was never set up. *@
        <div class="al-field">
            <StagePicker ProjectId="@ProjectId" @bind-StageId="model.StageId"
                         Label="Against which stage" ShowDetail="false" />
            @if (SelectedStage is { } selected)
            {
                <span class="al-field__hint">
                    Budget @Fmt.Money(selected.BudgetAmount ?? 0, currency).
                    Released so far @Fmt.Money(ReleasedOn(selected.Id), currency).
                </span>
            }
        </div>

        @* Peter funds from abroad. He knows what he sent — in dollars — and the
           ledger is kept in the project's currency, so the conversion happens
           here once, in the open, rather than in a WhatsApp message nobody can
           find later. *@
        <div class="al-field">
            <div class="funding__amount-head">
                <label class="al-label" for="fund-amount">Amount</label>
                <div class="funding__ccy" role="group" aria-label="Currency sent in">
                    @foreach (var option in CurrencyOptions)
                    {
                        <button type="button"
                                class="funding__ccy-opt @(option == sentCurrency ? "is-active" : "")"
                                aria-pressed="@(option == sentCurrency)"
                                @onclick="() => SetCurrency(option)">
                            @option
                        </button>
                    }
                </div>
            </div>

            <input id="fund-amount" class="al-input al-input--money" type="number" min="0" step="@AmountStep"
                   placeholder="0"
                   @bind="sentAmount" @bind:event="oninput" />

            @if (IsConverting)
            {
                <div class="funding__rate">
                    <label class="al-label" for="fund-rate">Rate — 1 @sentCurrency buys</label>
                    <div class="funding__rate-row">
                        <input id="fund-rate" class="al-input al-input--money" type="number" min="0" step="0.01"
                               placeholder="0"
                               @bind="exchangeRate" @bind:event="oninput" />
                        <span class="funding__rate-ccy">@currency</span>
                    </div>
                </div>
            }

            @if (ConvertedAmount > 0)
            {
                <span class="al-field__hint">
                    @if (IsConverting)
                    {
                        <text>
                            @Fmt.Money(sentAmount, sentCurrency) sent
                            → <strong>@Fmt.Money(ConvertedAmount, currency)</strong> against this stage.
                            Both figures stay on the record.
                        </text>
                    }
                    else
                    {
                        <text>@Fmt.Money(ConvertedAmount, currency)</text>
                    }
                </span>
            }
            else if (IsConverting && sentAmount > 0)
            {
                <span class="al-field__hint funding__hint--warn">
                    Add the rate you got and this becomes a @currency figure the other side can confirm.
                </span>
            }
        </div>

        <div class="al-field">
            <label class="al-label" for="fund-date">Date sent</label>
            <input id="fund-date" class="al-input" type="date" @bind="paymentDate" />
        </div>

        <div class="al-field">
            <label class="al-label" for="fund-note">What it covers</label>
            <textarea id="fund-note" class="al-textarea" rows="2" maxlength="500"
                      placeholder="e.g. Retaining wall, second release — materials and labour to the north run."
                      @bind="model.Notes" @bind:event="oninput"></textarea>
            <span class="al-field__hint">
                A line here is what stops the next reconciliation turning into "too many stages combined".
            </span>
        </div>

        @* Optional, and it stays optional — a required receipt would stop the
           release being recorded at all. When there is one it is shown to the
           delivery side while they decide, which is when it settles the
           question rather than after. *@
        <div class="al-field">
            <label class="al-label">Transaction evidence <span class="funding__optional">optional</span></label>

            @if (evidence is null)
            {
                <label class="funding__attach">
                    <InputFile OnChange="OnEvidenceSelected" accept="image/*,application/pdf" class="al-sr-only" />
                    <Icon Name="upload" Size="16" />
                    <span>Attach the transfer slip</span>
                </label>
                <span class="al-field__hint">
                    A screenshot or slip. The other side sees it while they confirm what landed.
                </span>
            }
            else
            {
                <div class="funding__attached">
                    <Icon Name="document" Size="16" />
                    <span class="funding__attached-name al-truncate">@evidence.Name</span>
                    <button type="button" class="al-btn al-btn--link" @onclick="ClearEvidence">Remove</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(evidenceError))
            {
                <span class="al-field__hint funding__hint--warn">@evidenceError</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="al-alert al-alert--error" role="alert">
                <Icon Name="error" Size="18" />
                <span>@errorMessage</span>
            </div>
        }

        <div class="funding__actions">
            <a class="al-btn al-btn--quiet" href="/project/@ProjectId/money">Cancel</a>
            <button type="button" class="al-btn al-btn--primary al-btn--lg"
                    disabled="@(saving || model.Amount <= 0)" @onclick="SubmitAsync">
                @if (saving)
                {
                    <span class="al-spinner"></span><span>Recording…</span>
                }
                else
                {
                    <span>Record release</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private readonly FundingEntryCreateDto model = new();
    private DateTime paymentDate = DateTime.Now.Date;
    private List<StageDto> stages = new();
    private List<FundingEntryDto> existing = new();
    private string currency = "UGX";
    private bool saving;
    private string? errorMessage;

    // What the funder typed, and in what. Kept apart from model.Amount so the
    // conversion is applied once at submit and the typed figure is never
    // silently overwritten while they are still editing the rate.
    private decimal sentAmount;
    private string sentCurrency = "UGX";
    private decimal exchangeRate;

    private IBrowserFile? evidence;
    private string? evidenceError;

    private const long MaxEvidenceBytes = 8 * 1024 * 1024;

    private string[] CurrencyOptions => new[] { currency, "USD" }.Distinct().ToArray();

    private bool IsConverting => !string.Equals(sentCurrency, currency, StringComparison.OrdinalIgnoreCase);

    private string AmountStep => IsConverting ? "1" : "1000";

    /// <summary>What this release is worth in the project's currency — the figure the ledger keeps.</summary>
    private decimal ConvertedAmount => IsConverting
        ? (exchangeRate > 0 ? decimal.Round(sentAmount * exchangeRate, 2, MidpointRounding.AwayFromZero) : 0m)
        : sentAmount;

    private bool CanSubmit => sentAmount > 0 && ConvertedAmount > 0 && !saving;

    private StageDto? SelectedStage => stages.FirstOrDefault(s => s.Id == model.StageId);

    private void SetCurrency(string next)
    {
        sentCurrency = next;
        if (!IsConverting) exchangeRate = 0m;
    }

    private async Task OnEvidenceSelected(InputFileChangeEventArgs e)
    {
        evidenceError = null;
        var file = e.File;

        if (file.Size > MaxEvidenceBytes)
        {
            evidenceError = "That file is over 8 MB. A screenshot of the slip is enough.";
            return;
        }

        evidence = file;
        await Task.CompletedTask;
    }

    private void ClearEvidence()
    {
        evidence = null;
        evidenceError = null;
    }

    protected override async Task OnInitializedAsync()
    {
        model.ProjectId = ProjectId;

        try
        {
            var stagesTask = _stagesApi.GetStagesByProjectId(ProjectId);
            var projectTask = _projectsRSApi.GetProjectById(ProjectId);
            var fundingTask = _fundingApi.GetFundingByProject(ProjectId);

            await Task.WhenAll(stagesTask, projectTask, fundingTask);

            if (stagesTask.Result.IsSuccessStatusCode)
                stages = (stagesTask.Result.Content ?? new()).OrderBy(s => s.DisplayOrder).ToList();

            if (projectTask.Result.IsSuccessStatusCode)
                currency = projectTask.Result.Content?.Currency ?? "UGX";

            if (fundingTask.Result.IsSuccessStatusCode)
                existing = fundingTask.Result.Content ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not preload funding context for {ProjectId}", ProjectId);
        }
    }

    /// <summary>What has already gone out against a stage. Shown while typing so a double release is visible before it is made.</summary>
    private decimal ReleasedOn(string stageId)
        => existing.Where(f => f.StageId == stageId && f.Status != FundingStatus.Rejected).Sum(f => f.SettledAmount);

    /// <summary>
    /// Store the slip once in the artifact store and carry its id. Files are
    /// hash-matched there, so re-attaching the same screenshot does not make a
    /// second copy (CLAUDE.md §1).
    /// </summary>
    private async Task<bool> AttachEvidenceAsync()
    {
        try
        {
            await using var stream = evidence!.OpenReadStream(MaxEvidenceBytes);
            var part = new Refit.StreamPart(stream, evidence.Name, evidence.ContentType);

            var upload = await _artifactsApi.Upload(part, ProjectId);

            if (!upload.IsSuccessStatusCode || upload.Content is null)
            {
                errorMessage = _apiResponseHandler.GetApiErrorMessage(upload)
                    ?? "That attachment could not be stored. Remove it and the release will still record.";
                return false;
            }

            model.EvidenceArtifactId = upload.Content.Id;
            model.EvidenceFileName = evidence.Name;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not store transfer evidence on {ProjectId}", ProjectId);
            errorMessage = "That attachment could not be stored. Remove it and the release will still record.";
            return false;
        }
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit) return;

        saving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            model.PaymentDate = DateTime.SpecifyKind(paymentDate, DateTimeKind.Utc);
            if (string.IsNullOrEmpty(model.StageId)) model.StageId = null;

            // The server converts too, from the same two numbers. Sending the
            // typed figure and the rate rather than the product keeps the
            // arithmetic in one place and the original figure on the record.
            model.Amount = sentAmount;
            model.Currency = sentCurrency;
            model.ExchangeRate = IsConverting ? exchangeRate : null;

            if (evidence is not null && !await AttachEvidenceAsync()) return;

            var response = await _fundingApi.AddFundingEntry(model);

            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess($"{Fmt.Money(ConvertedAmount, currency)} recorded. It shows as awaiting confirmation until the other side says what landed.");
                Nav.NavigateTo($"/project/{ProjectId}/money");
                return;
            }

            errorMessage = _apiResponseHandler.GetApiErrorMessage(response) ?? "Could not record that release.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not record funding on {ProjectId}", ProjectId);
            errorMessage = "Could not record that release. Nothing has been changed.";
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }
}
