@page "/project/{ProjectId}/add-funding"
@using assetlen.Shared.Models.Models.RemoteSite
@using assetlen.Shared.Models.Models.ViewModels.RemoteSiteDtos
@using static assetlen.Shared.Components.Navigation.Breadcrumbs
@layout ProjectsLayout
@attribute [Authorize(Roles = $"{UserRoles.Contractor},{UserRoles.Manager},{UserRoles.Client}")]
@inject NavigationManager Nav
@inject ILogger<AddFunding> Logger

<PageTitle>Record Deposit — ASSETLEN</PageTitle>

<Breadcrumbs Items="@BuildBreadcrumbs()" />

<div class="project-page-header">
    <div>
        <h1 class="project-page-title">Record Deposit</h1>
        <p class="project-page-subtitle">Track a capital payment to your project</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="project-alert project-alert-error project-mt-md">@errorMessage</div>
}

<div class="project-card project-mt-md">
    <div class="project-card-body">
        <!-- Stage Selection -->
        <div class="project-form-group">
            <label class="project-label">Allocate to Stage *</label>
            @if (stages == null)
            {
                <div class="project-skeleton project-skeleton-line" style="height:40px;"></div>
            }
            else
            {
                <select class="project-input" @bind="model.StageId">
                    <option value="">Select a stage...</option>
                    @foreach (var stage in stages)
                    {
                        <option value="@stage.Id">@stage.StageName — Budget: @((stage.BudgetAmount ?? 0).ToString("N0"))</option>
                    }
                </select>
            }
        </div>

        <!-- Amount -->
        <div class="project-form-group">
            <label class="project-label">Amount *</label>
            <input class="project-input" type="number" step="any" @bind="model.Amount" placeholder="0" />
        </div>

        <!-- Payment Date -->
        <div class="project-form-group">
            <label class="project-label">Payment Date *</label>
            <input class="project-input" type="date" @bind="model.PaymentDate" />
        </div>

        <!-- Notes -->
        <div class="project-form-group">
            <label class="project-label">Notes</label>
            <textarea class="project-input project-textarea" @bind="model.Notes" rows="2"
                      placeholder="e.g. Bank transfer ref #12345, Mobile Money, etc."></textarea>
        </div>
    </div>
</div>

<div class="project-card project-mt-sm">
    <div class="project-card-body" style="text-align:center;">
        <div class="project-text-xs project-text-muted">
            Your project manager will need to confirm this deposit once materials are received.
        </div>
    </div>
</div>

<div class="project-form-actions project-mt-md project-mb-lg">
    <a href="/project/@ProjectId" class="project-btn project-btn-secondary">Cancel</a>
    <button class="project-btn project-btn-primary" @onclick="SubmitFunding" disabled="@(isSaving || !CanSubmit)">
        @if (isSaving)
        {
            <span class="project-spinner"></span>
            <text>Recording...</text>
        }
        else
        {
            <text>Record Deposit</text>
        }
    </button>
</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private FundingEntryCreateDto model = new()
    {
        PaymentDate = DateTime.Today
    };

    private List<StageDto>? stages;
    private string? projectName;
    private bool isSaving;
    private string? errorMessage;

    private IEnumerable<BreadcrumbItem> BuildBreadcrumbs()
    {
        yield return new BreadcrumbItem("Portfolio", "/portfolio");
        yield return new BreadcrumbItem(projectName ?? "Project", $"/project/{ProjectId}");
        yield return new BreadcrumbItem("Record deposit");
    }

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(model.StageId) && model.Amount > 0;

    protected override async Task OnInitializedAsync()
    {
        model.ProjectId = ProjectId;
        try
        {
            var resp = await _stagesApi.GetStagesByProjectId(ProjectId);
            if (resp.IsSuccessStatusCode)
                stages = resp.Content;
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading stages"); }
        try
        {
            var pResp = await _projectsRSApi.GetProjectById(ProjectId);
            if (pResp.IsSuccessStatusCode) projectName = pResp.Content?.ProjectName;
        }
        catch { /* breadcrumb falls back to "Project" */ }
    }

    private async Task SubmitFunding()
    {
        if (isSaving || !CanSubmit) return;
        isSaving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var resp = await _fundingApi.AddFundingEntry(model);
            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo($"/project/{ProjectId}?tab=funding");
            }
            else
            {
                errorMessage = _apiResponseHandler.GetApiErrorMessage(resp) ?? "Failed to record deposit.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error recording deposit");
            errorMessage = "An unexpected error occurred.";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}
