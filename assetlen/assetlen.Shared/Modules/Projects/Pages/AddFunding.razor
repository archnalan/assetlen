@page "/project/{ProjectId}/add-funding"
@attribute [Authorize]
@inject NavigationManager Nav
@inject ILogger<AddFunding> Logger

@*
    Record that a stage was funded.

    **Assetlen never holds or moves money.** Funds on the real project moved
    through three named agents, two banks, mobile money and a third party's
    account — rails this product could not see if it tried. So this screen
    records a fact about a transfer that happened at the bank, and the value of
    the record is that the other side then acknowledges it. That acknowledgement
    is what the reconciliation meeting was standing in for.
*@

<PageTitle>Record a release — ASSETLEN</PageTitle>

<div class="al-page al-page--reading">

    <TitleBlock Eyebrow="Stages &amp; money" Title="Record a release"
                Subtitle="A release you have already made at the bank. The other side confirms receipt here.">
        <Actions>
            <a class="al-btn al-btn--quiet" href="/project/@ProjectId/money">Cancel</a>
        </Actions>
    </TitleBlock>

    <div class="al-alert al-alert--info">
        <Icon Name="info" Size="18" />
        <span>
            Assetlen records that a stage was funded. It never holds or moves money — the transfer
            happens at your bank, exactly as it does now.
        </span>
    </div>

    <div class="funding">

        <div class="al-field">
            <label class="al-label" for="fund-stage">Against which stage</label>
            <select id="fund-stage" class="al-select" @bind="model.StageId">
                <option value="">Project-wide</option>
                @foreach (var stage in stages)
                {
                    <option value="@stage.Id">@stage.DisplayOrder.ToString("D2") — @stage.StageName</option>
                }
            </select>
            @if (SelectedStage is { } selected)
            {
                <span class="al-field__hint">
                    Budget @Fmt.Money(selected.BudgetAmount ?? 0, currency).
                    Released so far @Fmt.Money(ReleasedOn(selected.Id), currency).
                </span>
            }
        </div>

        <div class="al-field">
            <label class="al-label" for="fund-amount">Amount (@currency)</label>
            <input id="fund-amount" class="al-input al-input--money" type="number" min="0" step="1000"
                   placeholder="0"
                   @bind="model.Amount" @bind:event="oninput" />
            @if (model.Amount > 0)
            {
                <span class="al-field__hint">@Fmt.Money(model.Amount, currency)</span>
            }
        </div>

        <div class="al-field">
            <label class="al-label" for="fund-date">Date sent</label>
            <input id="fund-date" class="al-input" type="date" @bind="paymentDate" />
        </div>

        <div class="al-field">
            <label class="al-label" for="fund-note">What it covers</label>
            <textarea id="fund-note" class="al-textarea" rows="2" maxlength="500"
                      placeholder="e.g. Retaining wall, second release — materials and labour to the north run."
                      @bind="model.Notes" @bind:event="oninput"></textarea>
            <span class="al-field__hint">
                A line here is what stops the next reconciliation turning into "too many stages combined".
            </span>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="al-alert al-alert--error" role="alert">
                <Icon Name="error" Size="18" />
                <span>@errorMessage</span>
            </div>
        }

        <div class="funding__actions">
            <a class="al-btn al-btn--quiet" href="/project/@ProjectId/money">Cancel</a>
            <button type="button" class="al-btn al-btn--primary al-btn--lg"
                    disabled="@(saving || model.Amount <= 0)" @onclick="SubmitAsync">
                @if (saving)
                {
                    <span class="al-spinner"></span><span>Recording…</span>
                }
                else
                {
                    <span>Record release</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private readonly FundingEntryCreateDto model = new();
    private DateTime paymentDate = DateTime.Now.Date;
    private List<StageDto> stages = new();
    private List<FundingEntryDto> existing = new();
    private string currency = "UGX";
    private bool saving;
    private string? errorMessage;

    private StageDto? SelectedStage => stages.FirstOrDefault(s => s.Id == model.StageId);

    protected override async Task OnInitializedAsync()
    {
        model.ProjectId = ProjectId;

        try
        {
            var stagesTask = _stagesApi.GetStagesByProjectId(ProjectId);
            var projectTask = _projectsRSApi.GetProjectById(ProjectId);
            var fundingTask = _fundingApi.GetFundingByProject(ProjectId);

            await Task.WhenAll(stagesTask, projectTask, fundingTask);

            if (stagesTask.Result.IsSuccessStatusCode)
                stages = (stagesTask.Result.Content ?? new()).OrderBy(s => s.DisplayOrder).ToList();

            if (projectTask.Result.IsSuccessStatusCode)
                currency = projectTask.Result.Content?.Currency ?? "UGX";

            if (fundingTask.Result.IsSuccessStatusCode)
                existing = fundingTask.Result.Content ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not preload funding context for {ProjectId}", ProjectId);
        }
    }

    /// <summary>What has already gone out against a stage. Shown while typing so a double release is visible before it is made.</summary>
    private decimal ReleasedOn(string stageId)
        => existing.Where(f => f.StageId == stageId && f.Status != FundingStatus.Rejected).Sum(f => f.Amount);

    private async Task SubmitAsync()
    {
        if (saving || model.Amount <= 0) return;

        saving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            model.PaymentDate = DateTime.SpecifyKind(paymentDate, DateTimeKind.Utc);
            if (string.IsNullOrEmpty(model.StageId)) model.StageId = null;

            var response = await _fundingApi.AddFundingEntry(model);

            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess($"{Fmt.Money(model.Amount, currency)} recorded. It shows as awaiting confirmation until the other side acknowledges it.");
                Nav.NavigateTo($"/project/{ProjectId}/money");
                return;
            }

            errorMessage = _apiResponseHandler.GetApiErrorMessage(response) ?? "Could not record that release.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not record funding on {ProjectId}", ProjectId);
            errorMessage = "Could not record that release. Nothing has been changed.";
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }
}
