@page "/project/{ProjectId}/capture"
@page "/project/{ProjectId}/progress/add"
@attribute [Authorize]
@inject NavigationManager Nav
@inject CaptureOutbox Outbox
@inject ILogger<CaptureEntry> Logger

@*
    Capture — three taps: the work, the camera roll, post (assetlen.md §8).

    Capture must be dumber than WhatsApp. Anything that adds a tap sends people
    straight back to the chat, so the note, the reading, the voice note and the
    issue flag all live behind "More", and none of them is required. Real
    capture is thirteen to eighteen frames at 22:00, so the picker is the
    camera roll, multi-select, and a post is written to the phone first and sent
    when there is signal.
*@

<PageTitle>Capture — ASSETLEN</PageTitle>

<ProjectPage ProjectId="@ProjectId" Section="capture" Eyebrow="Site Diary"
             Subtitle="The work, the photos, post. Everything else is optional." Context="ctx">

    <OutboxStatus ProjectId="@ProjectId" />

    @if (justPosted is not null)
    {
        <div class="al-alert al-alert--success capture__posted" role="status">
            <Icon Name="check-circle" Size="18" />
            <div>
                <strong class="al-alert__title">@justPosted</strong>
                <a href="/project/@ProjectId/log">Open the Site Diary</a>
            </div>
        </div>
    }

    <div class="capture">

        <section class="capture__step" aria-labelledby="cap-work">
            <h2 class="capture__step-title" id="cap-work"><span class="capture__n">1</span> What is this?</h2>

            <StateBlock Phase="todayPhase" OnRetry="LoadTodayAsync"
                        ErrorTitle="Today's work didn't load"
                        ErrorMessage="You can still post; it will be filed against the stage under way."
                        EmptyIcon="stage" EmptyTitle="No deliverables set up yet"
                        EmptyBody="Post anyway — it is filed against the stage under way. The checklist lives on the register.">
                <ChildContent>
                    <div class="capture__work" role="radiogroup" aria-label="Deliverable">
                        @foreach (var d in Shown)
                        {
                            var picked = d.Id == deliverableId;
                            <button type="button" role="radio" aria-checked="@(picked ? "true" : "false")"
                                    class="capture__work-item @(d.Phase is { } p ? $"al-stage--{(int)p}" : "") @(picked ? "is-picked" : "")"
                                    @onclick="() => Pick(d)">
                                <span class="capture__work-title">@d.Title</span>
                                <span class="capture__work-sub">
                                    @d.StageName
                                    @if (d.CapturesToday > 0)
                                    {
                                        <span class="capture__work-today">· @d.CapturesToday today</span>
                                    }
                                </span>
                            </button>
                        }
                        <button type="button" role="radio" aria-checked="@(deliverableId is null ? "true" : "false")"
                                class="capture__work-item capture__work-item--general @(deliverableId is null ? "is-picked" : "")"
                                @onclick="() => Pick(null)">
                            <span class="capture__work-title">General site</span>
                            <span class="capture__work-sub">@(today?.ActiveStageName ?? "The stage under way")</span>
                        </button>
                    </div>
                    @if (Hidden > 0 && !showAll)
                    {
                        <button type="button" class="al-btn al-btn--link" @onclick="() => showAll = true">Show @Hidden more</button>
                    }
                </ChildContent>
            </StateBlock>
        </section>

        <section class="capture__step" aria-labelledby="cap-frames">
            <h2 class="capture__step-title" id="cap-frames"><span class="capture__n">2</span> Photos</h2>

            <label class="capture__drop">
                <InputFile OnChange="OnFilesSelected" multiple accept="image/*" class="capture__file" />
                <Icon Name="camera" Size="26" />
                <span class="capture__drop-title">@(frames.Count == 0 ? "Add from the camera roll" : "Add more")</span>
                <span class="capture__drop-note">Select the whole set at once — up to @MaxImages.</span>
            </label>

            @if (reading > 0)
            {
                <span class="al-field__hint"><span class="al-spinner"></span> Reading @reading…</span>
            }

            @if (frames.Count > 0)
            {
                <div class="capture__frames">
                    @for (var i = 0; i < frames.Count; i++)
                    {
                        var idx = i;
                        <figure class="capture__frame">
                            <img src="@frames[idx].Preview" alt="@frames[idx].File.Name" />
                            <button type="button" class="capture__frame-remove" @onclick="() => RemoveImage(idx)"
                                    aria-label="Remove @frames[idx].File.Name">
                                <Icon Name="close" Size="14" />
                            </button>
                        </figure>
                    }
                </div>
            }
        </section>

        <div class="capture__more">
            <button type="button" class="capture__more-toggle" aria-expanded="@(moreOpen ? "true" : "false")" @onclick="() => moreOpen = !moreOpen">
                <Icon Name="plus" Size="14" /> A note, a voice note, where it stands
                @if (HasExtras)
                {
                    <span class="al-badge al-badge--accent">added</span>
                }
                <Icon Name="@(moreOpen ? "chevron-up" : "chevron-down")" Size="14" Class="capture__more-caret" />
            </button>

            @if (moreOpen)
            {
            <div class="capture__more-body">
                <div class="al-field">
                    <label class="al-label" for="cap-note">What happened</label>
                    <textarea id="cap-note" class="al-textarea" rows="3" maxlength="2000"
                              placeholder="One line is enough. &quot;Second lift formwork struck, face is clean.&quot;"
                              @bind="description" @bind:event="oninput"></textarea>
                </div>

                <div class="al-field">
                    <span class="al-label">Voice note</span>
                    <VoiceRecorder @bind-Value="voice" />
                    <span class="al-field__hint">Stays in the Site Diary. The words are read into search.</span>
                </div>

                <div class="al-field">
                    <label class="al-label" for="cap-pct">Where the stage stands now</label>
                    <div class="capture__pct">
                        <input id="cap-pct" class="capture__range" type="range" min="0" max="100" step="5"
                               value="@((int)(percent ?? 0))" @oninput="OnPercentChanged" />
                        <span class="capture__pct-value al-num">@(percent is null ? "—" : Fmt.Percent(percent.Value))</span>
                    </div>
                    <span class="al-field__hint">Leave it untouched and no reading is recorded.</span>
                </div>

                @if (ctx.CanExposeToClient)
                {
                    <div class="al-field">
                        <span class="al-label">Who sees this</span>
                        <div class="al-segmented" role="group">
                            <button type="button" class="al-segmented__item @(channel == Channel.Crew ? "is-active" : "")"
                                    aria-selected="@(channel == Channel.Crew)" @onclick="() => channel = Channel.Crew">
                                <Icon Name="eye-off" Size="14" /> Site Diary only
                            </button>
                            <button type="button" class="al-segmented__item @(channel == Channel.Client ? "is-active" : "")"
                                    aria-selected="@(channel == Channel.Client)" @onclick="() => channel = Channel.Client">
                                <Icon Name="eye" Size="14" /> Also to the client
                            </button>
                        </div>
                        <span class="al-field__hint">
                            Site Diary is the default. Tonight's brief takes a few frames from each piece of work
                            at @CutoffLabel unless you drop them — <a href="/project/@ProjectId/log/curate">review tonight's brief</a>.
                        </span>
                    </div>
                }

                <div class="al-check-wrap">
                    <label class="al-check">
                        <input type="checkbox" @bind="hasIssues" />
                        <span><strong>Something is wrong here.</strong> Marks the entry so it surfaces on the stage.</span>
                    </label>
                </div>
            </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="al-alert al-alert--error" role="alert">
                <Icon Name="error" Size="18" />
                <span>@errorMessage</span>
            </div>
        }

        <div class="capture__actions">
            <button type="button" class="al-btn al-btn--primary al-btn--lg capture__post"
                    disabled="@(saving || !CanSubmit)" @onclick="SubmitAsync">
                @if (saving)
                {
                    <span class="al-spinner"></span><span>Posting…</span>
                }
                else
                {
                    <Icon Name="send" Size="16" /><span>@PostLabel</span>
                }
            </button>
        </div>
    </div>
</ProjectPage>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    /// <summary>Preselects the deliverable or stage when arriving from one.</summary>
    [SupplyParameterFromQuery] public string? deliverable { get; set; }
    [SupplyParameterFromQuery] public string? stageId { get; set; }

    private const int MaxImages = 24;
    private const int FirstShown = 6;
    private const long MaxBytesPerImage = 12 * 1024 * 1024;
    private const string CutoffLabel = "20:00";

    private sealed record Frame(CaptureDraftFile File, string Preview);

    private CaptureTodayDto? today;
    private LoadPhase todayPhase = LoadPhase.Loading;
    private string? deliverableId;
    private bool showAll;
    private readonly List<Frame> frames = new();
    private int reading;
    private bool moreOpen;
    private string? description;
    private decimal? percent;
    private CaptureDraftFile? voice;
    private bool hasIssues;
    private Channel channel = Channel.Crew;
    private bool saving;
    private string? errorMessage;
    private string? justPosted;
    private string? loadedId;

    private List<CaptureDeliverableDto> All => today?.Deliverables ?? new();
    private List<CaptureDeliverableDto> Shown =>
        showAll ? All : All.Take(FirstShown).Concat(All.Skip(FirstShown).Where(d => d.Id == deliverableId)).ToList();
    private int Hidden => Math.Max(0, All.Count - Shown.Count);

    private bool HasExtras => !string.IsNullOrWhiteSpace(description) || voice is not null || percent is not null || hasIssues;
    private bool CanSubmit => frames.Count > 0 || voice is not null || !string.IsNullOrWhiteSpace(description);

    private string Target => All.FirstOrDefault(d => d.Id == deliverableId)?.Title ?? today?.ActiveStageName ?? "the site";
    private string PostLabel => frames.Count switch
    {
        0 => $"Post to {Target}",
        1 => $"Post 1 photo to {Target}",
        var n => $"Post {n} photos to {Target}"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == ProjectId) return;
        loadedId = ProjectId;
        await LoadTodayAsync();
    }

    private async Task LoadTodayAsync()
    {
        todayPhase = LoadPhase.Loading;
        StateHasChanged();
        try
        {
            var response = await _progressApi.GetCaptureToday(ProjectId);
            if (!response.IsSuccessStatusCode || response.Content is null)
            {
                todayPhase = LoadPhase.Error;
                return;
            }
            today = response.Content;
            deliverableId = deliverable is not null && All.Any(d => d.Id == deliverable)
                ? deliverable
                // One piece of work under way is not a choice; pick it.
                : All.Count(d => d.Status == DeliverableStatus.InProgress) == 1
                    ? All.First(d => d.Status == DeliverableStatus.InProgress).Id
                    : null;
            todayPhase = All.Count == 0 ? LoadPhase.Empty : LoadPhase.Ready;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load today's work on {ProjectId}", ProjectId);
            todayPhase = LoadPhase.Error;
        }
    }

    private void Pick(CaptureDeliverableDto? d)
    {
        deliverableId = d?.Id;
        justPosted = null;
    }

    private void OnPercentChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
            percent = value;
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        justPosted = null;
        var remaining = MaxImages - frames.Count;
        if (remaining <= 0)
        {
            ToastService.ShowWarning($"That's the maximum of {MaxImages} photos in one capture.");
            return;
        }

        var files = e.GetMultipleFiles(Math.Min(e.FileCount, remaining));
        reading = files.Count;
        StateHasChanged();
        foreach (var file in files)
        {
            try
            {
                // Resized on the phone: eighteen 6 MB photographs is a failed post on
                // one bar of signal, and the brief never shows them larger than this.
                var resized = await file.RequestImageFileAsync("image/jpeg", 1600, 1600);
                using var stream = new MemoryStream();
                await resized.OpenReadStream(MaxBytesPerImage).CopyToAsync(stream);
                var bytes = stream.ToArray();
                var name = Path.ChangeExtension(file.Name, ".jpg");
                frames.Add(new Frame(new CaptureDraftFile(name, "image/jpeg", bytes),
                    $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}"));
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Could not read {FileName}", file.Name);
                ToastService.ShowError($"Could not read {file.Name}.");
            }
            reading--;
            StateHasChanged();
        }
    }

    private void RemoveImage(int index) => frames.RemoveAt(index);

    private async Task SubmitAsync()
    {
        if (saving || !CanSubmit) return;
        saving = true;
        errorMessage = null;
        StateHasChanged();

        var draft = new CaptureDraft
        {
            ProjectId = ProjectId,
            DeliverableId = deliverableId,
            StageId = deliverableId is null ? stageId : null,
            Label = Target,
            Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(),
            CompletionPercentage = percent,
            HasIssues = hasIssues,
            Channel = channel,
            CapturedAt = DateTime.UtcNow,
            Voice = voice
        };
        draft.Files.AddRange(frames.Select(f => f.File));
        var count = frames.Count;

        try
        {
            var sent = await Outbox.EnqueueAsync(draft);
            justPosted = sent
                ? $"Posted {(count == 1 ? "1 photo" : $"{count} photos")} to {draft.Label}."
                : $"Saved on this phone — {(count == 1 ? "1 photo" : $"{count} photos")} for {draft.Label} will send when there is signal.";

            frames.Clear();
            description = null;
            percent = null;
            voice = null;
            hasIssues = false;
            channel = Channel.Crew;
            moreOpen = false;
            if (sent) await LoadTodayAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not post capture on {ProjectId}", ProjectId);
            errorMessage = $"Could not post that capture. {ex.Message}";
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }
}
