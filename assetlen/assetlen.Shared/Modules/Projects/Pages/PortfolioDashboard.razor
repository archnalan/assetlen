@page "/portfolio"
@using assetlen.Shared.Models.Models.RemoteSite
@using assetlen.Shared.Models.Models.ViewModels.RemoteSiteDtos
@layout ProjectsLayout
@attribute [Authorize]
@inject NavigationManager Nav
@inject ILogger<PortfolioDashboard> Logger

<PageTitle>Portfolio — ASSETLEN</PageTitle>

@if (isLoading)
{
    <!-- Skeleton Loaders -->
    <div class="project-page-header">
        <div>
            <div class="project-skeleton project-skeleton-line" style="width:200px;height:28px;"></div>
            <div class="project-skeleton project-skeleton-line short" style="margin-top:8px;"></div>
        </div>
    </div>
    <div class="project-summary-row">
        @for (int i = 0; i < 4; i++)
        {
            <div class="project-skeleton project-skeleton-stat"></div>
        }
    </div>
    <div class="project-projects-grid">
        @for (int i = 0; i < 3; i++)
        {
            <div class="project-skeleton project-skeleton-card"></div>
        }
    </div>
}
else if (portfolio == null)
{
    <div class="project-empty">
        <svg class="project-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 21h18M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7H3l2-4h14l2 4"/>
        </svg>
        <h3 class="project-empty-title">Something went wrong</h3>
        <p class="project-empty-desc">Unable to load your portfolio. Please try again.</p>
        <button class="project-btn project-btn-primary" @onclick="LoadDashboard">Retry</button>
    </div>
}
else
{
    <!-- Page Header -->
    <div class="project-page-header">
        <div>
            <h1 class="project-page-title">Portfolio</h1>
            <p class="project-page-subtitle">Your project portfolio</p>
        </div>
        <a href="/project/create" class="project-btn project-btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New Project
        </a>
    </div>

    <!-- Summary Stats -->
    <div class="project-summary-row">
        <div class="project-stat-card">
            <div class="project-stat-label">Total Budget</div>
            <div class="project-stat-value">@FormatCurrency(portfolio.TotalCapitalDeployed)</div>
        </div>
        <div class="project-stat-card">
            <div class="project-stat-label">Active Projects</div>
            <div class="project-stat-value">@portfolio.ActiveProjectsCount</div>
        </div>
        <div class="project-stat-card">
            <div class="project-stat-label">At Risk</div>
            <div class="project-stat-value @(portfolio.ProjectsAtRiskCount > 0 ? "red" : "green")">@portfolio.ProjectsAtRiskCount</div>
        </div>
        <div class="project-stat-card">
            <div class="project-stat-label">Portfolio Progress</div>
            <div class="project-stat-value">@portfolio.TotalPortfolioCompletion%</div>
        </div>
    </div>

    @if (portfolio.Projects.Count == 0)
    {
        <!-- Empty State -->
        <div class="project-empty">
            <svg class="project-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
            </svg>
            <h3 class="project-empty-title">No projects yet</h3>
            <p class="project-empty-desc">Create your first construction project to start tracking capital and progress.</p>
            <a href="/project/create" class="project-btn project-btn-primary">Create First Project</a>
        </div>
    }
    else
    {
        <!-- Project Cards Grid -->
        <div class="project-projects-grid">
            @foreach (var project in portfolio.Projects)
            {
                <div class="project-project-card" @onclick="() => NavigateToProject(project.Id)">
                    <!-- Card Image -->
                    <div class="project-project-card-image">
                        @if (!string.IsNullOrEmpty(project.LatestImageUrl))
                        {
                            <img src="@project.LatestImageUrl" alt="@project.ProjectName" loading="lazy" />
                        }
                        else
                        {
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4">
                                <path d="M3 21h18M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7H3l2-4h14l2 4M5 21V10.87M19 21V10.87"/>
                            </svg>
                        }
                    </div>

                    <div class="project-project-card-body">
                        <!-- Title & Risk -->
                        <div class="project-project-card-header">
                            <h3 class="project-project-card-title">@project.ProjectName</h3>
                            <span class="project-risk-badge @project.RiskLevel.ToString().ToLower()">
                                <span class="project-risk-dot @project.RiskLevel.ToString().ToLower()"></span>
                                @project.TimelineStatus
                            </span>
                        </div>

                        <!-- Location -->
                        @if (!string.IsNullOrEmpty(project.Location))
                        {
                            <div class="project-project-card-location">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                @project.Location
                            </div>
                        }

                        <!-- Metrics -->
                        <div class="project-project-card-metrics">
                            <div class="project-metric">
                                <span class="project-metric-label">Funded</span>
                                <span class="project-metric-value">@project.FundedPercentage%</span>
                            </div>
                            <div class="project-metric">
                                <span class="project-metric-label">Completed</span>
                                <span class="project-metric-value">@project.CompletedPercentage%</span>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div class="project-progress-bar">
                            <div class="project-progress-fill @GetProgressColor(project.CompletedPercentage)"
                                 style="width: @(Math.Min(project.CompletedPercentage, 100))%"></div>
                        </div>

                        <!-- Footer -->
                        <div class="project-project-card-footer project-mt-sm">
                            <span class="project-stage-badge">@project.CurrentStageName</span>
                            <span class="project-text-xs project-text-muted">
                                @if (project.LastUpdateDate.HasValue)
                                {
                                    @FormatTimeAgo(project.LastUpdateDate.Value)
                                }
                                else
                                {
                                    <text>No updates</text>
                                }
                            </span>
                        </div>
                    </div>

                    @if (!project.IsSubscriptionActive && project.Status == ProjectStatus.Active)
                    {
                        <div style="background:var(--al-warning-soft);padding:8px 16px;font-size:0.75rem;color:var(--al-warning);text-align:center;font-weight:500;">
                            Upgrade to continue managing this project.
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private PortfolioSummaryDto? portfolio;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await _projectsRSApi.GetPortfolioDashboard();
            if (response.IsSuccessStatusCode && response.Content != null)
            {
                portfolio = response.Content;
            }
            else
            {
                Logger.LogError("Failed to load portfolio: {Error}", _apiResponseHandler.GetApiErrorMessage(response));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading portfolio dashboard");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToProject(string projectId)
    {
        Nav.NavigateTo($"/project/{projectId}");
    }

    private string FormatCurrency(decimal amount)
    {
        if (amount >= 1_000_000_000) return $"{amount / 1_000_000_000:N1}B";
        if (amount >= 1_000_000) return $"{amount / 1_000_000:N1}M";
        if (amount >= 1_000) return $"{amount / 1_000:N1}K";
        return amount.ToString("N0");
    }

    private string FormatTimeAgo(DateTime date)
    {
        var diff = DateTime.UtcNow - date;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return date.ToString("MMM dd");
    }

    private string GetProgressColor(decimal pct) =>
        pct >= 75 ? "green" : pct >= 40 ? "yellow" : "";
}
