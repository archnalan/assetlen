@page "/portfolio"
@using assetlen.Shared.Models.Models.RemoteSite
@using assetlen.Shared.Models.Models.ViewModels.RemoteSiteDtos
@layout ProjectsLayout
@attribute [Authorize]
@inject NavigationManager Nav
@inject ILogger<PortfolioDashboard> Logger

<PageTitle>Portfolio — ASSETLEN</PageTitle>

@if (isLoading)
{
    <div class="project-page-header">
        <div>
            <div class="al-shimmer" style="width:200px;height:28px;border-radius:var(--al-radius-sm);"></div>
            <div class="al-shimmer" style="width:140px;height:14px;border-radius:var(--al-radius-xs);margin-top:8px;"></div>
        </div>
    </div>
    <div class="project-summary-row">
        @for (int i = 0; i < 4; i++)
        {
            <div class="al-shimmer" style="height:88px;border-radius:var(--al-radius);"></div>
        }
    </div>
    <div class="project-projects-grid">
        @for (int i = 0; i < 3; i++)
        {
            <div class="al-shimmer al-ghost-card"></div>
        }
    </div>
}
else if (portfolio == null)
{
    <div class="project-empty">
        <svg class="project-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 21h18M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7H3l2-4h14l2 4"/>
        </svg>
        <h3 class="project-empty-title">Something went wrong</h3>
        <p class="project-empty-desc">Unable to load your portfolio. Please try again.</p>
        <button class="project-btn project-btn-primary" @onclick="LoadDashboard">Retry</button>
    </div>
}
else
{
    <!-- Page Header -->
    <div class="project-page-header">
        <div>
            <h1 class="project-page-title">Portfolio</h1>
            <p class="project-page-subtitle">Your project portfolio</p>
        </div>
        <a href="/project/create" class="project-btn project-btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New Project
        </a>
    </div>

    <!-- Summary Stats -->
    <div class="project-summary-row">
        <div class="project-stat-card">
            <div class="project-stat-label">Total Budget</div>
            <div class="project-stat-value">@FormatCurrency(portfolio.TotalCapitalDeployed)</div>
        </div>
        <div class="project-stat-card">
            <div class="project-stat-label">Active Projects</div>
            <div class="project-stat-value">@portfolio.ActiveProjectsCount</div>
        </div>
        <div class="project-stat-card">
            <div class="project-stat-label">At Risk</div>
            <div class="project-stat-value @(portfolio.ProjectsAtRiskCount > 0 ? "red" : "green")">@portfolio.ProjectsAtRiskCount</div>
        </div>
        <div class="project-stat-card">
            <div class="project-stat-label">Portfolio Progress</div>
            <div class="project-stat-value">@portfolio.TotalPortfolioCompletion%</div>
        </div>
    </div>

    @if (portfolio.Projects.Count == 0)
    {
        <!-- Empty State -->
        <div class="project-empty">
            <svg class="project-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
            </svg>
            <h3 class="project-empty-title">No projects yet</h3>
            <p class="project-empty-desc">Create your first construction project to start tracking capital and progress.</p>
            <a href="/project/create" class="project-btn project-btn-primary">Create First Project</a>
        </div>
    }
    else
    {
        <!-- Project Cards Grid -->
        <div class="project-projects-grid">
            @foreach (var project in portfolio.Projects)
            {
                <ProjectCard Project="project" />
            }
        </div>
    }
}

@code {
    private PortfolioSummaryDto? portfolio;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await _projectsRSApi.GetPortfolioDashboard();
            if (response.IsSuccessStatusCode && response.Content != null)
            {
                portfolio = response.Content;
            }
            else
            {
                Logger.LogError("Failed to load portfolio: {Error}", _apiResponseHandler.GetApiErrorMessage(response));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading portfolio dashboard");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string FormatCurrency(decimal amount)
    {
        if (amount >= 1_000_000_000) return $"{amount / 1_000_000_000:N1}B";
        if (amount >= 1_000_000) return $"{amount / 1_000_000:N1}M";
        if (amount >= 1_000) return $"{amount / 1_000:N1}K";
        return amount.ToString("N0");
    }
}
