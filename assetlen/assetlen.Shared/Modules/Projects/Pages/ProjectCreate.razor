@page "/project/create"
@attribute [Authorize]
@inject NavigationManager Nav
@inject ShellState Shell
@inject ILogger<ProjectCreate> Logger

@*
    Create a project.

    Two decisions on this form are load-bearing and the copy says so out loud,
    because getting either wrong is expensive later:

      · **Top-level or sub-project.** The billable unit is the top-level
        project. A guest wing enlarges the parent's area rather than becoming a
        second invoice, and a second building entered as its own project bills
        twice for one engagement. Nesting is one level only.

      · **Floor area.** It is what the bill is computed from. An undeclared
        project bills at the lowest band — we never guess upward.

    Stages can be added later, but the form offers a starting set because a
    project with no stages has nowhere to hang anything, and "nothing floats" is
    the whole capture model.
*@

<PageTitle>New project — ASSETLEN</PageTitle>

<div class="al-page al-page--reading">

    <TitleBlock Eyebrow="New" Title="Create a project"
                Subtitle="The project belongs to your account. Whoever builds it is invited in, and can be replaced without the record moving.">
        <Actions>
            <a class="al-btn al-btn--quiet" href="/">Cancel</a>
        </Actions>
    </TitleBlock>

    <div class="create">

        @* ── What kind ─────────────────────────────────────────────────── *@
        <section class="create__section">
            <div class="al-rule"><span class="al-label">What this is</span></div>

            <div class="create__choice">
                <label class="create__option @(parentId is null ? "is-active" : "")">
                    <input type="radio" name="kind" checked="@(parentId is null)"
                           @onchange="() => parentId = null" />
                    <span>
                        <strong>A project of its own</strong>
                        <span>A building or development you fund and bill separately.</span>
                    </span>
                </label>

                <label class="create__option @(parentId is not null ? "is-active" : "")"
                       aria-disabled="@(Shell.Roots.Count == 0)">
                    <input type="radio" name="kind" disabled="@(Shell.Roots.Count == 0)"
                           checked="@(parentId is not null)"
                           @onchange="SelectFirstParent" />
                    <span>
                        <strong>Part of an existing project</strong>
                        <span>
                            A guest wing, an annexe, external works on the same plot. It enlarges the
                            parent's area rather than becoming a second bill.
                        </span>
                    </span>
                </label>
            </div>

            @if (parentId is not null)
            {
                <div class="al-field">
                    <label class="al-label" for="create-parent">Part of</label>
                    <select id="create-parent" class="al-select" @bind="parentId">
                        @foreach (var root in Shell.Roots)
                        {
                            <option value="@root.Id">@root.Name</option>
                        }
                    </select>
                    <span class="al-field__hint">Nesting is one level deep. A sub-project cannot itself have sub-projects.</span>
                </div>
            }
        </section>

        @* ── Identity ──────────────────────────────────────────────────── *@
        <section class="create__section">
            <div class="al-rule"><span class="al-label">Identity</span></div>

            <div class="al-field">
                <label class="al-label" for="create-name">Name</label>
                <input id="create-name" class="al-input" maxlength="200"
                       placeholder="e.g. Kira Residence"
                       @bind="model.ProjectName" @bind:event="oninput" />
                <span class="al-field__hint">This is what appears in every breadcrumb. Use the name people already say.</span>
            </div>

            <div class="create__row">
                <div class="al-field">
                    <label class="al-label" for="create-location">Where</label>
                    <input id="create-location" class="al-input" maxlength="300"
                           placeholder="e.g. Kira, Wakiso"
                           @bind="model.Location" @bind:event="oninput" />
                </div>

                <div class="al-field">
                    <label class="al-label" for="create-currency">Currency</label>
                    <select id="create-currency" class="al-select" @bind="model.Currency">
                        @foreach (var ccy in Currencies)
                        {
                            <option value="@ccy">@ccy</option>
                        }
                    </select>
                </div>
            </div>

            <div class="al-field">
                <label class="al-label" for="create-desc">What is being built</label>
                <textarea id="create-desc" class="al-textarea" rows="2" maxlength="1000"
                          placeholder="A sentence. It is the thing you will read in six months to remember the scope you agreed."
                          @bind="model.Description" @bind:event="oninput"></textarea>
            </div>
        </section>

        @* ── Money and dates ───────────────────────────────────────────── *@
        <section class="create__section">
            <div class="al-rule"><span class="al-label">Money and dates</span></div>

            <div class="create__row">
                <div class="al-field">
                    <label class="al-label" for="create-budget">Budget (@model.Currency)</label>
                    <input id="create-budget" class="al-input al-input--money" type="number" min="0" step="1000"
                           @bind="budget" @bind:event="oninput" />
                    @if (budget > 0)
                    {
                        <span class="al-field__hint">@Fmt.Money(budget, model.Currency)</span>
                    }
                </div>

                <div class="al-field">
                    <label class="al-label" for="create-area">Floor area (m²)</label>
                    <input id="create-area" class="al-input al-input--money" type="number" min="0" step="1"
                           @bind="areaSqm" @bind:event="oninput" />
                    <span class="al-field__hint">
                        @if (areaSqm > 0)
                        {
                            <text>Bills at <strong>@TierFor(areaSqm)</strong> — @BandFor(areaSqm).</text>
                        }
                        else
                        {
                            <text>Leave blank and it bills at the lowest band. We never guess upward.</text>
                        }
                    </span>
                </div>
            </div>

            <div class="create__row">
                <div class="al-field">
                    <label class="al-label" for="create-start">Expected start</label>
                    <input id="create-start" class="al-input" type="date" @bind="startDate" />
                </div>

                <div class="al-field">
                    <label class="al-label" for="create-end">Expected completion</label>
                    <input id="create-end" class="al-input" type="date" @bind="endDate" />
                </div>
            </div>
        </section>

        @* ── Stages ────────────────────────────────────────────────────── *@
        <section class="create__section">
            <div class="al-rule">
                <span class="al-label">Stages</span>
                <button type="button" class="al-btn al-btn--link" @onclick="AddStage">Add a stage</button>
            </div>

            <p class="create__note">
                A stage is what gets funded up front and what everything else hangs off. You can change
                them later — but a project with none has nowhere to attach a photograph or a receipt.
            </p>

            @if (stages.Count == 0)
            {
                <div class="al-empty">
                    <Icon Name="stage" Size="34" Class="al-empty__icon" Weight="1.25" />
                    <h3 class="al-empty__title">No stages yet</h3>
                    <p class="al-empty__body">Start from a typical residential sequence, or add your own.</p>
                    <button type="button" class="al-btn al-btn--default" @onclick="UseTypicalStages">
                        Use a typical sequence
                    </button>
                </div>
            }
            else
            {
                <div class="al-sheet">
                    <div class="al-register">
                        @for (var i = 0; i < stages.Count; i++)
                        {
                            var index = i;
                            var stage = stages[index];
                            <div class="al-register__row create__stage">
                                <span class="al-register__index">@((index + 1).ToString("D2"))</span>
                                <span class="al-register__main">
                                    <input class="al-input create__stage-name" maxlength="200"
                                           placeholder="Stage name"
                                           @bind="stage.StageName" @bind:event="oninput" />
                                </span>
                                <span class="al-register__end create__stage-end">
                                    <input class="al-input al-input--money create__stage-amount" type="number" min="0" step="1000"
                                           placeholder="0"
                                           @bind="stage.BudgetAmount" @bind:event="oninput" />
                                    <button type="button" class="al-iconbtn al-iconbtn--sm"
                                            @onclick="() => stages.RemoveAt(index)" aria-label="Remove stage">
                                        <Icon Name="trash" Size="15" />
                                    </button>
                                </span>
                            </div>
                        }
                    </div>
                    <div class="al-sheet__foot">
                        Stage budgets total @Fmt.Money(stages.Sum(s => s.BudgetAmount ?? 0), model.Currency).
                        @if (budget > 0 && stages.Sum(s => s.BudgetAmount ?? 0) > budget)
                        {
                            <strong> That is more than the project budget.</strong>
                        }
                    </div>
                </div>
            }
        </section>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="al-alert al-alert--error" role="alert">
                <Icon Name="error" Size="18" />
                <span>@errorMessage</span>
            </div>
        }

        <div class="create__actions">
            <a class="al-btn al-btn--quiet" href="/">Cancel</a>
            <button type="button" class="al-btn al-btn--primary al-btn--lg"
                    disabled="@(saving || string.IsNullOrWhiteSpace(model.ProjectName))" @onclick="SubmitAsync">
                @if (saving)
                {
                    <span class="al-spinner"></span><span>Creating…</span>
                }
                else
                {
                    <span>Create project</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    private static readonly string[] Currencies = ["UGX", "USD", "EUR", "GBP", "KES", "TZS"];

    private readonly ProjectCreateDto model = new() { Currency = "UGX" };
    private readonly List<StageCreateDto> stages = new();

    private string? parentId;
    private decimal budget;
    private decimal areaSqm;
    private DateTime? startDate = DateTime.Now.Date;
    private DateTime? endDate;
    private bool saving;
    private string? errorMessage;

    /// <summary>Preselected when the reader arrived from a project's "Add a sub-project".</summary>
    [SupplyParameterFromQuery(Name = "parent")]
    public string? ParentFromQuery { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(ParentFromQuery) || parentId is not null) return;

        // One level only: if the reader asked to nest under a wing, nest under
        // the house instead rather than refusing.
        var target = Shell.Find(ParentFromQuery);
        parentId = target?.ParentId ?? target?.Id ?? ParentFromQuery;
    }

    private void SelectFirstParent()
        => parentId = Shell.Roots.FirstOrDefault()?.Id;

    private void AddStage()
        => stages.Add(new StageCreateDto { DisplayOrder = stages.Count + 1 });

    /// <summary>
    /// The sequence the evidence thread actually ran, offered as a starting
    /// point. Notice that the retaining wall, doors and windows and external
    /// works are stages here — that is the correction this build exists for.
    /// </summary>
    private void UseTypicalStages()
    {
        stages.Clear();
        string[] typical =
        [
            "Approvals & drawings", "Substructure", "Superstructure", "Roofing",
            "Doors & windows", "Plastering & screed", "Finishes", "External works"
        ];

        for (var i = 0; i < typical.Length; i++)
            stages.Add(new StageCreateDto { StageName = typical[i], DisplayOrder = i + 1 });
    }

    private static string TierFor(decimal area)
        => ProjectSizingPolicy.TierFor(area).ToString();

    private static string BandFor(decimal area)
        => ProjectSizingPolicy.DescribeBand(ProjectSizingPolicy.TierFor(area));

    private async Task SubmitAsync()
    {
        if (saving || string.IsNullOrWhiteSpace(model.ProjectName)) return;

        saving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            model.ParentProjectId = parentId;
            model.TotalBudget = budget > 0 ? budget : null;
            model.ExpectedStartDate = startDate is null ? null : DateTime.SpecifyKind(startDate.Value, DateTimeKind.Utc);
            model.ExpectedCompletionDate = endDate is null ? null : DateTime.SpecifyKind(endDate.Value, DateTimeKind.Utc);

            model.Stages.Clear();
            for (var i = 0; i < stages.Count; i++)
            {
                if (string.IsNullOrWhiteSpace(stages[i].StageName)) continue;
                stages[i].DisplayOrder = i + 1;
                model.Stages.Add(stages[i]);
            }

            var response = await _projectsRSApi.CreateProject(model);

            if (!response.IsSuccessStatusCode || response.Content is null)
            {
                errorMessage = _apiResponseHandler.GetApiErrorMessage(response) ?? "Could not create that project.";
                return;
            }

            var created = response.Content;

            // Area is a separate call because it is what the bill is computed
            // from and the sizing service owns the tier decision — writing it
            // through create would let a create payload set a billing band.
            if (areaSqm > 0)
            {
                try
                {
                    await _projectsRSApi.SetProjectArea(new ProjectAreaUpdateDto
                    {
                        ProjectId = created.Id,
                        FloorAreaSqm = areaSqm,
                        Source = ProjectSizeSource.Declared
                    });
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Project created but area was not set on {ProjectId}", created.Id);
                    ToastService.ShowWarning("Project created, but the floor area didn't save. Set it in project settings.");
                }
            }

            // Into the rail and the home screen before the navigation lands —
            // opening a project that is not in the sidebar reads as a failure.
            Shell.AddProject(created);
            Shell.Remember(created.Id, created.ProjectName, created.ParentProjectId);

            ToastService.ShowSuccess($"{created.ProjectName} created.");
            Nav.NavigateTo($"/project/{created.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not create project");
            errorMessage = "Could not create that project. Nothing has been saved.";
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }
}
