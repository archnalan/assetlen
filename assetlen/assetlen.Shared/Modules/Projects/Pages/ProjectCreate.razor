@page "/project/create"
@using assetlen.Shared.Models.Models.RemoteSite
@using assetlen.Shared.Models.Models.ViewModels.RemoteSiteDtos
@using static assetlen.Shared.Components.Navigation.Breadcrumbs
@layout ProjectsLayout
@attribute [Authorize(Roles = $"{UserRoles.Contractor},{UserRoles.Manager}")]
@inject NavigationManager Nav
@inject ILogger<ProjectCreate> Logger

<PageTitle>New Project — ASSETLEN</PageTitle>

<Breadcrumbs Items="BuildBreadcrumbs()" />

<header class="pc-hero">
    <h1 class="pc-hero__title">New project</h1>
    <p class="pc-hero__sub">Set up a development on your portfolio. Define stages and budget — both are editable later.</p>
</header>

<ol class="pc-steps" aria-label="Steps">
    @foreach (var s in stepsMeta)
    {
        var idx = s.Index;
        var state = idx == step ? "is-active" : idx < step ? "is-done" : "";
        <li class="pc-steps__item @state">
            <span class="pc-steps__dot" aria-hidden="true">
                @if (idx < step)
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="5 12 10 17 19 7" />
                    </svg>
                }
                else
                {
                    @idx
                }
            </span>
            <span class="pc-steps__label">@s.Label</span>
        </li>
    }
</ol>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="pc-alert pc-alert--error" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>@errorMessage</span>
    </div>
}

<section class="pc-panel">
    @switch (step)
    {
        case 1: @RenderStep1(); break;
        case 2: @RenderStep2(); break;
        case 3: @RenderStep3(); break;
    }
</section>

@code {
    private ProjectCreateDto model = new()
    {
        Stages = new List<StageCreateDto>(),
        Currency = "UGX"
    };

    private int step = 1;
    private bool isSaving;
    private string? errorMessage;

    private record StepMeta(int Index, string Label);
    private static readonly StepMeta[] stepsMeta =
    {
        new(1, "Details"),
        new(2, "Stages"),
        new(3, "Review")
    };

    private IEnumerable<BreadcrumbItem> BuildBreadcrumbs()
    {
        yield return new BreadcrumbItem("Portfolio", "/portfolio");
        yield return new BreadcrumbItem("New project");
    }

    // ─── STEP 1: Details ────────────────────────────────────────
    private RenderFragment RenderStep1() => __builder =>
    {
        <div class="pc-form">
            <div class="pc-field pc-field--lg">
                <label class="pc-label" for="pc-name">Project name <span class="pc-req">*</span></label>
                <input id="pc-name" class="pc-input" maxlength="200"
                       @bind="model.ProjectName" @bind:event="oninput"
                       placeholder="e.g. Riverstone Heights, Kira" />
                <p class="pc-hint">The name your clients and team will see everywhere.</p>
            </div>

            <div class="pc-field">
                <label class="pc-label" for="pc-location">Location</label>
                <input id="pc-location" class="pc-input" maxlength="300"
                       @bind="model.Location" @bind:event="oninput"
                       placeholder="e.g. Kira, Wakiso District" />
            </div>

            <div class="pc-grid pc-grid--2">
                <div class="pc-field">
                    <label class="pc-label" for="pc-budget">Total budget <span class="pc-req">*</span></label>
                    <input id="pc-budget" class="pc-input al-num" type="number" step="any" min="0"
                           @bind="model.TotalBudget" placeholder="0" />
                </div>
                <div class="pc-field">
                    <label class="pc-label" for="pc-currency">Currency</label>
                    <select id="pc-currency" class="pc-input" @bind="model.Currency">
                        <option value="UGX">UGX</option>
                        <option value="USD">USD</option>
                        <option value="GBP">GBP</option>
                        <option value="EUR">EUR</option>
                        <option value="KES">KES</option>
                    </select>
                </div>
            </div>

            <div class="pc-grid pc-grid--2">
                <div class="pc-field">
                    <label class="pc-label" for="pc-start">Expected start</label>
                    <input id="pc-start" class="pc-input al-num" type="date"
                           @bind="model.ExpectedStartDate" />
                </div>
                <div class="pc-field">
                    <label class="pc-label" for="pc-end">Expected completion</label>
                    <input id="pc-end" class="pc-input al-num" type="date"
                           @bind="model.ExpectedCompletionDate" />
                </div>
            </div>

            <div class="pc-field">
                <label class="pc-label" for="pc-desc">Description</label>
                <textarea id="pc-desc" class="pc-input pc-textarea" rows="3" maxlength="1000"
                          @bind="model.Description" @bind:event="oninput"
                          placeholder="What is this development? Anything the team should know up front."></textarea>
            </div>
        </div>

        <footer class="pc-actions">
            <a href="/portfolio" class="pc-btn pc-btn--ghost">Cancel</a>
            <button class="pc-btn pc-btn--primary" @onclick="GoToStep2" disabled="@(!CanProceedStep1)">
                Next — Stages
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </button>
        </footer>
    };

    private bool CanProceedStep1 =>
        !string.IsNullOrWhiteSpace(model.ProjectName) && model.TotalBudget > 0;

    private void GoToStep2()
    {
        if (!CanProceedStep1) return;
        errorMessage = null;
        if (model.Stages.Count == 0)
        {
            model.Stages = new List<StageCreateDto>
            {
                new() { StageName = "Foundation", DisplayOrder = 1 },
                new() { StageName = "Walling",    DisplayOrder = 2 },
                new() { StageName = "Roofing",    DisplayOrder = 3 },
                new() { StageName = "Finishing",  DisplayOrder = 4 }
            };
        }
        step = 2;
    }

    // ─── STEP 2: Stages ─────────────────────────────────────────
    private RenderFragment RenderStep2() => __builder =>
    {
        var allocated = model.Stages.Sum(s => s.BudgetAmount ?? 0);
        var allocPct = (model.TotalBudget ?? 0) > 0
            ? Math.Min((double)(allocated / model.TotalBudget!.Value) * 100, 100)
            : 0;
        var overBy = allocated - (model.TotalBudget ?? 0);

        <div class="pc-form">
            <div class="pc-budget-meter">
                <div class="pc-budget-meter__row">
                    <span class="pc-budget-meter__label">Allocated to stages</span>
                    <span class="pc-budget-meter__value al-num">
                        @FormatCurrency(allocated) <span class="pc-budget-meter__total">/ @FormatCurrency(model.TotalBudget ?? 0) @model.Currency</span>
                    </span>
                </div>
                <div class="pc-budget-meter__bar">
                    <div class="pc-budget-meter__fill @(overBy > 0 ? "is-over" : "")"
                         style="width:@(allocPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                </div>
                <div class="pc-budget-meter__hint @(overBy > 0 ? "is-warn" : "")">
                    @if (overBy > 0)
                    {
                        <text>Over by @FormatCurrency(overBy) @model.Currency.</text>
                    }
                    else if (overBy < 0)
                    {
                        <text>@FormatCurrency(Math.Abs(overBy)) @model.Currency unallocated.</text>
                    }
                    else
                    {
                        <text>Fully allocated.</text>
                    }
                </div>
            </div>

            @if (model.Stages.Count == 0)
            {
                <div class="pc-empty">
                    <p>No stages yet. Add at least one to continue.</p>
                </div>
            }
            else
            {
                <ul class="pc-stages">
                    @for (int i = 0; i < model.Stages.Count; i++)
                    {
                        var idx = i;
                        var stage = model.Stages[idx];
                        <li class="pc-stage">
                            <span class="pc-stage__num al-num">@(idx + 1)</span>
                            <div class="pc-stage__fields">
                                <input class="pc-input pc-stage__name"
                                       placeholder="Stage name (e.g. Foundation)"
                                       maxlength="200"
                                       @bind="stage.StageName" @bind:event="oninput" />
                                <input class="pc-input pc-stage__amount al-num"
                                       type="number" step="any" min="0"
                                       placeholder="Budget"
                                       @bind="stage.BudgetAmount" />
                            </div>
                            <button type="button" class="pc-stage__remove"
                                    @onclick="() => RemoveStage(idx)"
                                    aria-label="Remove stage @(idx + 1)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                </svg>
                            </button>
                        </li>
                    }
                </ul>
            }

            <button type="button" class="pc-add-stage" @onclick="AddStage">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Add stage
            </button>
        </div>

        <footer class="pc-actions">
            <button class="pc-btn pc-btn--ghost" @onclick="() => step = 1">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Back
            </button>
            <button class="pc-btn pc-btn--primary" @onclick="GoToStep3" disabled="@(!CanProceedStep2)">
                Review
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </button>
        </footer>
    };

    private bool CanProceedStep2 =>
        model.Stages.Count > 0 && model.Stages.All(s => !string.IsNullOrWhiteSpace(s.StageName));

    private void AddStage()
    {
        model.Stages.Add(new StageCreateDto
        {
            StageName = "",
            DisplayOrder = model.Stages.Count + 1
        });
    }

    private void RemoveStage(int idx)
    {
        model.Stages.RemoveAt(idx);
        for (int i = 0; i < model.Stages.Count; i++)
            model.Stages[i].DisplayOrder = i + 1;
    }

    private void GoToStep3()
    {
        if (!CanProceedStep2) return;
        errorMessage = null;
        step = 3;
    }

    // ─── STEP 3: Review ─────────────────────────────────────────
    private RenderFragment RenderStep3() => __builder =>
    {
        var remaining = (model.TotalBudget ?? 0) - model.Stages.Sum(s => s.BudgetAmount ?? 0);

        <div class="pc-review">
            <dl class="pc-review__list">
                <div class="pc-review__row">
                    <dt>Project</dt>
                    <dd>@model.ProjectName</dd>
                </div>
                @if (!string.IsNullOrEmpty(model.Location))
                {
                    <div class="pc-review__row">
                        <dt>Location</dt>
                        <dd>@model.Location</dd>
                    </div>
                }
                <div class="pc-review__row">
                    <dt>Budget</dt>
                    <dd class="al-num"><strong>@FormatCurrency(model.TotalBudget ?? 0)</strong> @model.Currency</dd>
                </div>
                <div class="pc-review__row">
                    <dt>Timeline</dt>
                    <dd class="al-num">
                        @(model.ExpectedStartDate?.ToString("MMM dd, yyyy") ?? "TBD")
                        <span class="pc-review__arrow">→</span>
                        @(model.ExpectedCompletionDate?.ToString("MMM dd, yyyy") ?? "TBD")
                    </dd>
                </div>
                @if (!string.IsNullOrEmpty(model.Description))
                {
                    <div class="pc-review__row pc-review__row--block">
                        <dt>Description</dt>
                        <dd>@model.Description</dd>
                    </div>
                }
            </dl>

            <h3 class="pc-review__heading">Stages <span class="pc-review__count">@model.Stages.Count</span></h3>
            <ol class="pc-review__stages">
                @foreach (var stage in model.Stages)
                {
                    <li class="pc-review__stage">
                        <span class="pc-review__stage-num al-num">@stage.DisplayOrder</span>
                        <span class="pc-review__stage-name">@stage.StageName</span>
                        <span class="pc-review__stage-amount al-num">@FormatCurrency(stage.BudgetAmount ?? 0)</span>
                    </li>
                }
            </ol>

            @if (remaining != 0)
            {
                <div class="pc-alert @(remaining > 0 ? "pc-alert--warn" : "pc-alert--error")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    @if (remaining > 0)
                    {
                        <span>@FormatCurrency(remaining) of the budget is unallocated to stages.</span>
                    }
                    else
                    {
                        <span>Stages exceed budget by @FormatCurrency(Math.Abs(remaining)).</span>
                    }
                </div>
            }
        </div>

        <p class="pc-note">⚡ Your first project is free — no subscription required.</p>

        <footer class="pc-actions">
            <button class="pc-btn pc-btn--ghost" @onclick="() => step = 2" disabled="@isSaving">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Back
            </button>
            <button class="pc-btn pc-btn--primary" @onclick="SubmitProject" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="pc-spinner" aria-hidden="true"></span>
                    <text>Creating…</text>
                }
                else
                {
                    <text>Create project</text>
                }
            </button>
        </footer>
    };

    private async Task SubmitProject()
    {
        if (isSaving) return;
        isSaving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var response = await _projectsRSApi.CreateProject(model);
            if (response.IsSuccessStatusCode && response.Content != null)
            {
                Nav.NavigateTo($"/project/{response.Content.Id}");
            }
            else
            {
                errorMessage = _apiResponseHandler.GetApiErrorMessage(response) ?? "Could not create the project. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating project");
            errorMessage = "Something went wrong on our end. Please try again.";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private static string FormatCurrency(decimal amount)
    {
        var abs = Math.Abs(amount);
        return abs >= 1_000_000_000 ? $"{amount / 1_000_000_000:N1}B"
             : abs >= 1_000_000     ? $"{amount / 1_000_000:N1}M"
             : abs >= 1_000          ? $"{amount / 1_000:N1}K"
             : amount.ToString("N0");
    }
}
