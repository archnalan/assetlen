@page "/project/{ProjectId}"
@using assetlen.Shared.Models.Models.RemoteSite
@using assetlen.Shared.Models.Models.ViewModels.RemoteSiteDtos
@using static assetlen.Shared.Components.Navigation.Breadcrumbs
@layout ProjectsLayout
@attribute [Authorize]
@inject NavigationManager Nav
@inject ILogger<ProjectDetail> Logger

<PageTitle>@(project?.ProjectName ?? "Project") — ASSETLEN</PageTitle>

@if (isLoading)
{
    <div class="project-page-header">
        <div class="project-skeleton project-skeleton-line" style="width:200px;height:28px;"></div>
    </div>
    <div class="project-skeleton project-skeleton-card" style="height:200px;"></div>
}
else if (project == null)
{
    <div class="project-empty">
        <h3 class="project-empty-title">Project not found</h3>
        <p class="project-empty-desc">This project may have been removed or you don't have access.</p>
        <a href="/portfolio" class="project-btn project-btn-primary">Back to Portfolio</a>
    </div>
}
else
{
    <!-- Breadcrumbs (name-based) -->
    <Breadcrumbs Items="BuildBreadcrumbs()" />

    <!-- Header -->
    <div class="project-page-header">
        <div>
            <h1 class="project-page-title">@project.ProjectName</h1>
            @if (!string.IsNullOrEmpty(project.Location))
            {
                <p class="project-page-subtitle" style="display:flex;align-items:center;gap:4px;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    @project.Location
                </p>
            }
        </div>
        <span class="project-risk-badge @(GetRiskClass())">
            <span class="project-risk-dot @(GetRiskClass())"></span>
            @project.Status
        </span>
    </div>

    <!-- Tabs -->
    <div class="project-tabs">
        <button class="project-tab @(activeTab == "overview" ? "active" : "")" @onclick='() => SetTab("overview")'>Overview</button>
        <button class="project-tab @(activeTab == "team" ? "active" : "")" @onclick='() => SetTab("team")'>Team</button>
        <button class="project-tab @(activeTab == "funding" ? "active" : "")" @onclick='() => SetTab("funding")'>Funding</button>
        <button class="project-tab @(activeTab == "progress" ? "active" : "")" @onclick='() => SetTab("progress")'>Site Journal</button>
        <button class="project-tab @(activeTab == "timeline" ? "active" : "")" @onclick='() => SetTab("timeline")'>Timeline</button>
    </div>

    <!-- Tab Content -->
    <div class="project-tab-content">
        @switch (activeTab)
        {
            case "overview":
                @RenderOverview();
                break;
            case "team":
                @RenderTeam();
                break;
            case "funding":
                @RenderFunding();
                break;
            case "progress":
                @RenderProgress();
                break;
            case "timeline":
                @RenderTimeline();
                break;
        }
    </div>
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private ProjectDto? project;
    private ProjectAnalyticsDto? analytics;
    private List<TimelineEntryDto>? timeline;
    private List<FundingEntryDto>? fundingEntries;
    private List<ProgressUpdateDto>? progressUpdates;
    private List<ProjectMemberDto>? members;
    private bool isLoading = true;
    private string activeTab = "overview";
    private bool loadingFunding, loadingProgress, loadingTimeline, loadingMembers;

    protected override async Task OnInitializedAsync()
    {
        await LoadProject();
    }

    private async Task LoadProject()
    {
        isLoading = true;
        try
        {
            var response = await _projectsRSApi.GetProjectById(ProjectId);
            if (response.IsSuccessStatusCode && response.Content != null)
            {
                project = response.Content;

                // Load analytics in parallel
                var analyticsTask = _projectsRSApi.GetProjectAnalytics(ProjectId);
                var analyticsResp = await analyticsTask;
                if (analyticsResp.IsSuccessStatusCode)
                    analytics = analyticsResp.Content;
            }
            else
            {
                Logger.LogError("Failed loading project: {Error}", _apiResponseHandler.GetApiErrorMessage(response));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading project detail");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        switch (tab)
        {
            case "team" when members == null:
                _ = LoadMembers();
                break;
            case "funding" when fundingEntries == null:
                _ = LoadFunding();
                break;
            case "progress" when progressUpdates == null:
                _ = LoadProgress();
                break;
            case "timeline" when timeline == null:
                _ = LoadTimeline();
                break;
        }
    }

    private async Task LoadMembers()
    {
        loadingMembers = true;
        StateHasChanged();
        try
        {
            var resp = await _projectMembersApi.GetMembersByProject(ProjectId);
            if (resp.IsSuccessStatusCode)
                members = resp.Content;
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading members"); }
        finally { loadingMembers = false; StateHasChanged(); }
    }

    private async Task LoadFunding()
    {
        loadingFunding = true;
        StateHasChanged();
        try
        {
            var resp = await _fundingApi.GetFundingByProject(ProjectId);
            if (resp.IsSuccessStatusCode)
                fundingEntries = resp.Content;
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading funding"); }
        finally { loadingFunding = false; StateHasChanged(); }
    }

    private async Task LoadProgress()
    {
        loadingProgress = true;
        StateHasChanged();
        try
        {
            var resp = await _progressApi.GetProgressUpdates(ProjectId, null, 0, 20);
            if (resp.IsSuccessStatusCode)
                progressUpdates = resp.Content?.Data?.ToList();
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading progress"); }
        finally { loadingProgress = false; StateHasChanged(); }
    }

    private async Task LoadTimeline()
    {
        loadingTimeline = true;
        StateHasChanged();
        try
        {
            var resp = await _projectsRSApi.GetProjectTimeline(ProjectId);
            if (resp.IsSuccessStatusCode)
                timeline = resp.Content;
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading timeline"); }
        finally { loadingTimeline = false; StateHasChanged(); }
    }

    // ─── OVERVIEW TAB ───────────────────────────────────────────────
    private RenderFragment RenderOverview() => __builder =>
    {
        <div class="project-summary-row">
            <div class="project-stat-card">
                <div class="project-stat-label">Total Budget</div>
                <div class="project-stat-value">@FormatCurrency(project!.TotalBudget ?? 0)</div>
            </div>
            <div class="project-stat-card">
                <div class="project-stat-label">Funded</div>
                <div class="project-stat-value">@(analytics?.FundingPercentage ?? 0)%</div>
            </div>
            <div class="project-stat-card">
                <div class="project-stat-label">Progress</div>
                <div class="project-stat-value">@(analytics?.CompletionPercentage ?? 0)%</div>
            </div>
            <div class="project-stat-card">
                <div class="project-stat-label">Timeline</div>
                <div class="project-stat-value @(analytics?.TimelineVarianceDays > 0 ? "red" : "green")">
                    @if (analytics?.TimelineVarianceDays > 0) { <text>+@analytics.TimelineVarianceDays d</text> }
                    else if (analytics != null) { <text>@analytics.TimelineVarianceDays d</text> }
                    else { <text>—</text> }
                </div>
            </div>
        </div>

        <!-- Progress Bar -->
        <div class="project-card project-mt-md">
            <div class="project-card-body">
                <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                    <span class="project-text-sm project-text-muted">Overall Progress</span>
                    <span class="project-text-sm" style="font-weight:600;">@(analytics?.CompletionPercentage ?? 0)%</span>
                </div>
                <div class="project-progress-bar" style="height:10px;">
                    <div class="project-progress-fill @GetProgressColor(analytics?.CompletionPercentage ?? 0)"
                         style="width:@(Math.Min(analytics?.CompletionPercentage ?? 0, 100))%"></div>
                </div>
            </div>
        </div>

        <!-- Stages Breakdown -->
        @if (project.Stages?.Any() == true)
        {
            <h3 class="project-section-title project-mt-lg">Stages</h3>
            @foreach (var stage in project.Stages.OrderBy(s => s.DisplayOrder))
            {
                <div class="project-card project-mt-sm">
                    <div class="project-card-body">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <div>
                                <div style="font-weight:600;">@stage.StageName</div>
                                <div class="project-text-xs project-text-muted">Budget: @FormatCurrency(stage.BudgetAmount ?? 0)</div>
                            </div>
                            <span class="project-stage-badge">@stage.CompletionPercentage%</span>
                        </div>
                        <div class="project-progress-bar project-mt-sm">
                            <div class="project-progress-fill @GetProgressColor(stage.CompletionPercentage ?? 0)"
                                 style="width:@(Math.Min(stage.CompletionPercentage ?? 0, 100))%"></div>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- Key Dates -->
        <div class="project-card project-mt-lg">
            <div class="project-card-body">
                <h3 class="project-card-title">Key Dates</h3>
                <div class="project-detail-row">
                    <span class="project-text-muted">Expected Start</span>
                    <span>@(project.ExpectedStartDate?.ToString("MMM dd, yyyy") ?? "—")</span>
                </div>
                <div class="project-detail-row">
                    <span class="project-text-muted">Expected Completion</span>
                    <span>@(project.ExpectedCompletionDate?.ToString("MMM dd, yyyy") ?? "—")</span>
                </div>
                @if (project.RevisedCompletionDate.HasValue)
                {
                    <div class="project-detail-row">
                        <span class="project-text-muted">Revised Completion</span>
                        <span style="color:var(--al-danger);">@project.RevisedCompletionDate.Value.ToString("MMM dd, yyyy")</span>
                    </div>
                }
                <div class="project-detail-row">
                    <span class="project-text-muted">Manager</span>
                    <span>@(project.ProjectManagerName ?? "Not assigned")</span>
                </div>
            </div>
        </div>

        @* Sub-projects panel — only shown on top-level projects (one-level nesting limit) *@
        @if (string.IsNullOrEmpty(project.ParentProjectId))
        {
            <div class="project-subprojects project-mt-lg">
                <div class="project-subprojects__header">
                    <h3 class="project-section-title">Sub-projects</h3>
                    @if (!showAddSubProject)
                    {
                        <button class="project-btn project-btn-primary project-btn-sm"
                                @onclick="() => showAddSubProject = true">
                            + Add Sub-project
                        </button>
                    }
                </div>

                @if (showAddSubProject)
                {
                    <div class="project-subprojects__add-form">
                        <input class="project-input" placeholder="Sub-project name (e.g. Guest Wing)"
                               @bind="newSubProjectName" @bind:event="oninput" />
                        <input class="project-input" placeholder="Location (optional)"
                               @bind="newSubProjectLocation" @bind:event="oninput" />
                        <textarea class="project-input" rows="2" placeholder="Brief description (optional)"
                                  @bind="newSubProjectDesc" @bind:event="oninput"></textarea>
                        @if (!string.IsNullOrEmpty(subProjectError))
                        {
                            <div class="project-form-error">@subProjectError</div>
                        }
                        <div class="project-subprojects__add-actions">
                            <button class="project-btn project-btn-link" @onclick="CancelAddSubProject" disabled="@savingSubProject">
                                Cancel
                            </button>
                            <button class="project-btn project-btn-primary" @onclick="SaveSubProject"
                                    disabled="@(savingSubProject || string.IsNullOrWhiteSpace(newSubProjectName))">
                                @(savingSubProject ? "Saving…" : "Save Sub-project")
                            </button>
                        </div>
                    </div>
                }

                @if (project.SubProjects.Count == 0 && !showAddSubProject)
                {
                    <p class="project-text-sm project-text-muted">No sub-projects yet. Use the button above to break this project into wings or phases.</p>
                }
                else if (project.SubProjects.Count > 0)
                {
                    <div class="project-subprojects__grid">
                        @foreach (var sub in project.SubProjects)
                        {
                            <a class="project-subprojects__card" href="@($"/project/{sub.Id}")">
                                <div class="project-subprojects__card-name">@sub.ProjectName</div>
                                @if (!string.IsNullOrEmpty(sub.Location))
                                {
                                    <div class="project-text-xs project-text-muted">@sub.Location</div>
                                }
                                <div class="project-text-xs project-text-muted project-mt-xs">
                                    @sub.Status
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        }
    };

    // ─── TEAM TAB ───────────────────────────────────────────────────
    private RenderFragment RenderTeam() => __builder =>
    {
        <div class="project-team__header">
            <h3 class="project-section-title">Team</h3>
            @if (!showAddMember)
            {
                <button class="project-btn project-btn-primary project-btn-sm"
                        @onclick="() => showAddMember = true">
                    + Add Member
                </button>
            }
        </div>

        @if (showAddMember)
        {
            <div class="project-team__add-form">
                <input class="project-input" type="email"
                       placeholder="Member email (must exist in this tenant)"
                       @bind="newMemberEmail" @bind:event="oninput" />
                <select class="project-input" @bind="newMemberSpecialization">
                    @foreach (var spec in Enum.GetValues<ProjectMemberSpecialization>())
                    {
                        <option value="@spec">@spec</option>
                    }
                </select>
                <input class="project-input"
                       placeholder="Title (optional — e.g. 'Day-shift photographer')"
                       @bind="newMemberTitle" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(memberError))
                {
                    <div class="project-form-error">@memberError</div>
                }
                <div class="project-team__add-actions">
                    <button class="project-btn project-btn-link"
                            @onclick="CancelAddMember" disabled="@savingMember">
                        Cancel
                    </button>
                    <button class="project-btn project-btn-primary"
                            @onclick="SaveMember"
                            disabled="@(savingMember || string.IsNullOrWhiteSpace(newMemberEmail))">
                        @(savingMember ? "Adding…" : "Add to project")
                    </button>
                </div>
            </div>
        }

        @if (loadingMembers)
        {
            <div class="project-skeleton project-skeleton-card" style="height:60px;"></div>
            <div class="project-skeleton project-skeleton-card project-mt-sm" style="height:60px;"></div>
        }
        else if (members is null || members.Count == 0)
        {
            <p class="project-text-sm project-text-muted">No members yet. Add one above.</p>
        }
        else
        {
            <ul class="project-team__list">
                @foreach (var m in members)
                {
                    <li class="project-team__row @(m.IsActive ? "" : "is-inactive")">
                        <div class="project-team__avatar">
                            @if (!string.IsNullOrEmpty(m.UserProfilePicUrl))
                            {
                                <img src="@m.UserProfilePicUrl" alt="@m.UserFullName" />
                            }
                            else
                            {
                                <span>@(GetInitials(m.UserFullName))</span>
                            }
                        </div>
                        <div class="project-team__identity">
                            <div class="project-team__name">@(m.UserFullName ?? m.UserEmail)</div>
                            <div class="project-text-xs project-text-muted">@m.UserEmail</div>
                        </div>
                        <div class="project-team__role">
                            <span class="project-team__spec">@m.Specialization</span>
                            @if (!string.IsNullOrEmpty(m.Title))
                            {
                                <div class="project-text-xs project-text-muted">@m.Title</div>
                            }
                        </div>
                        @if (m.IsActive)
                        {
                            <button class="project-btn project-btn-link project-team__remove"
                                    @onclick="() => DeactivateMember(m.Id)"
                                    disabled="@(deactivatingId == m.Id)">
                                @(deactivatingId == m.Id ? "Removing…" : "Remove")
                            </button>
                        }
                        else
                        {
                            <span class="project-text-xs project-text-muted">Removed @(m.LeftAt?.ToString("MMM dd") ?? "")</span>
                        }
                    </li>
                }
            </ul>
        }
    };

    // ─── FUNDING TAB ────────────────────────────────────────────────
    private RenderFragment RenderFunding() => __builder =>
    {
        @if (loadingFunding)
        {
            <div class="project-skeleton project-skeleton-card" style="height:120px;"></div>
            <div class="project-skeleton project-skeleton-card project-mt-sm" style="height:120px;"></div>
        }
        else if (fundingEntries == null || !fundingEntries.Any())
        {
            <div class="project-empty project-mt-md">
                <h3 class="project-empty-title">No funding entries</h3>
                <p class="project-empty-desc">Capital deposits for this project will appear here.</p>
                <button class="project-btn project-btn-primary" @onclick="ShowAddFunding">Record Deposit</button>
            </div>
        }
        else
        {
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <h3 class="project-section-title" style="margin:0;">Deposits</h3>
                <button class="project-btn project-btn-primary project-btn-sm" @onclick="ShowAddFunding">+ Add Deposit</button>
            </div>
            <div class="project-funding-list">
                @foreach (var entry in fundingEntries.OrderByDescending(f => f.PaymentDate))
                {
                    <div class="project-funding-item">
                        <div class="project-funding-header">
                            <div>
                                <div class="project-funding-amount">@FormatCurrency(entry.Amount)</div>
                                <div class="project-text-xs project-text-muted">@(entry.PaymentDate?.ToString("MMM dd, yyyy") ?? "—")</div>
                            </div>
                            <span class="project-funding-status @GetFundingStatusClass(entry.Status)">
                                @entry.Status
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(entry.StageName))
                        {
                            <div class="project-text-xs project-text-muted project-mt-xs">
                                Stage: <span style="font-weight:500;">@entry.StageName</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(entry.Notes))
                        {
                            <div class="project-text-xs project-mt-xs">@entry.Notes</div>
                        }
                        @if (entry.Status == FundingStatus.Confirmed && entry.ConfirmedByName != null)
                        {
                            <div class="project-text-xs project-text-muted project-mt-xs">
                                Confirmed by @entry.ConfirmedByName · @entry.ConfirmationDate?.ToString("MMM dd")
                            </div>
                        }
                    </div>
                }
            </div>
        }
    };

    // ─── PROGRESS TAB ───────────────────────────────────────────────
    private RenderFragment RenderProgress() => __builder =>
    {
        @if (loadingProgress)
        {
            <div class="project-skeleton project-skeleton-card" style="height:150px;"></div>
            <div class="project-skeleton project-skeleton-card project-mt-sm" style="height:150px;"></div>
        }
        else if (progressUpdates == null || !progressUpdates.Any())
        {
            <div class="project-empty project-mt-md">
                <h3 class="project-empty-title">No progress updates</h3>
                <p class="project-empty-desc">Your project manager will post updates with photos here.</p>
            </div>
        }
        else
        {
            <div class="project-progress-feed">
                @foreach (var update in progressUpdates)
                {
                    <div class="project-progress-entry">
                        <div class="project-progress-entry-header">
                            <div class="project-avatar-sm">@(update.CreatedByName?[0])</div>
                            <div>
                                <div style="font-weight:500;">@update.CreatedByName</div>
                                <div class="project-text-xs project-text-muted">
                                    @FormatTimeAgo(update.DateTimeCreated) · @(update.StageName ?? "General")
                                </div>
                            </div>
                            <div class="entry-meta-stack">
                                <span class="entry-channel-pill entry-channel-pill--@(update.Channel.ToString().ToLowerInvariant())">
                                    @update.Channel
                                </span>
                                @if (update.HasIssues)
                                {
                                    <span class="project-risk-badge red">
                                        <span class="project-risk-dot red"></span>Issue
                                    </span>
                                }
                            </div>
                        </div>

                        <p class="project-progress-description">@update.Description</p>

                        @if (update.CompletionPercentage > 0)
                        {
                            <div class="project-progress-bar project-mt-sm" style="height:6px;">
                                <div class="project-progress-fill @GetProgressColor(update.CompletionPercentage ?? 0)"
                                     style="width:@(Math.Min(update.CompletionPercentage ?? 0, 100))%"></div>
                            </div>
                            <div class="project-text-xs project-text-muted project-mt-xs">@update.CompletionPercentage% stage completion</div>
                        }

                        @if (update.Images?.Any() == true)
                        {
                            <EntryPhotoPanel Images="update.Images" />
                        }

                        @if (update.ApprovalStatus.HasValue)
                        {
                            <div class="project-text-xs project-mt-sm" style="color: @(update.ApprovalStatus == ApprovalStatus.Approved ? "var(--al-success)" : "var(--al-warning)");">
                                @(update.ApprovalStatus == ApprovalStatus.Approved ? "✓ Approved" : "⚠ Needs Attention")
                            </div>
                        }

                        <div class="project-progress-entry-footer">
                            <a class="project-progress-entry-link"
                               href="@($"/project/{ProjectId}/entry/{update.Id}")">
                                @if (update.Comments?.Any() == true)
                                {
                                    <span>💬 @update.Comments.Count comment@(update.Comments.Count > 1 ? "s" : "")</span>
                                }
                                else
                                {
                                    <span>Open entry</span>
                                }
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    };

    // ─── TIMELINE TAB ───────────────────────────────────────────────
    private RenderFragment RenderTimeline() => __builder =>
    {
        @if (loadingTimeline)
        {
            <div class="project-skeleton project-skeleton-card" style="height:300px;"></div>
        }
        else if (timeline == null || !timeline.Any())
        {
            <div class="project-empty project-mt-md">
                <h3 class="project-empty-title">No timeline data</h3>
                <p class="project-empty-desc">Project timeline will build as stages progress.</p>
            </div>
        }
        else
        {
            <div class="project-timeline">
                @foreach (var entry in timeline)
                {
                    <div class="project-timeline-item @(entry.IsCompleted ? "completed" : entry.IsCurrent ? "current" : "")">
                        <div class="project-timeline-marker"></div>
                        <div class="project-timeline-content">
                            <div class="project-timeline-title">@entry.Title</div>
                            @if (!string.IsNullOrEmpty(entry.Description))
                            {
                                <div class="project-text-sm project-text-muted">@entry.Description</div>
                            }
                            <div class="project-text-xs project-text-muted project-mt-xs">
                                @entry.Date.ToString("MMM dd, yyyy")
                                @if (!string.IsNullOrEmpty(entry.EventType))
                                {
                                    <span> · @entry.EventType</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    };

    // ─── HELPERS ────────────────────────────────────────────────────
    private bool showAddFunding;

    private void ShowAddFunding() => Nav.NavigateTo($"/project/{ProjectId}/add-funding");

    // Sub-project create state
    private bool showAddSubProject;
    private bool savingSubProject;
    private string newSubProjectName = string.Empty;
    private string newSubProjectLocation = string.Empty;
    private string newSubProjectDesc = string.Empty;
    private string? subProjectError;

    private IEnumerable<BreadcrumbItem> BuildBreadcrumbs()
    {
        yield return new BreadcrumbItem("Portfolio", "/portfolio");
        if (!string.IsNullOrEmpty(project?.ParentProjectId) && !string.IsNullOrEmpty(project.ParentProjectName))
        {
            yield return new BreadcrumbItem(project.ParentProjectName, $"/project/{project.ParentProjectId}");
        }
        yield return new BreadcrumbItem(project?.ProjectName ?? "Project");
    }

    private void CancelAddSubProject()
    {
        showAddSubProject = false;
        newSubProjectName = string.Empty;
        newSubProjectLocation = string.Empty;
        newSubProjectDesc = string.Empty;
        subProjectError = null;
    }

    // Member-add state
    private bool showAddMember;
    private bool savingMember;
    private string newMemberEmail = string.Empty;
    private string newMemberTitle = string.Empty;
    private ProjectMemberSpecialization newMemberSpecialization = ProjectMemberSpecialization.Other;
    private string? memberError;
    private string? deactivatingId;

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private void CancelAddMember()
    {
        showAddMember = false;
        newMemberEmail = string.Empty;
        newMemberTitle = string.Empty;
        newMemberSpecialization = ProjectMemberSpecialization.Other;
        memberError = null;
    }

    private async Task SaveMember()
    {
        if (string.IsNullOrWhiteSpace(newMemberEmail)) return;
        savingMember = true;
        memberError = null;
        StateHasChanged();
        try
        {
            var dto = new ProjectMemberCreateDto
            {
                ProjectId = ProjectId,
                UserEmail = newMemberEmail.Trim(),
                Specialization = newMemberSpecialization,
                Title = string.IsNullOrWhiteSpace(newMemberTitle) ? null : newMemberTitle.Trim()
            };
            var resp = await _projectMembersApi.AddMember(dto);
            if (resp.IsSuccessStatusCode)
            {
                CancelAddMember();
                await LoadMembers();
            }
            else
            {
                memberError = _apiResponseHandler.GetApiErrorMessage(resp) ?? "Could not add member.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding project member");
            memberError = "Could not add member.";
        }
        finally
        {
            savingMember = false;
            StateHasChanged();
        }
    }

    private async Task DeactivateMember(string memberId)
    {
        deactivatingId = memberId;
        StateHasChanged();
        try
        {
            var resp = await _projectMembersApi.DeactivateMember(memberId);
            if (resp.IsSuccessStatusCode) await LoadMembers();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deactivating member {MemberId}", memberId);
        }
        finally
        {
            deactivatingId = null;
            StateHasChanged();
        }
    }

    private async Task SaveSubProject()
    {
        if (string.IsNullOrWhiteSpace(newSubProjectName)) return;
        savingSubProject = true;
        subProjectError = null;
        StateHasChanged();
        try
        {
            var dto = new ProjectCreateDto
            {
                ProjectName = newSubProjectName.Trim(),
                Location = string.IsNullOrWhiteSpace(newSubProjectLocation) ? null : newSubProjectLocation.Trim(),
                Description = string.IsNullOrWhiteSpace(newSubProjectDesc) ? null : newSubProjectDesc.Trim(),
                ParentProjectId = ProjectId,
                Currency = project?.Currency ?? "UGX"
            };
            var resp = await _projectsRSApi.CreateProject(dto);
            if (resp.IsSuccessStatusCode)
            {
                CancelAddSubProject();
                await LoadProject();  // reload to show new sub-project in panel
            }
            else
            {
                subProjectError = _apiResponseHandler.GetApiErrorMessage(resp) ?? "Could not create sub-project.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating sub-project");
            subProjectError = "Could not create sub-project.";
        }
        finally
        {
            savingSubProject = false;
            StateHasChanged();
        }
    }

    private string GetRiskClass()
    {
        if (project == null) return "";
        return project.Status switch
        {
            ProjectStatus.Active => "green",
            ProjectStatus.OnHold => "yellow",
            ProjectStatus.Cancelled => "red",
            ProjectStatus.Completed => "green",
            _ => ""
        };
    }

    private string GetFundingStatusClass(FundingStatus status) => status switch
    {
        FundingStatus.Confirmed => "confirmed",
        FundingStatus.Pending => "pending",
        FundingStatus.Rejected => "rejected",
        _ => ""
    };

    private string FormatCurrency(decimal amount)
    {
        if (amount >= 1_000_000_000) return $"{amount / 1_000_000_000:N1}B";
        if (amount >= 1_000_000) return $"{amount / 1_000_000:N1}M";
        if (amount >= 1_000) return $"{amount / 1_000:N1}K";
        return amount.ToString("N0");
    }

    private string FormatTimeAgo(DateTime? date)
    {
        if (!date.HasValue) return "—";
        var diff = DateTime.UtcNow - date.Value;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return date.Value.ToString("MMM dd");
    }

    private string GetProgressColor(decimal pct) =>
        pct >= 75 ? "green" : pct >= 40 ? "yellow" : "";
}
