@page "/project/{ProjectId}/money"
@attribute [Authorize]
@inject AttentionState Attention
@inject IArtifactDownloadService _downloads
@inject ILogger<ProjectMoney> Logger

@*
    The stage money position.

    This is the screen that exists because of one hour in the evidence thread:
    *"That is confusing me. We need to go step by step. Too many stages combined.
    I want to know if they were cleared or not."* — settled only by meeting in
    person the next morning.

    So the discipline here is: one row per stage, never combined, and four
    columns that always mean the same thing —

        funded    what the developer has released against this stage
        budget    what the stage was priced at
        balance   budget minus funded: what is still to come
        state     whether the release has been acknowledged

    Figures are exact and never abbreviated. A number somebody is reconciling
    against a bank statement must not be rounded to "74M".
*@

<PageTitle>Stages &amp; money — ASSETLEN</PageTitle>

<ProjectPage ProjectId="@ProjectId" Section="money" Eyebrow="Stages &amp; money"
             Subtitle="One row per stage. Nothing combined." Context="ctx">

    @* Only reachable by typing the URL — the tab is not rendered for this seat.
       Say nothing about what is behind it: a seat is defined by what someone was
       invited for, not by a list of what they were kept out of. *@
    @if (!ctx.CanSeeMoney)
    {
        <div class="al-empty">
            <Icon Name="arrow-up-right" Size="40" Class="al-empty__icon" Weight="1.25" />
            <h3 class="al-empty__title">Nothing here for you</h3>
            <p class="al-empty__body">
                Everything you were invited for is on the tabs above.
            </p>
        </div>
    }
    else
    {
        <StateBlock Phase="phase" OnRetry="LoadAsync"
                    ErrorTitle="The money position didn't load"
                    ErrorMessage="@errorMessage"
                    EmptyIcon="money"
                    EmptyTitle="No stages to report on"
                    EmptyBody="Add a stage and the funded-versus-budget position appears here.">
            <ChildContent>

                @* ── The whole-project position ─────────────────────────── *@
                <section>
                    <div class="al-statrow">
                        <div class="al-stat">
                            <span class="al-label">Budget</span>
                            <span class="al-stat__value">@Fmt.Money(TotalBudget, ctx.Currency)</span>
                            <span class="al-stat__note">across @rows.Count stages</span>
                        </div>
                        <div class="al-stat">
                            <span class="al-label">Released</span>
                            <span class="al-stat__value">@Fmt.Money(TotalFunded, ctx.Currency)</span>
                            <span class="al-stat__note">@Fmt.Percent(FundedPercent) of budget</span>
                        </div>
                        <div class="al-stat">
                            <span class="al-label">Still to come</span>
                            <span class="al-stat__value">@Fmt.Money(TotalBudget - TotalFunded, ctx.Currency)</span>
                            <span class="al-stat__note">not yet released</span>
                        </div>
                        <div class="al-stat @(TotalPending > 0 ? "al-stat--warning" : "")">
                            <span class="al-label">Awaiting confirmation</span>
                            <span class="al-stat__value">@Fmt.Money(TotalPending, ctx.Currency)</span>
                            <span class="al-stat__note">
                                @(TotalPending > 0 ? "recorded, not yet acknowledged" : "nothing outstanding")
                            </span>
                        </div>
                    </div>

                    <div class="money__bar">
                        <div class="al-meter al-meter--lg">
                            <span class="al-meter__seg al-meter__seg--cleared"
                                  style="width:@(Pct(TotalConfirmed, TotalBudget))%"></span>
                            <span class="al-meter__seg al-meter__seg--claimed"
                                  style="width:@(Pct(TotalPending, TotalBudget))%"></span>
                        </div>
                        <div class="al-legend">
                            <span class="al-legend__item">
                                <span class="al-legend__swatch money__swatch--cleared"></span> Released and confirmed
                            </span>
                            <span class="al-legend__item">
                                <span class="al-legend__swatch money__swatch--claimed"></span> Released, awaiting confirmation
                            </span>
                            <span class="al-legend__item">
                                <span class="al-legend__swatch money__swatch--rest"></span> Not yet released
                            </span>
                        </div>
                    </div>
                </section>

                @* ── Per stage ──────────────────────────────────────────── *@
                <section>
                    <div class="al-rule">
                        <span class="al-label">Stage by stage</span>
                        @if (ctx.CanManage)
                        {
                            <a class="al-btn al-btn--link" href="/project/@ProjectId/add-funding">Record a release</a>
                        }
                    </div>

                    <div class="al-sheet al-sheet--ticked">
                        <div class="al-table-wrap">
                            <table class="al-table">
                                <thead>
                                    <tr>
                                        <th>Stage</th>
                                        <th class="num">Budget</th>
                                        <th class="num">Released</th>
                                        <th class="num">Balance</th>
                                        <th>State</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in rows)
                                    {
                                        <tr>
                                            <td>
                                                <a class="money__stage" href="/project/@ProjectId/stage/@row.Stage.Id">
                                                    <span class="money__stage-no">@row.Stage.DisplayOrder.ToString("D2")</span>
                                                    <span>
                                                        <span class="money__stage-name">@row.Stage.StageName</span>
                                                        <span class="money__stage-note">@StageStatusLabel(row.Stage)</span>
                                                    </span>
                                                </a>
                                            </td>
                                            <td class="num">@Fmt.Amount(row.Budget)</td>
                                            <td class="num">@Fmt.Amount(row.Funded)</td>
                                            <td class="num @(row.Balance < 0 ? "money__over" : "")">@Fmt.Amount(row.Balance)</td>
                                            <td>
                                                @if (row.Pending > 0)
                                                {
                                                    <span class="al-badge al-badge--warning" title="@Fmt.Money(row.Pending, ctx.Currency) recorded but not acknowledged">
                                                        @Fmt.MoneyShort(row.Pending, null) unconfirmed
                                                    </span>
                                                }
                                                else if (row.Funded <= 0)
                                                {
                                                    <span class="al-badge al-badge--neutral">Not funded</span>
                                                }
                                                else if (row.Balance <= 0)
                                                {
                                                    <span class="al-badge al-badge--success">Fully released</span>
                                                }
                                                else
                                                {
                                                    <span class="al-badge al-badge--accent">Part released</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td>Total</td>
                                        <td class="num">@Fmt.Amount(TotalBudget)</td>
                                        <td class="num">@Fmt.Amount(TotalFunded)</td>
                                        <td class="num">@Fmt.Amount(TotalBudget - TotalFunded)</td>
                                        <td>@ctx.Currency</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </section>

                @* ── Every release, in order ────────────────────────────── *@
                <section>
                    <div class="al-rule"><span class="al-label">Releases</span></div>

                    @if (funding.Count == 0)
                    {
                        <div class="al-empty">
                            <Icon Name="money" Size="40" Class="al-empty__icon" Weight="1.25" />
                            <h3 class="al-empty__title">Nothing released yet</h3>
                            <p class="al-empty__body">
                                Assetlen records that a stage was funded. The transfer itself happens at the bank —
                                we never hold or move money.
                            </p>
                        </div>
                    }
                    else
                    {
                        @* One release, and whichever half of the exchange is this
                           reader's to answer. Saying "yes, all of it" stays one
                           tap — that is the common case, and taxing it is what
                           sends people back to the phone. Naming a different
                           figure is the second button, never the default. *@
                        <div class="al-sheet">
                            <div class="al-register">
                                @foreach (var entry in funding)
                                {
                                    // The server names who may act — being on the money means following
                                    // every release, not moving one. Guessing from CanWrite
                                    // offered a foreman a button that answers 403.
                                    var iConfirm = entry.CanConfirm;
                                    var iAnswerGap = entry.CanSettle;

                                    <div class="al-register__row @(iConfirm || iAnswerGap ? "al-register__row--needs-you" : "")">
                                        <span class="al-register__index">@Fmt.DateShort(entry.PaymentDate)</span>

                                        <span class="al-register__main">
                                            <span class="al-register__title">@(entry.StageName ?? "Project-wide")</span>
                                            <span class="al-register__sub">
                                                @if (!string.IsNullOrEmpty(entry.PaidByName))
                                                {
                                                    <span>from @entry.PaidByName</span>
                                                }
                                                @if (entry.WasConverted)
                                                {
                                                    <span title="Converted when it was recorded">
                                                        @Fmt.Money(entry.DeclaredAmount ?? 0, entry.DeclaredCurrency) sent
                                                    </span>
                                                }
                                                @if (!string.IsNullOrEmpty(entry.Notes))
                                                {
                                                    <span>@entry.Notes</span>
                                                }
                                            </span>

                                            @if (!string.IsNullOrEmpty(entry.EvidenceArtifactId))
                                            {
                                                <button type="button" class="money__evidence"
                                                        @onclick="() => OpenEvidenceAsync(entry)">
                                                    <Icon Name="document" Size="13" />
                                                    <span class="al-truncate">@(entry.EvidenceFileName ?? "Transfer slip")</span>
                                                </button>
                                            }

                                            @if (entry.ReceivedAmount is not null && entry.Shortfall != 0)
                                            {
                                                <span class="money__gap">
                                                    <Icon Name="alert" Size="13" />
                                                    <span>
                                                        @Fmt.Money(entry.SettledAmount, ctx.Currency) arrived —
                                                        @Fmt.Money(Math.Abs(entry.Shortfall), ctx.Currency)
                                                        @(entry.Shortfall > 0 ? "short" : "over").
                                                        @entry.ReceiptNote
                                                    </span>
                                                </span>
                                            }

                                            @if (confirmingGapOn == entry.Id)
                                            {
                                                <div class="money__declare">
                                                    <div class="al-field">
                                                        <label class="al-label" for="got-@entry.Id">What actually landed (@ctx.Currency)</label>
                                                        <input id="got-@entry.Id" class="al-input al-input--money" type="number"
                                                               min="0" step="1000" @bind="receivedAmount" @bind:event="oninput" />
                                                    </div>
                                                    <div class="al-field">
                                                        <label class="al-label" for="why-@entry.Id">Why it differs</label>
                                                        <input id="why-@entry.Id" class="al-input" maxlength="500"
                                                               placeholder="e.g. bank charges on the transfer"
                                                               @bind="receiptNote" @bind:event="oninput" />
                                                    </div>
                                                    <div class="money__declare-actions">
                                                        <button type="button" class="al-btn al-btn--quiet al-btn--sm"
                                                                @onclick="CancelDeclare">Cancel</button>
                                                        <button type="button" class="al-btn al-btn--primary al-btn--sm"
                                                                disabled="@(confirming == entry.Id || receivedAmount < 0)"
                                                                @onclick="() => ConfirmAsync(entry, receivedAmount, receiptNote)">
                                                            Report this figure
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </span>

                                        <span class="al-register__end">
                                            <span class="al-register__amount">@Fmt.Amount(entry.SettledAmount)</span>

                                            @if (entry.Status == FundingStatus.Confirmed)
                                            {
                                                <span class="al-badge al-badge--success" title="Acknowledged @Fmt.Date(entry.ConfirmationDate)">
                                                    <Icon Name="check" Size="11" /> Confirmed
                                                </span>
                                            }
                                            else if (entry.Status == FundingStatus.Settled)
                                            {
                                                <span class="al-badge al-badge--success" title="Accepted @Fmt.Date(entry.SettledAt) at what landed">
                                                    <Icon Name="check" Size="11" /> Settled
                                                </span>
                                            }
                                            else if (entry.Status == FundingStatus.Rejected)
                                            {
                                                <span class="al-badge al-badge--danger">Never arrived</span>
                                            }
                                            else if (iAnswerGap)
                                            {
                                                <button type="button" class="al-btn al-btn--primary al-btn--sm"
                                                        disabled="@(confirming == entry.Id)"
                                                        @onclick="() => SettleAsync(entry)">
                                                    @if (confirming == entry.Id)
                                                    {
                                                        <span class="al-spinner"></span>
                                                    }
                                                    Accept @Fmt.MoneyShort(entry.SettledAmount, null)
                                                </button>
                                            }
                                            else if (entry.HasGap)
                                            {
                                                <span class="al-badge al-badge--warning">
                                                    Waiting on @(entry.PaidByName ?? "the funder")
                                                </span>
                                            }
                                            else if (iConfirm && confirmingGapOn != entry.Id)
                                            {
                                                <span class="money__answer">
                                                    <button type="button" class="al-btn al-btn--primary al-btn--sm"
                                                            disabled="@(confirming == entry.Id)"
                                                            @onclick="() => ConfirmAsync(entry, null, null)">
                                                        @if (confirming == entry.Id)
                                                        {
                                                            <span class="al-spinner"></span>
                                                        }
                                                        Yes, all of it
                                                    </button>
                                                    <button type="button" class="al-btn al-btn--link al-btn--sm"
                                                            @onclick="() => StartDeclare(entry)">
                                                        A different amount
                                                    </button>
                                                </span>
                                            }
                                            else if (entry.Status == FundingStatus.Pending)
                                            {
                                                <span class="al-badge al-badge--warning">Awaiting confirmation</span>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>

                <p class="money__footnote">
                    Assetlen records that a stage was funded and released. It never holds or moves money —
                    the transfer happens at the bank.
                </p>

            </ChildContent>
        </StateBlock>
    }
</ProjectPage>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private List<StageDto> stages = new();
    private List<FundingEntryDto> funding = new();
    private List<StageMoneyRow> rows = new();
    private LoadPhase phase = LoadPhase.Loading;
    private string? errorMessage;
    private string? confirming;
    private string? loadedId;

    // The gap the delivery side is reporting, while they are typing it.
    private string? confirmingGapOn;
    private decimal receivedAmount;
    private string? receiptNote;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == ProjectId) return;
        loadedId = ProjectId;

        // Loaded unconditionally: the server decides who may read this, and the
        // old tenant-role guard here (CanSeeFinancials) was global where the
        // question is per project — it let a foreman through on every project
        // and would have shut a client-side principal out of their own.
        await LoadAsync();
    }

    private void StartDeclare(FundingEntryDto entry)
    {
        confirmingGapOn = entry.Id;
        receivedAmount = entry.Amount;
        receiptNote = null;
    }

    private void CancelDeclare()
    {
        confirmingGapOn = null;
        receiptNote = null;
    }

    /// <summary>
    /// The slip is an artifact, so it cannot go straight in an href — the
    /// browser would send that request without the bearer token. Fetch it and
    /// hand the browser a blob, as every other artifact view here does.
    /// </summary>
    private async Task OpenEvidenceAsync(FundingEntryDto entry)
    {
        if (string.IsNullOrEmpty(entry.EvidenceArtifactId)) return;

        try
        {
            await _downloads.OpenAsync(entry.EvidenceArtifactId, entry.EvidenceFileName ?? "transfer-slip");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not open transfer evidence {ArtifactId}", entry.EvidenceArtifactId);
            ToastService.ShowError("That attachment could not be opened.");
        }
    }

    private async Task LoadAsync()
    {
        phase = LoadPhase.Loading;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var stagesTask = _stagesApi.GetStagesByProjectId(ProjectId);
            var fundingTask = _fundingApi.GetFundingByProject(ProjectId);
            await Task.WhenAll(stagesTask, fundingTask);

            if (!stagesTask.Result.IsSuccessStatusCode)
            {
                phase = LoadPhase.Error;
                errorMessage = _apiResponseHandler.GetApiErrorMessage(stagesTask.Result);
                return;
            }

            stages = (stagesTask.Result.Content ?? new()).OrderBy(s => s.DisplayOrder).ToList();

            funding = (fundingTask.Result.IsSuccessStatusCode ? fundingTask.Result.Content ?? new() : new())
                .OrderByDescending(f => f.PaymentDate ?? DateTime.MinValue)
                .ToList();

            Recompute();
            phase = rows.Count == 0 ? LoadPhase.Empty : LoadPhase.Ready;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Money position failed to load for {ProjectId}", ProjectId);
            phase = LoadPhase.Error;
            errorMessage = ex.Message;
        }
        finally { StateHasChanged(); }
    }

    /// <summary>
    /// Rolls releases up per stage.
    /// <para>
    /// Deliberately computed here from the raw entries rather than trusting
    /// <c>StageDto.FundedAmount</c>: a pending release is money the developer
    /// has sent and the other side has not acknowledged, and the difference
    /// between those two states is the entire point of this screen.
    /// </para>
    /// </summary>
    private void Recompute()
    {
        rows = stages.Select(stage =>
        {
            var forStage = funding.Where(f => f.StageId == stage.Id).ToList();

            // A settled release counts at what landed, not at what was sent —
            // otherwise a stage that lost money in transit reads as funded to a
            // level it never reached.
            var confirmed = forStage
                .Where(f => f.Status is FundingStatus.Confirmed or FundingStatus.Settled)
                .Sum(f => f.SettledAmount);

            // Still unanswered at one end or the other: recorded, not agreed.
            var pending = forStage
                .Where(f => f.Status is FundingStatus.Pending or FundingStatus.AmountQueried)
                .Sum(f => f.SettledAmount);

            return new StageMoneyRow(stage, stage.BudgetAmount ?? 0, confirmed + pending, confirmed, pending);
        }).ToList();
    }

    /// <summary>
    /// The delivery side's answer. <paramref name="received"/> null means the
    /// declared figure arrived in full; a value opens the gap for the funder.
    /// </summary>
    private async Task ConfirmAsync(FundingEntryDto entry, decimal? received, string? why)
    {
        confirming = entry.Id;
        StateHasChanged();

        try
        {
            var response = await _fundingApi.ConfirmFunding(new FundingConfirmDto
            {
                FundingEntryId = entry.Id,
                IsConfirmed = true,
                ReceivedAmount = received,
                Notes = why
            });

            if (response.IsSuccessStatusCode)
            {
                // Drop it from the chrome now, not on the next boot. A count
                // that still says 3 after you have dealt with one teaches the
                // reader the count is decorative.
                Attention.Retire(AttentionKind.Money, entry.Id);
                confirmingGapOn = null;
                receiptNote = null;

                var landed = received ?? entry.Amount;

                ToastService.ShowSuccess(landed == entry.Amount
                    ? $"{Fmt.Money(landed)} confirmed against {entry.StageName ?? "the project"}."
                    : $"{Fmt.Money(landed)} reported. {entry.PaidByName ?? "The funder"} has been asked about the difference.");

                await LoadAsync();
            }
            else
            {
                ToastService.ShowError(_apiResponseHandler.GetApiErrorMessage(response));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not confirm funding {FundingId}", entry.Id);
            ToastService.ShowError("Could not confirm that release.");
        }
        finally
        {
            confirming = null;
            StateHasChanged();
        }
    }

    /// <summary>The funder's answer: accept what landed and close the release at that figure.</summary>
    private async Task SettleAsync(FundingEntryDto entry)
    {
        confirming = entry.Id;
        StateHasChanged();

        try
        {
            var response = await _fundingApi.SettleFunding(new FundingSettleDto { FundingEntryId = entry.Id });

            if (response.IsSuccessStatusCode)
            {
                Attention.Retire(AttentionKind.Money, entry.Id);
                ToastService.ShowSuccess($"Settled at {Fmt.Money(entry.SettledAmount)}. The stage now shows what arrived.");
                await LoadAsync();
            }
            else
            {
                ToastService.ShowError(_apiResponseHandler.GetApiErrorMessage(response));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not settle funding {FundingId}", entry.Id);
            ToastService.ShowError("Could not accept that figure.");
        }
        finally
        {
            confirming = null;
            StateHasChanged();
        }
    }

    private decimal TotalBudget => rows.Sum(r => r.Budget);
    private decimal TotalFunded => rows.Sum(r => r.Funded);
    private decimal TotalConfirmed => rows.Sum(r => r.Confirmed);
    private decimal TotalPending => rows.Sum(r => r.Pending);
    private decimal FundedPercent => TotalBudget <= 0 ? 0 : Math.Round(TotalFunded / TotalBudget * 100, 1);

    private static decimal Pct(decimal part, decimal whole)
        => whole <= 0 ? 0 : Math.Clamp(Math.Round(part / whole * 100, 2), 0, 100);

    private static string StageStatusLabel(StageDto s) => s.Status switch
    {
        StageStatus.Completed => $"Completed {Fmt.DateShort(s.ActualEndDate)}",
        StageStatus.InProgress => $"In progress · {Fmt.Percent(s.CompletionPercentage ?? 0)}",
        _ => "Not started"
    };

    private sealed record StageMoneyRow(
        StageDto Stage, decimal Budget, decimal Funded, decimal Confirmed, decimal Pending)
    {
        public decimal Balance => Budget - Funded;
    }
}
