@page "/project/{ProjectId}/register"
@attribute [Authorize]
@inject AttentionState Attention
@inject NavigationManager Nav
@inject ILogger<ProjectRegister> Logger

@*
    The register — assetlen.md §3, and the page shown to Peter for §11 test 1.

    Everything on it is a Commitment: a spec, a price, a date, a material or a
    choice, carrying who agreed, when, where it was said and the evidence. The
    questions and blockers sit beside it because a flag is one of two things now:
    a commitment in Query raised, or a blocker with a named owner. Accountability
    is the same records grouped by the accountable face.
*@

<PageTitle>Register — ASSETLEN</PageTitle>

<ProjectPage ProjectId="@ProjectId" Section="register" Eyebrow="Register"
             Subtitle="What was agreed, with whom, when — and where each has got to." Context="ctx">

    @if (!ctx.CanSeeRegister)
    {
        <div class="al-empty">
            <Icon Name="arrow-up-right" Size="40" Class="al-empty__icon" Weight="1.25" />
            <h3 class="al-empty__title">Nothing here for you</h3>
            <p class="al-empty__body">Everything you were invited for is on the tabs above.</p>
        </div>
    }
    else
    {
        <div class="register__bar">
            <div class="al-segmented" role="group" aria-label="View">
                @foreach (var v in Views)
                {
                    <button type="button" class="al-segmented__item @(view == v.Key ? "is-active" : "")"
                            aria-selected="@(view == v.Key)" @onclick="() => SetView(v.Key)">
                        <Icon Name="@v.Icon" Size="14" /> @v.Label
                        @if (v.Key == "questions" && OpenFlags > 0)
                        {
                            <span class="al-tabs__count">@OpenFlags</span>
                        }
                        @if (v.Key == "thread" && pendingProposals > 0)
                        {
                            <span class="al-tabs__count">@pendingProposals</span>
                        }
                    </button>
                }
            </div>

            <span class="al-spacer"></span>

            @if (ctx.CanWrite)
            {
                <div class="register__actions">
                    <button type="button" class="al-btn al-btn--primary" @onclick="() => Open(Sheet.Decision)">
                        <Icon Name="phone" Size="16" /> Log a decision
                    </button>
                    <button type="button" class="al-btn al-btn--default" @onclick="() => Open(Sheet.Commitment)">
                        <Icon Name="plus" Size="16" /> Add to the register
                    </button>
                    <button type="button" class="al-btn al-btn--quiet" @onclick="() => Open(Sheet.Question)">
                        <Icon Name="query" Size="16" /> Raise a question
                    </button>
                </div>
            }
        </div>

        @if (sheet != Sheet.None)
        {
            <div class="al-sheet register__raise">
                <div class="al-sheet__head">
                    <h2 class="al-sheet__title">@SheetTitle</h2>
                    <button type="button" class="al-iconbtn" @onclick="() => sheet = Sheet.None" aria-label="Close">
                        <Icon Name="close" Size="18" />
                    </button>
                </div>
                <div class="al-sheet__body">
                    @switch (sheet)
                    {
                        case Sheet.Decision:
                            <CommitmentForm ProjectId="@ProjectId" Decision="true" CanSeeMoney="ctx.CanSeeMoney" Currency="@ctx.Currency"
                                            OnSaved="OnCommitmentSaved" OnCancel="() => sheet = Sheet.None" />
                            break;
                        case Sheet.Commitment:
                            <CommitmentForm ProjectId="@ProjectId" CanSeeMoney="ctx.CanSeeMoney" Currency="@ctx.Currency"
                                            OnSaved="OnCommitmentSaved" OnCancel="() => sheet = Sheet.None" />
                            break;
                        case Sheet.Question:
                            <FlagRaiseForm ProjectId="@ProjectId" OnRaised="OnRaised" OnCancel="() => sheet = Sheet.None" />
                            break;
                    }
                </div>
            </div>
        }

        @switch (view)
        {
            case "questions":
                <StateBlock Phase="flagPhase" OnRetry="LoadFlagsAsync"
                            ErrorTitle="The questions didn't load"
                            ErrorMessage="@flagError"
                            EmptyIcon="query"
                            EmptyTitle="No questions or blockers"
                            EmptyBody="A question raised here keeps its answer attached to the item — so next month it is not the next thing to scroll for.">
                    <ChildContent>
                        <div class="al-segmented register__sub" role="group" aria-label="Filter">
                            @foreach (var f in FlagFilters)
                            {
                                <button type="button" class="al-segmented__item @(flagFilter == f.Key ? "is-active" : "")"
                                        aria-selected="@(flagFilter == f.Key)" @onclick="() => flagFilter = f.Key">
                                    @f.Label
                                    @if (CountFor(f.Key) > 0)
                                    {
                                        <span class="al-tabs__count">@CountFor(f.Key)</span>
                                    }
                                </button>
                            }
                        </div>

                        @if (VisibleFlags.Count == 0)
                        {
                            <div class="al-empty">
                                <Icon Name="check-circle" Size="40" Class="al-empty__icon" Weight="1.25" />
                                <h3 class="al-empty__title">Nothing in this state</h3>
                                <p class="al-empty__body">Try another filter — there are @flags.Count on this project.</p>
                            </div>
                        }
                        else
                        {
                            <div class="al-stack">
                                @foreach (var flag in VisibleFlags)
                                {
                                    <article class="al-sheet register__item" id="@flag.Id">
                                        <div class="register__item-head">
                                            <div class="register__item-lead">
                                                <span class="al-dot @SeverityDot(flag.Severity)"></span>
                                                <div>
                                                    <h3 class="register__item-title">@flag.Title</h3>
                                                    <div class="register__item-sub">
                                                        <span class="al-badge @(flag.IsBlocker ? "al-badge--warning" : "al-badge--outline")">
                                                            <Icon Name="@(flag.IsBlocker ? "blocked" : "query")" Size="11" />
                                                            @(flag.IsBlocker ? "Blocker" : "Query on a commitment")
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(flag.StageName))
                                                        {
                                                            <span>@flag.StageName</span>
                                                        }
                                                        <span>Raised @Fmt.Date(flag.DateTimeCreated) by @AttributedTo(ctx, flag.CreatedByName)</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="register__item-badges">
                                                <span class="al-badge @StateBadge(flag.Status)">@StateLabel(flag.Status)</span>
                                                @if (flag.Channel == Channel.Crew)
                                                {
                                                    <span class="al-badge al-badge--delivery" title="Delivery side only">
                                                        <Icon Name="eye-off" Size="11" /> Internal
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(flag.Description))
                                        {
                                            <p class="register__item-body">@flag.Description</p>
                                        }

                                        @if (flag.CommitmentId is not null)
                                        {
                                            <button type="button" class="register__on" @onclick="() => ShowCommitment(flag.CommitmentId)">
                                                <Icon Name="commitment" Size="13" /> On: @(flag.CommitmentTitle ?? "a commitment")
                                            </button>
                                        }

                                        <div class="al-provenance register__prov">
                                            <span class="al-provenance__step @(flag.Status >= FlagStatus.Open ? "is-done" : "")">Raised</span>
                                            <span class="al-provenance__step @ProvClass(flag, FlagStatus.InProgress)">Being answered</span>
                                            <span class="al-provenance__step @ProvClass(flag, FlagStatus.Resolved)">Resolved</span>
                                        </div>

                                        <footer class="register__item-foot">
                                            <div class="register__item-owner">
                                                @if (flag.IsBlocker && !string.IsNullOrEmpty(flag.OwnerName))
                                                {
                                                    <Icon Name="blocked" Size="14" />
                                                    <span>Waiting on @flag.OwnerName</span>
                                                }
                                                else
                                                {
                                                    <span class="al-avatar al-avatar--sm">@Fmt.Initials(null, null, flag.AssignedToName ?? "?")</span>
                                                    <span>@(IsMine(flag) ? "Yours to answer" : $"With {flag.AssignedToName ?? "the other side"}")</span>
                                                }
                                            </div>

                                            <span class="al-spacer"></span>

                                            @if (flag.DueDate is not null && flag.Status != FlagStatus.Resolved)
                                            {
                                                <span class="al-badge @DueClass(flag.DueDate)">
                                                    <Icon Name="clock" Size="11" />
                                                    @(flag.DueDate!.Value.Date < DateTime.Now.Date ? "Overdue" : $"By {Fmt.DateShort(flag.DueDate)}")
                                                </span>
                                            }

                                            @if (flag.Status != FlagStatus.Resolved && ctx.CanWrite)
                                            {
                                                <button type="button" class="al-btn al-btn--default al-btn--sm"
                                                        disabled="@(resolving == flag.Id)" @onclick="() => ResolveAsync(flag)">
                                                    @if (resolving == flag.Id)
                                                    {
                                                        <span class="al-spinner"></span>
                                                    }
                                                    else
                                                    {
                                                        <Icon Name="check" Size="14" />
                                                    }
                                                    Mark resolved
                                                </button>
                                            }
                                            else if (flag.Status == FlagStatus.Resolved)
                                            {
                                                <span class="al-subtle register__resolved">
                                                    Resolved @Fmt.Date(flag.ResolvedDate)
                                                    @if (!string.IsNullOrEmpty(flag.ResolvedByName))
                                                    {
                                                        <text> by @flag.ResolvedByName</text>
                                                    }
                                                </span>
                                            }
                                        </footer>
                                    </article>
                                }
                            </div>
                        }
                    </ChildContent>
                </StateBlock>
                break;

            case "accountability":
                <AccountabilityPanel ProjectId="@ProjectId" Version="version" />
                break;

            case "thread":
                <ProposalQueue ProjectId="@ProjectId" OnDecided="OnProposalsDecided" OnPendingCount="c => pendingProposals = c" />
                break;

            default:
                @* Extraction fills the register only once someone accepts it; an
                   empty register above 21 waiting items reads as "nothing came in". *@
                @if (pendingProposals > 0)
                {
                    <div class="al-alert al-alert--info register__waiting" role="status">
                        <Icon Name="message" Size="18" />
                        <div>
                            <strong class="al-alert__title">
                                @pendingProposals @(pendingProposals == 1 ? "item" : "items") read from the thread @(pendingProposals == 1 ? "waits" : "wait") for you
                            </strong>
                            <span>Nothing extracted is on the register until you accept it.</span>
                        </div>
                        <button type="button" class="al-btn al-btn--default al-btn--sm register__waiting-go" @onclick='() => SetView("thread")'>Review</button>
                    </div>
                }
                <CommitmentRegister ProjectId="@ProjectId" ReaderSide="ctx.Access?.Side" Version="version" FocusId="@CommitmentParam" />
                break;
        }
    }
</ProjectPage>

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [SupplyParameterFromQuery(Name = "view")] public string? ViewParam { get; set; }
    [SupplyParameterFromQuery(Name = "commitment")] public string? CommitmentParam { get; set; }

    private enum Sheet { None, Decision, Commitment, Question }

    private Sheet sheet;
    private string view = "commitments";
    private int version;

    private List<FlagDto> flags = new();
    private LoadPhase flagPhase = LoadPhase.Loading;
    private string? flagError;
    private string flagFilter = "open";
    private string? resolving;
    private string? loadedId;
    private int pendingProposals;

    private static readonly (string Key, string Label, string Icon)[] Views =
    [
        ("commitments", "Commitments", "commitment"),
        ("questions", "Questions & blockers", "query"),
        ("accountability", "Accountability", "shield"),
        ("thread", "From the thread", "message")
    ];

    private static readonly (string Key, string Label)[] FlagFilters =
    [
        ("mine", "Yours"), ("open", "Open"), ("blockers", "Blockers"), ("resolved", "Resolved"), ("all", "All")
    ];

    private string SheetTitle => sheet switch
    {
        Sheet.Decision => "Log a decision from a call or meeting",
        Sheet.Commitment => "Add to the register",
        _ => "Raise a question"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (ViewParam is "questions" or "accountability" or "commitments" or "thread") view = ViewParam;
        if (!string.IsNullOrEmpty(CommitmentParam)) view = "commitments";
        if (loadedId == ProjectId) return;
        loadedId = ProjectId;
        await LoadFlagsAsync();
        await LoadPendingProposalsAsync();
    }

    private void SetView(string key)
    {
        view = key;
        Nav.NavigateTo($"/project/{ProjectId}/register?view={key}", replace: true);
    }

    private void Open(Sheet s) => sheet = sheet == s ? Sheet.None : s;

    private void ShowCommitment(string id)
    {
        view = "commitments";
        Nav.NavigateTo($"/project/{ProjectId}/register?view=commitments#c-{id}", replace: true);
    }

    private async Task OnCommitmentSaved(CommitmentDto saved)
    {
        sheet = Sheet.None;
        view = "commitments";
        version++;
        ToastService.ShowSuccess(saved.IsAwaitingCounterparty
            ? "Logged. The other side will see it and can confirm it or say that is not what was said."
            : "On the register.");
        await LoadFlagsAsync();
    }

    /// <summary>
    /// Extraction runs on import, unasked, so the count of what is waiting is
    /// worth showing on the tab before anyone opens it (plan.md P5).
    /// </summary>
    private async Task LoadPendingProposalsAsync()
    {
        try
        {
            var resp = await _extractionApi.GetQueue(ProjectId, ProposalStatus.Pending);
            pendingProposals = resp.IsSuccessStatusCode ? resp.Content?.PendingCount ?? 0 : 0;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not count proposals for {ProjectId}", ProjectId);
        }
    }

    private async Task OnProposalsDecided(ProposalDecisionResultDto result)
    {
        // An accepted blocker is a flag and an accepted item is on the register;
        // both lists behind this page have moved.
        version++;
        if (result.FlagIds.Count > 0) await LoadFlagsAsync();
    }

    private async Task OnRaised()
    {
        sheet = Sheet.None;
        view = "questions";
        version++;
        await LoadFlagsAsync();
        ToastService.ShowSuccess("Question raised. It stays on the register until it is answered.");
    }

    private async Task LoadFlagsAsync()
    {
        flagPhase = LoadPhase.Loading;
        flagError = null;
        StateHasChanged();

        try
        {
            var response = await _flagsApi.GetFlagsByProject(ProjectId);
            if (!response.IsSuccessStatusCode || response.Content is null)
            {
                flagPhase = LoadPhase.Error;
                flagError = _apiResponseHandler.GetApiErrorMessage(response);
                return;
            }

            flags = response.Content
                .OrderBy(f => f.Status == FlagStatus.Resolved ? 1 : 0)
                .ThenBy(f => f.DueDate ?? DateTime.MaxValue)
                .ToList();

            if (flags.Any(f => IsMine(f) && f.Status != FlagStatus.Resolved))
                flagFilter = "mine";

            flagPhase = flags.Count == 0 ? LoadPhase.Empty : LoadPhase.Ready;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Questions failed to load for {ProjectId}", ProjectId);
            flagPhase = LoadPhase.Error;
            flagError = ex.Message;
        }
        finally { StateHasChanged(); }
    }

    private async Task ResolveAsync(FlagDto flag)
    {
        resolving = flag.Id;
        StateHasChanged();

        try
        {
            var response = await _flagsApi.ResolveFlag(flag.Id!);
            if (response.IsSuccessStatusCode)
            {
                Attention.Retire(AttentionKind.Decision, flag.Id!);

                // A query on a commitment resolves the commitment too, so the
                // register behind it has moved as well.
                version++;
                await LoadFlagsAsync();
                ToastService.ShowSuccess(flag.IsBlocker ? "Resolved." : "Resolved. The item on the register moved with it.");
            }
            else
            {
                ToastService.ShowError(_apiResponseHandler.GetApiErrorMessage(response));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not resolve {FlagId}", flag.Id);
            ToastService.ShowError("Could not resolve that item.");
        }
        finally
        {
            resolving = null;
            StateHasChanged();
        }
    }

    private int OpenFlags => flags.Count(f => f.Status is FlagStatus.Open or FlagStatus.InProgress);

    private List<FlagDto> VisibleFlags => flags.Where(f => MatchesFlag(f, flagFilter)).ToList();

    private bool MatchesFlag(FlagDto f, string key) => key switch
    {
        "mine" => IsMine(f) && f.Status != FlagStatus.Resolved,
        "open" => f.Status is FlagStatus.Open or FlagStatus.InProgress,
        "blockers" => f.IsBlocker && f.Status is FlagStatus.Open or FlagStatus.InProgress,
        "resolved" => f.Status == FlagStatus.Resolved,
        _ => true
    };

    private int CountFor(string key) => key == "all" ? flags.Count : flags.Count(f => MatchesFlag(f, key));

    private bool IsMine(FlagDto flag) => flag.AssignedToId == _sd.CurrentUser?.Id;

    /// <summary>
    /// One accountable face: a client-side reader sees the mediator's name on
    /// anything that crossed, whoever actually produced it (§10.1).
    /// </summary>
    private static string AttributedTo(ProjectPageContext ctx, string? name)
        => name ?? (ctx.IsClientSide ? "the delivery side" : "someone on this side");

    private static string StateLabel(FlagStatus status) => status switch
    {
        FlagStatus.Open => "Query raised",
        FlagStatus.InProgress => "Being answered",
        FlagStatus.Resolved => "Resolved",
        _ => "Archived"
    };

    private static string StateBadge(FlagStatus status) => status switch
    {
        FlagStatus.Open => "al-badge--accent",
        FlagStatus.InProgress => "al-badge--blueprint",
        FlagStatus.Resolved => "al-badge--success",
        _ => "al-badge--neutral"
    };

    private static string ProvClass(FlagDto flag, FlagStatus step)
        => flag.Status > step ? "is-done" : flag.Status == step ? "is-current" : "";

    private static string SeverityDot(FlagSeverity severity) => severity switch
    {
        FlagSeverity.Critical or FlagSeverity.High => "al-dot--danger",
        FlagSeverity.Medium => "al-dot--warning",
        _ => ""
    };

    private static string DueClass(DateTime? due)
        => due is null ? "al-badge--neutral"
         : due.Value.Date < DateTime.Now.Date ? "al-badge--danger"
         : (due.Value - DateTime.Now).TotalDays <= 7 ? "al-badge--warning"
         : "al-badge--neutral";
}
