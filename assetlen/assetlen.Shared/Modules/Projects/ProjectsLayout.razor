@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<div class="project-app">
    <!-- Top Nav Bar -->
    <header class="project-topbar">
        <div class="project-topbar-inner">
            <a href="/portfolio" class="project-brand">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 21h18M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7H3l2-4h14l2 4M5 21V10.87M19 21V10.87"/>
                </svg>
                <span class="project-brand-text">ASSETLEN</span>
            </a>

            <nav class="project-desktop-nav">
                <a href="/portfolio" class="project-nav-link @(IsActive("/portfolio") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    Portfolio
                </a>
                <a href="/pm" class="project-nav-link @(IsActive("/pm") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    Manager
                </a>
            </nav>

            <div class="project-topbar-actions">
                <AuthorizeView>
                    <Authorized>
                        <TenantSwitcher />
                        <button class="project-avatar-btn" @onclick="ToggleProfileMenu">
                            <span class="project-avatar-initials">@GetInitials()</span>
                        </button>
                        @if (showProfileMenu)
                        {
                            <div class="project-profile-dropdown">
                                <button class="project-dropdown-item" @onclick="Logout">Sign Out</button>
                            </div>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="project-btn-signin">Sign In</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="project-main">
        @Body
    </main>

    <!-- Mobile Bottom Nav -->
    <nav class="project-bottomnav">
        <a href="/portfolio" class="project-bottomnav-item @(IsActive("/portfolio") ? "active" : "")">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>Portfolio</span>
        </a>
        @*
            Context-aware primary action. Inside a project the centre button
            captures — the thing that happens many times a day, and the clerk of
            works' only route in. Outside it, it creates a project. Capture must
            never be more than one tap from the project you are looking at.
        *@
        <a href="@PrimaryActionHref" class="project-bottomnav-item project-bottomnav-add"
           aria-label="@(CurrentProjectId is null ? "New project" : "Capture entry")"
           title="@(CurrentProjectId is null ? "New project" : "Capture entry")">
            @if (CurrentProjectId is null)
            {
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            }
            else
            {
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            }
        </a>
        <a href="/pm" class="project-bottomnav-item @(IsActive("/pm") ? "active" : "")">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
            <span>Manager</span>
        </a>
    </nav>
</div>

<FluentDialogProvider />
<FluentToastProvider />

@code {
    private bool showProfileMenu = false;

    protected override void OnInitialized() =>
        Nav.LocationChanged += (_, _) => InvokeAsync(StateHasChanged);

    private bool IsActive(string path)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        return uri.AbsolutePath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// The project id from the current route, or null when we aren't inside one.
    /// Routes are all of the form /project/{id}/...
    /// </summary>
    private string? CurrentProjectId
    {
        get
        {
            var segments = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath
                .Split('/', StringSplitOptions.RemoveEmptyEntries);

            if (segments.Length < 2 || !segments[0].Equals("project", StringComparison.OrdinalIgnoreCase))
                return null;

            // /project/create is the create flow, not a project id.
            return segments[1].Equals("create", StringComparison.OrdinalIgnoreCase) ? null : segments[1];
        }
    }

    private string PrimaryActionHref =>
        CurrentProjectId is { } id ? $"/project/{id}/progress/add" : "/project/create";

    private string GetInitials()
    {
        try
        {
            var user = _sd?.CurrentUser;
            if (user == null) return "?";
            var first = user.FirstName?.Length > 0 ? user.FirstName[0].ToString() : "";
            var last = user.LastName?.Length > 0 ? user.LastName[0].ToString() : "";
            return $"{first}{last}".ToUpper();
        }
        catch { return "?"; }
    }

    private void ToggleProfileMenu() => showProfileMenu = !showProfileMenu;

    private async Task Logout()
    {
        showProfileMenu = false;
        Nav.NavigateTo("/login", true);
    }
}
