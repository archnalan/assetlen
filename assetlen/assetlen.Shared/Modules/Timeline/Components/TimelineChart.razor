@using assetlen.Shared.Models.Models.RemoteSite
@using assetlen.Shared.Models.Models.ViewModels.RemoteSiteDtos

@if (Entries is null || Entries.Count == 0)
{
    <div class="timeline-chart__empty">
        <p class="project-text-sm project-text-muted">No stages to plot yet.</p>
    </div>
}
else
{
    var span = ComputeSpan();
    var rowH = 38;
    var totalH = Entries.Count * rowH + 36;
    var legendItems = new (string Label, string Class)[]
    {
        ("Planned",   "timeline-chart__legend-swatch timeline-chart__legend-swatch--planned"),
        ("Actual",    "timeline-chart__legend-swatch timeline-chart__legend-swatch--actual"),
        ("Today",     "timeline-chart__legend-swatch timeline-chart__legend-swatch--today")
    };

    <div class="timeline-chart">
        <div class="timeline-chart__legend al-num">
            @foreach (var l in legendItems)
            {
                <span class="timeline-chart__legend-item">
                    <span class="@l.Class"></span>@l.Label
                </span>
            }
            <span class="timeline-chart__legend-spacer"></span>
            <span class="timeline-chart__legend-range">@span.Start.ToString("MMM yyyy") → @span.End.ToString("MMM yyyy")</span>
        </div>

        <div class="timeline-chart__rows">
            @foreach (var entry in Entries)
            {
                var p = ComputeBarPositions(entry, span);
                var status = StatusModifier(entry);
                <div class="timeline-chart__row">
                    <div class="timeline-chart__label" title="@entry.StageName">
                        <span class="timeline-chart__label-name">@entry.StageName</span>
                        <span class="timeline-chart__label-meta al-subtle al-num">
                            @FormatVariance(entry.DaysAheadOrBehind)
                        </span>
                    </div>
                    <div class="timeline-chart__track">
                        @if (p.HasBar)
                        {
                            <div class="timeline-chart__bar timeline-chart__bar--planned"
                                 style="left:@(p.LeftPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;width:@(p.WidthPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                            <div class="timeline-chart__bar timeline-chart__bar--actual @($"timeline-chart__bar--{status}")"
                                 style="left:@(p.LeftPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;width:@(p.ActualWidthPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"
                                 title="@($"{entry.ActualProgress}% complete · {entry.StatusBadge}")"></div>
                        }
                        else
                        {
                            <div class="timeline-chart__bar-missing">No dates set</div>
                        }
                        @if (p.TodayPct.HasValue)
                        {
                            <div class="timeline-chart__today" style="left:@(p.TodayPct.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<TimelineEntryDto>? Entries { get; set; }

    private record ChartSpan(DateTime Start, DateTime End, double TotalDays);
    private record BarPositions(bool HasBar, double LeftPct, double WidthPct, double ActualWidthPct, double? TodayPct);

    private ChartSpan ComputeSpan()
    {
        var dated = Entries!.Where(e => e.PlannedStart.HasValue || e.PlannedEnd.HasValue).ToList();
        DateTime start, end;
        if (dated.Count == 0)
        {
            start = DateTime.UtcNow.AddDays(-7);
            end = DateTime.UtcNow.AddDays(30);
        }
        else
        {
            start = dated.Where(e => e.PlannedStart.HasValue).Select(e => e.PlannedStart!.Value).DefaultIfEmpty(DateTime.UtcNow).Min();
            end   = dated.Where(e => e.PlannedEnd.HasValue).Select(e => e.PlannedEnd!.Value).DefaultIfEmpty(DateTime.UtcNow.AddDays(30)).Max();
        }
        // Pad so today and labels never hug the edge.
        start = start.AddDays(-3);
        end = end.AddDays(3);
        if (end <= start) end = start.AddDays(30);
        return new ChartSpan(start, end, (end - start).TotalDays);
    }

    private BarPositions ComputeBarPositions(TimelineEntryDto entry, ChartSpan span)
    {
        if (!entry.PlannedStart.HasValue || !entry.PlannedEnd.HasValue)
            return new BarPositions(false, 0, 0, 0, TodayPct(span));

        var leftDays = (entry.PlannedStart.Value - span.Start).TotalDays;
        var widthDays = (entry.PlannedEnd.Value - entry.PlannedStart.Value).TotalDays;
        if (widthDays < 1) widthDays = 1; // single-day stages still get a visible bar

        var leftPct = Math.Clamp(leftDays / span.TotalDays * 100, 0, 100);
        var widthPct = Math.Clamp(widthDays / span.TotalDays * 100, 0, 100 - leftPct);
        var actualPct = Math.Clamp((double)entry.ActualProgress / 100, 0, 1);
        return new BarPositions(true, leftPct, widthPct, widthPct * actualPct, TodayPct(span));
    }

    private static double? TodayPct(ChartSpan span)
    {
        var t = (DateTime.UtcNow - span.Start).TotalDays;
        if (t < 0 || t > span.TotalDays) return null;
        return t / span.TotalDays * 100;
    }

    private static string StatusModifier(TimelineEntryDto e) => e.Status switch
    {
        StageStatus.Completed => "completed",
        StageStatus.InProgress => "inprogress",
        _ => e.DaysAheadOrBehind > 14 ? "atrisk" : e.DaysAheadOrBehind > 0 ? "behind" : "ontrack"
    };

    private static string FormatVariance(int days) => days switch
    {
        0 => "on day",
        > 0 => $"{days}d behind",
        _ => $"{Math.Abs(days)}d ahead"
    };
}
