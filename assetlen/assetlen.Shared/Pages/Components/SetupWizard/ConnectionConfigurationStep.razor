

<div class="wizard-step d-flex flex-column gap-2">
    <h2>Database Connection</h2>

    <div class="connection-form">
        <FluentTextField Label="Server name" Value="@ServerName" ValueChanged="@((string v) => ServerNameChanged.InvokeAsync(v))"
        Placeholder=". for local server, or server IP/name"></FluentTextField>

        <FluentTextField Label="Instance name" Value="@InstanceName" ValueChanged="@((string v) => InstanceNameChanged.InvokeAsync(v))"
        Placeholder="SQLEXPRESS"></FluentTextField>

        <FluentCheckbox Value="UseWindowsAuth" ValueChanged="@((bool v) => UseWindowsAuthChanged.InvokeAsync(v))">Use Windows Authentication</FluentCheckbox>

        @if (!UseWindowsAuth)
        {
            <FluentTextField Label="Username" ValueChanged="@((string v)=>SqlUsernameChanged.InvokeAsync(v))" Value="@SqlUsername"></FluentTextField>
            <FluentTextField Label="Password" Value="@SqlPassword" ValueChanged="@((string v)=>SqlPasswordChanged.InvokeAsync(v))" Type="password"></FluentTextField>
        }
        <div class="row mt-2">

            <FluentButton @onclick="HandleTestConnection" Style="width:fit-content">Test Connection</FluentButton>
        </div>

        @if(testingConnection)
        {
            <FluentProgress Class="mt-2"></FluentProgress>
        }
        @if (ConnectionTested)
        {
            <div class="@(ConnectionValid ? "text-success text-small" : "text-small text-info")">
                @ConnectionStatus
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string ServerName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ServerNameChanged { get; set; }   
    [Parameter]
    public EventCallback<bool> CanProceedChanged { get; set; }

    [Parameter]
    public string InstanceName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> InstanceNameChanged { get; set; }

    [Parameter]
    public bool UseWindowsAuth { get; set; } = true;

    [Parameter]
    public EventCallback<bool> UseWindowsAuthChanged { get; set; } 

    [Parameter]
    public string SqlUsername { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SqlUsernameChanged { get; set; }

    [Parameter]
    public string SqlPassword { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SqlPasswordChanged { get; set; }

    [Parameter]
    public bool ConnectionTested { get; set; }

    [Parameter]
    public bool ConnectionValid { get; set; }

    [Parameter]
    public string ConnectionStatus { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnTestConnection { get; set; }
    bool testingConnection = false;

    private async Task HandleTestConnection()
    {
        await CanProceedChanged.InvokeAsync(false);
        StateHasChanged();
        await Task.Delay(100);
        testingConnection = true;
        await OnTestConnection.InvokeAsync();
        testingConnection = false;
    }
}