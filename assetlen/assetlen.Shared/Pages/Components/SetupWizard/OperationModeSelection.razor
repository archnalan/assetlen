@using static assetlen.Shared.Pages.Components.SetupWizard.PostInstallWizard
<div class="wizard-step">
    <h2>Operation Mode Selection</h2>
    <p>Select how this computer will be used in your business setup</p>

    <FluentRadioGroup class="d-flex flex-column gap-2" Name="operationMode" ValueChanged="@((OperationMode v)=>HandleOperationModeChanged(v))" Value="@OperationMode">
        <FluentRadio Value="@OperationMode.Composite">
            <strong>Composite Mode</strong> (Single PC) - This computer will act as both server and client
        </FluentRadio>
        <FluentRadio Value="@OperationMode.Server">
            <strong>Server Mode</strong> (Multi-PC Shop) - This will be the main server computer
        </FluentRadio>
        <FluentRadio Value="@OperationMode.AdditionalClient">
            <strong>Additional Client</strong> (Multi-PC Shop) - This is an additional computer connecting to an existing server
        </FluentRadio>
        <FluentRadio Value="@OperationMode.OnlineClient">
            <strong>Online Client</strong> - This computer will connect to the online BillTrick service
        </FluentRadio>
    </FluentRadioGroup>
</div>

@code {
    [Parameter]
    public OperationMode OperationMode { get; set; }

    [Parameter]
    public EventCallback<OperationMode> OperationModeChanged { get; set; }

    private async Task HandleOperationModeChanged(object v)
    {
        await OperationModeChanged.InvokeAsync((OperationMode)v);

    }
}