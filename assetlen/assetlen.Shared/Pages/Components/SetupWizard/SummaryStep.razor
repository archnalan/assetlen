<div class="wizard-step d-flex flex-column gap-2">
    <h2>Configuration Summary</h2>

    <FluentCard >
        <h3>Operation Mode</h3>
        <p>@OperationMode.ToString()</p>

        @if (OperationMode == PostInstallWizard.OperationMode.Composite ||
        OperationMode == PostInstallWizard.OperationMode.Server)
        {
            <h3>Database Configuration</h3>
            <p>Server: @ServerName\\@InstanceName</p>
            <p>Authentication: @(UseWindowsAuth ? "Windows" : "SQL")</p>

            @if (!UseWindowsAuth)
            {
                <p>Username: @SqlUsername</p>
            }
        }

        @if (OperationMode == PostInstallWizard.OperationMode.AdditionalClient ||
        OperationMode == PostInstallWizard.OperationMode.OnlineClient)
        {
            <h3>Connection Details</h3>
            <p>
                API URL: @(OperationMode == PostInstallWizard.OperationMode.OnlineClient
            ? "https://api.billtrick.com"
            : ServerAddress)
            </p>
        }
    </FluentCard>

    <FluentCheckbox @bind-Checked="@CanProceed" ValueChanged="@((bool v)=>CanProceedChanged.InvokeAsync(v))">
        I confirm these settings are correct
    </FluentCheckbox>
</div>

@code {
    [Parameter]
    public PostInstallWizard.OperationMode OperationMode { get; set; }

    [Parameter]
    public string ServerName { get; set; } = string.Empty;

    [Parameter]
    public string InstanceName { get; set; } = string.Empty;

    [Parameter]
    public bool UseWindowsAuth { get; set; }

    [Parameter]
    public string SqlUsername { get; set; } = string.Empty;

    [Parameter]
    public string ServerAddress { get; set; } = string.Empty;

    [Parameter]
    public bool ConnectionValid { get; set; }

    [Parameter]
    public bool CanProceed { get; set; }

    [Parameter]
    public EventCallback<bool> CanProceedChanged { get; set; }
}