@using assetlen.Shared.Models.Models.ViewModels.Users
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@inject IAuthorizationApi _auth
@inject IToastService ToastService
@inject ILogger<EmailVerificationForm> _logger

<div class="verification-container">
    <div class="verification-header">
        <FluentIcon Value="@(new Icons.Regular.Size24.MailAlert())" Color="Color.Accent" />
        <h3>Verify your email</h3>
        <p>We sent a verification code to <strong>@Email</strong></p>
    </div>

    <EditForm Model="verificationDto" OnValidSubmit="HandleVerification" FormName="verification-form">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label class="form-label">
                <FluentIcon Value="@(new Icons.Regular.Size16.Key())" />
                Verification Code
            </label>
            <FluentTextField @bind-Value="verificationDto.Code"
                             Placeholder="Enter 6-digit code"
                             Autocomplete="off"
                             MaxLength="6"
                             Style="width: 100%;"
                             Disabled="@isLoading" />
            <ValidationMessage For="@(() => verificationDto.Code)" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Style="margin-bottom: 1rem;">
                @errorMessage
            </FluentMessageBar>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Success" Style="margin-bottom: 1rem;">
                @successMessage
            </FluentMessageBar>
        }

        <FluentButton Type="ButtonType.Submit"
                      Appearance="Appearance.Accent"
                      Loading="@isLoading"
                      Disabled="@isLoading"
                      Style="width: 100%; min-height: 2.5rem; margin-bottom: 0.75rem;">
            <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" Slot="start" />
            Verify Code
        </FluentButton>

        <FluentButton Type="ButtonType.Button"
                      Appearance="Appearance.Outline"
                      Loading="@isResending"
                      Disabled="@(isResending || resendDisabled)"
                      @onclick="HandleResendCode"
                      Style="width: 100%; min-height: 2.5rem; margin-bottom: 0.75rem;">
            <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSync())" Slot="start" />
            @if (resendDisabled)
            {
                <span>Resend code in @remainingSeconds seconds</span>
            }
            else
            {
                <span>Resend verification code</span>
            }
        </FluentButton>

        <FluentButton Type="ButtonType.Button"
                      Appearance="Appearance.Lightweight"
                      @onclick="OnBackToLogin"
                      Style="width: 100%;">
            <FluentIcon Value="@(new Icons.Regular.Size20.ArrowLeft())" Slot="start" />
            Back to login
        </FluentButton>
    </EditForm>
</div>

@code {
    [Parameter]
    public string Email { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnVerificationComplete { get; set; }

    [Parameter]
    public EventCallback OnBackToLogin { get; set; }

    private VerifyCodeDto verificationDto = new();
    private bool isLoading;
    private bool isResending;
    private bool resendDisabled;
    private int remainingSeconds;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private System.Threading.Timer? countdownTimer;

    protected override void OnInitialized()
    {
        verificationDto.Identifier = Email;
    }

    private async Task HandleVerification()
    {
        try
        {
            errorMessage = string.Empty;
            successMessage = string.Empty;
            isLoading = true;
            StateHasChanged();

            var result = await _auth.VerifyCode(verificationDto);

            if (result.IsSuccessStatusCode)
            {
                successMessage = "Email verified successfully! You can now log in.";
                ToastService.ShowSuccess("Email verified successfully!");
                StateHasChanged();

                await Task.Delay(1500);
                await OnVerificationComplete.InvokeAsync();
            }
            else
            {
                var error = result.Error?.Content;
                if (!string.IsNullOrEmpty(error))
                {
                    try
                    {
                        var errors = JsonConvert.DeserializeObject<JToken>(error);
                        errorMessage = errors?["message"]?.ToString() ?? "Invalid verification code";
                    }
                    catch
                    {
                        errorMessage = "Invalid verification code";
                    }
                }
                else
                {
                    errorMessage = "Invalid verification code";
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error during verification");
            errorMessage = "An error occurred. Please try again.";
            ToastService.ShowError("Verification failed");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleResendCode()
    {
        try
        {
            errorMessage = string.Empty;
            successMessage = string.Empty;
            isResending = true;
            StateHasChanged();

            var result = await _auth.ResendVerificationCode(Email);

            if (result.IsSuccessStatusCode)
            {
                successMessage = "Verification code sent! Check your email.";
                ToastService.ShowSuccess("Verification code sent!");
                
                // Start countdown timer
                StartResendCooldown(120); // 2 minutes initial cooldown
            }
            else
            {
                var error = result.Error?.Content;
                if (!string.IsNullOrEmpty(error))
                {
                    try
                    {
                        var errors = JsonConvert.DeserializeObject<JToken>(error);
                        errorMessage = errors?["message"]?.ToString() ?? "Failed to resend code";
                        
                        // Check if it's a rate limit message with remaining time
                        if (errorMessage.Contains("wait") && errorMessage.Contains("minute"))
                        {
                            // Extract minutes from error message
                            var match = System.Text.RegularExpressions.Regex.Match(errorMessage, @"(\d+)\s+.*minute");
                            if (match.Success && int.TryParse(match.Groups[1].Value, out int minutes))
                            {
                                StartResendCooldown(minutes * 60);
                            }
                        }
                    }
                    catch
                    {
                        errorMessage = "Failed to resend code";
                    }
                }
                else
                {
                    errorMessage = "Failed to resend code";
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error resending verification code");
            errorMessage = "An error occurred. Please try again.";
            ToastService.ShowError("Failed to resend code");
        }
        finally
        {
            isResending = false;
            StateHasChanged();
        }
    }

    private void StartResendCooldown(int seconds)
    {
        resendDisabled = true;
        remainingSeconds = seconds;

        countdownTimer?.Dispose();
        countdownTimer = new System.Threading.Timer(_ =>
        {
            remainingSeconds--;

            if (remainingSeconds <= 0)
            {
                resendDisabled = false;
                countdownTimer?.Dispose();
                countdownTimer = null;
            }

            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        countdownTimer?.Dispose();
    }
}

<style>
    .verification-container {
        width: 100%;
    }

    .verification-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .verification-header h3 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0.75rem 0 0.5rem;
        color: var(--neutral-foreground-rest);
    }

    .verification-header p {
        color: var(--neutral-foreground-hint);
        margin: 0;
        font-size: 0.875rem;
    }

    .verification-header strong {
        color: var(--accent-fill-rest);
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-label {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-weight: 500;
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
        color: var(--neutral-foreground-rest);
    }
</style>
