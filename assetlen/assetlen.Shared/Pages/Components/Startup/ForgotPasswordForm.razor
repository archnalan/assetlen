@using assetlen.Shared.Models.Models
@inject IAuthorizationApi _auth
@inject NavigationManager _nav
@inject ILogger<ForgotPasswordForm> _logger

<div class="authform">
    <header class="authform__head">
        <span class="al-eyebrow">Password reset</span>
        <h2 class="authform__title">Reset your password</h2>
        <p class="authform__sub">Enter your email or phone number and we'll send instructions.</p>
    </header>

    <div class="authform__body">
        <div class="al-field">
            <label class="al-label" for="fp-identifier">Email or phone number</label>
            <input id="fp-identifier" class="al-input" type="text" autocomplete="username"
                   placeholder="you@example.com or +256…"
                   disabled="@isLoading"
                   @bind-value="identifier" @bind-value:event="oninput" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="al-alert al-alert--error" role="alert">
                <Icon Name="error" Size="18" />
                <span>@errorMessage</span>
            </div>
        }

        <button type="button" class="al-btn al-btn--primary al-btn--lg al-btn--block"
                disabled="@isLoading" @onclick="HandleSubmit">
            @if (isLoading)
            {
                <span class="al-spinner"></span><span>Sending…</span>
            }
            else
            {
                <span>Send reset instructions</span>
            }
        </button>

        <button type="button" class="al-btn al-btn--default al-btn--block"
                disabled="@isLoading" @onclick="OnBackToLogin">
            <Icon Name="chevron-left" Size="16" /> Back to sign in
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnBackToLogin { get; set; }
    [Parameter] public EventCallback<string> OnEmailSent { get; set; }
    [Parameter] public EventCallback<PhoneResetData> OnPhoneSent { get; set; }

    private string identifier = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleSubmit()
    {
        try
        {
            errorMessage = "";

            if (string.IsNullOrWhiteSpace(identifier))
            {
                errorMessage = "Please enter your email or phone number";
                return;
            }

            isLoading = true;
            StateHasChanged();

            // Get the origin domain for the reset link
            var originDomain = _nav.BaseUri.TrimEnd('/');

            var result = await _auth.InitiatePasswordReset(identifier.Trim(), originDomain);

            if (result.IsSuccessStatusCode)
            {
                var message = result.Content ?? "Reset instructions sent";

                // Check if it's email or phone based on the response
                if (message.Contains("email", StringComparison.OrdinalIgnoreCase))
                {
                    // Email path - show success message
                    await OnEmailSent.InvokeAsync(identifier);
                }
                else if (message.Contains("phone", StringComparison.OrdinalIgnoreCase))
                {
                    // Phone path - move to OTP verification
                    await OnPhoneSent.InvokeAsync(new PhoneResetData { PhoneNumber = identifier });
                }
                else
                {
                    // Generic success
                    await OnEmailSent.InvokeAsync(identifier);
                }
            }
            else
            {
                var error = result.Error?.Content;
                if (!string.IsNullOrEmpty(error))
                {
                    try
                    {
                        var errorObj = Newtonsoft.Json.JsonConvert.DeserializeObject<Newtonsoft.Json.Linq.JToken>(error);
                        errorMessage = errorObj?["message"]?.ToString() ?? "Failed to send reset instructions";
                    }
                    catch
                    {
                        errorMessage = "Failed to send reset instructions";
                    }
                }
                else
                {
                    errorMessage = "Failed to send reset instructions";
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error initiating password reset");
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public class PhoneResetData
    {
        public string PhoneNumber { get; set; }
    }
}