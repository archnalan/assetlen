@using assetlen.Shared.Models.Models
@inject ILogger<LoginForm> _logger

<EditForm EditContext="@EditContext" OnValidSubmit="HandleFormSubmit" class="lf">

    <div class="al-field">
        <label class="al-label" for="lf-email">Email or username</label>
        <div class="al-inputwrap">
            <Icon Name="person" Size="16" />
            <input id="lf-email" class="al-input" type="text" autocomplete="username"
                   placeholder="you@example.com"
                   @bind-value="LoginDto.Email" @bind-value:event="oninput" />
        </div>
    </div>

    <div class="al-field">
        <div class="lf__label-row">
            <label class="al-label" for="lf-password">Password</label>
            @if (OnForgotPassword.HasDelegate)
            {
                <button type="button" class="al-btn al-btn--link lf__forgot" @onclick="OnForgotPassword">Forgot?</button>
            }
        </div>
        <div class="al-inputwrap">
            <Icon Name="lock" Size="16" />
            <input id="lf-password" class="al-input lf__password" type="@(showPassword ? "text" : "password")"
                   autocomplete="current-password"
                   placeholder="••••••••"
                   @bind-value="LoginDto.Password" @bind-value:event="oninput"
                   @onkeydown="HandleKeyDown" />
            <button type="button" class="al-iconbtn al-iconbtn--sm lf__reveal"
                    @onclick="() => showPassword = !showPassword"
                    aria-label="@(showPassword ? "Hide password" : "Show password")">
                <Icon Name="@(showPassword ? "eye-off" : "eye")" Size="16" />
            </button>
        </div>
    </div>

    <button type="submit" class="al-btn al-btn--primary al-btn--lg al-btn--block" disabled="@isLoading">
        @if (isLoading)
        {
            <span class="al-spinner" aria-hidden="true"></span>
            <span>Signing in…</span>
        }
        else
        {
            <span>Sign in</span>
            <Icon Name="arrow-right" Size="16" />
        }
    </button>

    <div class="lf__validation">
        <DataAnnotationsValidator />
        <ValidationSummary />
    </div>
</EditForm>

@code {
    [Parameter] public UserLogin LoginDto { get; set; } = default!;
    [Parameter] public EventCallback HandleLogin { get; set; }
    [Parameter] public EventCallback ClearErrors { get; set; }
    [Parameter] public EditContext EditContext { get; set; } = default!;
    [Parameter] public bool isLoading { get; set; }
    [Parameter] public EventCallback OnForgotPassword { get; set; }

    private bool showPassword;

    private async Task HandleFormSubmit()
    {
        await ClearErrors.InvokeAsync();
        if (isLoading) return;
        isLoading = true;
        await HandleLogin.InvokeAsync();
        isLoading = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;

        // The bound value lands on the next tick; submitting immediately posts
        // the password minus its last character.
        await Task.Delay(50);
        await HandleFormSubmit();
    }
}
