@using assetlen.Shared.Models.Models
@inject IAuthorizationApi _auth
@inject ILogger<PhoneResetVerification> _logger

<div class="authform">
    <header class="authform__head">
        <span class="al-eyebrow">Password reset</span>
        <h2 class="authform__title">Verify your phone</h2>
        <p class="authform__sub">Enter the six-digit code sent to <strong>@PhoneNumber</strong>.</p>
    </header>

    <div class="authform__body">
        <div class="al-field">
            <label class="al-label" for="pr-otp">Verification code</label>
            <input id="pr-otp" class="al-input authform__code" type="text" inputmode="numeric"
                   autocomplete="one-time-code" maxlength="6" placeholder="000000"
                   disabled="@isLoading"
                   @bind-value="otp" @bind-value:event="oninput" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="al-alert al-alert--error" role="alert">
                <Icon Name="error" Size="18" />
                <span>@errorMessage</span>
            </div>
        }

        <button type="button" class="al-btn al-btn--primary al-btn--lg al-btn--block"
                disabled="@isLoading" @onclick="HandleVerify">
            @if (isLoading)
            {
                <span class="al-spinner"></span><span>Verifying…</span>
            }
            else
            {
                <span>Verify code</span>
            }
        </button>

        <button type="button" class="al-btn al-btn--default al-btn--block"
                disabled="@isLoading" @onclick="OnBackToForgot">
            <Icon Name="chevron-left" Size="16" /> Back
        </button>
    </div>
</div>

@code {
    [Parameter] public string PhoneNumber { get; set; } = "";
    [Parameter] public EventCallback OnBackToForgot { get; set; }
    [Parameter] public EventCallback<string> OnVerified { get; set; }

    private string otp = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleVerify()
    {
        try
        {
            errorMessage = "";

            if (string.IsNullOrWhiteSpace(otp))
            {
                errorMessage = "Please enter the verification code";
                return;
            }

            if (otp.Length != 6)
            {
                errorMessage = "Code must be 6 digits";
                return;
            }

            isLoading = true;
            StateHasChanged();

            var result = await _auth.VerifyPasswordResetOtp(PhoneNumber, otp);

            if (result.IsSuccessStatusCode)
            {
                // The API returns the reset token
                var resetToken = result.Content;
                if (!string.IsNullOrEmpty(resetToken))
                {
                    await OnVerified.InvokeAsync(resetToken);
                }
                else
                {
                    errorMessage = "Failed to verify code";
                }
            }
            else
            {
                var error = result.Error?.Content;
                if (!string.IsNullOrEmpty(error))
                {
                    try
                    {
                        var errorObj = Newtonsoft.Json.JsonConvert.DeserializeObject<Newtonsoft.Json.Linq.JToken>(error);
                        errorMessage = errorObj?["message"]?.ToString() ?? "Invalid verification code";
                    }
                    catch
                    {
                        errorMessage = "Invalid verification code";
                    }
                }
                else
                {
                    errorMessage = "Invalid verification code";
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error verifying code");
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}