@inject IJSRuntime JSRuntime
@implements IDialogContentComponent<string>
@inject IKeyGen keyGen

<div class="license-container">
    <div class="license-header">
        <h2>REGISTER BILLTRICK</h2>
        <p class="subtitle">Licence request token</p>
    </div>

    <!-- Step Toggle - Always visible -->
    <div class="step-toggle">
        <FluentButton Appearance="Appearance.Stealth" 
        OnClick="@ToggleStep"
        Class="toggle-btn">
            @(_showTokenStep ? "I already have the license key" : "Generate token again")
        </FluentButton>
    </div>

    <!-- Token Generation Step -->
    @if (_showTokenStep)
    {
        <div class="license-step">

            <div class="license-mode-section">
                <h6>License mode</h6>
                <FluentSelect @bind-Value="_selectedLicenseMode" 
                Placeholder="Select license mode"
                TOption="string"
                Class="license-mode-select">
                    <FluentOption Value="1">TillPoint (Activate all modules)</FluentOption>
                    <FluentOption Value="2">BackOffice (Admin module only)</FluentOption>
                </FluentSelect>
            </div>

            <div class="action-section">
                @if (string.IsNullOrEmpty(_generatedToken))
                {
                    <FluentButton Appearance="Appearance.Accent" 
                    OnClick="@GenerateToken"
                    Disabled="@string.IsNullOrEmpty(_selectedLicenseMode)"
                    Class="generate-btn">
                        Generate token
                    </FluentButton>
                }
                else
                {
                    <div class="token-section">
                        <label class="token-label">Generated Token:</label>
                        <div class="token-display">
                            <FluentTextArea @bind-Value="_generatedToken" Style="width:90%; height:auto"
                            Readonly="true"
                            Class="token-field" />
                            <FluentButton Appearance="Appearance.Outline" 
                            OnClick="@CopyToken"
                            Class="copy-btn">
                                Copy
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Accent"
                            OnClick="@GenerateToken"
                            IconEnd="@(new Icons.Regular.Size20.ArrowCircleDownUp())"
                            Disabled="@string.IsNullOrEmpty(_selectedLicenseMode)"
                            Class="generate-btn">
                            </FluentButton>
                        </div>
                    </div>
                }
            </div>

            <div class="instructions">
                <p>Send generated token to <a href="mailto:support@billtrick.com">support@billtrick.com</a> or visit 
                    <a href="#" target="_blank">BillTrick registration site</a> to get the Licence key</p>
            </div>
        </div>
    }

    <!-- License Activation Step -->
    @if (!_showTokenStep)
    {
        <div class="license-step">
            <h3>Paste Licence Key</h3>

            <div class="activation-section">
                <FluentTextField @bind-Value="_licenseKey" 
                Placeholder="Enter your license key here"
                Style="width:90%"
                Class="license-field" />

                <div class="action-buttons">
                    <FluentButton Appearance="Appearance.Accent" 
                    OnClick="@ActivateLicense"
                    IconEnd="@(new Icons.Regular.Size20.ArrowEnter())"
                    Loading ="_isLoading"
                    Class="register-btn"
                    >
                        Register Now
                    </FluentButton>

                    <FluentButton Appearance="Appearance.Outline" 
                    OnClick="@CloseDialog"
                    Disabled = "_isLoading"
                    Class="close-btn">
                        Close
                    </FluentButton>
                </div>
            </div>
        </div>
    }

    <!-- Status Message -->
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="status-message @_statusClass">
            @_statusMessage
        </div>
    }
</div>

@code {
    private string _generatedToken = "";
    private string _licenseKey = "";
    private string _selectedLicenseMode = "";
    private string _statusMessage = "";
    private string _statusClass = "";
    private bool _showTokenStep = true;
    private bool _isLoading = false;
    private static string _deviceKey = "";

    [Parameter]
    public string Content { get; set; } = default!;

    [CascadingParameter]
    public FluentDialog? Dialog { get; set; }


    protected override async Task OnInitializedAsync()
    {
        _deviceKey = await keyGen.GetDeviceID();
        CheckForExistingToken();
    }

    private void CheckForExistingToken()
    {

        var savedToken = keyGen.ReadRegistraionFile(); 
        var _hasToken = !string.IsNullOrEmpty(savedToken);

        // If we have a token, show license activation by default
        if (_hasToken)
        {
            _showTokenStep = false;
            _generatedToken = savedToken;
        }
        else
        {
            _showTokenStep = true;
        }
    }

    private void ToggleStep()
    {
        _showTokenStep = !_showTokenStep;
        StateHasChanged();
    }
    private void GenerateToken()
    {
        //#if WINDOWS
        if (string.IsNullOrEmpty(_selectedLicenseMode))
        {
            ShowStatus("Please select a license mode first", "error");
            return;
        }

        // Generate a unique token including the license mode

        long obfuscatorPI = long.Parse(Math.PI.ToString().Substring(2, 9) + Math.PI.ToString().Substring(2, 9));

        PublicKeyDto publicKey = new PublicKeyDto();
        publicKey.DeviceKey = _deviceKey;
        publicKey.userName = Environment.MachineName.ToString();
        publicKey.ModuleID = int.Parse(_selectedLicenseMode);

        _generatedToken = keyGen.createRegistrationFile(publicKey);
        string oldPublicKey = keyGen.ReadRegistraionFile();

        //updating LicenceFile
        if (string.IsNullOrEmpty(oldPublicKey))
        {
            publicKey.DeviceKey = "";
            keyGen.saveRegistraionFile(keyGen.createRegistrationFile(publicKey));
        }
        else
        {
            PublicKeyDto oldPublicKeyObject = keyGen.deCipherRegistraionFile(oldPublicKey);
            if ((new DateTime(oldPublicKeyObject.ActivationID4 - obfuscatorPI)).AddDays(30) < DateTime.Today)
            {
                oldPublicKeyObject.ActivationID1 = publicKey.ActivationID1;
                oldPublicKeyObject.ActivationID4 = publicKey.ActivationID4;
            }
            keyGen.saveRegistraionFile(keyGen.createRegistrationFile(oldPublicKeyObject));
        }

        ShowStatus("Token generated successfully!", "success");
        StateHasChanged();
        // #endif
    }
    private async Task CopyToken()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _generatedToken);
            ShowStatus("Token copied to clipboard!", "success");
        }
        catch (Exception ex)
        {
            ShowStatus("Failed to copy token: " + ex.Message, "error");
        }
    }

    private async void ActivateLicense()
    {
        if (string.IsNullOrEmpty(_licenseKey))
        {
            ShowStatus("Please enter a license key", "error");
            return;
        }
        if (_licenseKey.Length<25)
        {
            ShowStatus("Invalid License key", "error");
            return;
        }
        _isLoading = true;
        StateHasChanged();

        try
        {
            // Run the validation on a background thread to avoid blocking UI
            var (result, heading) = await Task.Run(() =>
            {
                string heading;
                var result = messageValidatePOSKey(out heading);
                return (result, heading);
            });

            if (heading.ToLower().Contains("error"))
            {
                ShowStatus(result, "error");
            }
            else
            {
                ShowStatus(result, "success");
                ToastService.ShowSuccess(result);
                await Task.Delay(4000);



                // Close the dialog on successful activation
                if (Dialog != null)
                {
                    await Dialog.CloseAsync(_licenseKey);
                }
            }
        }
        catch (Exception ex)
        {
            ShowStatus($"Activation failed: {ex.Message}", "error");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged(); // Ensure UI updates when loading completes
        }
    }

    private string messageValidatePOSKey(out string MessageboxHeading)
    {
        try
        {
          //try registration
                
                PublicKeyDto publicKey = new ();
                publicKey.DeviceKey = _deviceKey;

                string oldPublicKey = keyGen.ReadRegistraionFile();
                PublicKeyDto oldPublicKeyObject;


                long obfuscatorPI = long.Parse(Math.PI.ToString().Substring(2, 9) + Math.PI.ToString().Substring(2, 9));


                if (string.IsNullOrEmpty(oldPublicKey))
                {
                    MessageboxHeading = "Error Licencing";
                    return "Invalid Key. Licensing service was not found. Please request for license Key from support@billtrick.com or www.billtrick.com";
                }

                oldPublicKeyObject = keyGen.deCipherRegistraionFile(oldPublicKey);


                Random randNumber = new Random();
                oldPublicKeyObject.ModuleID = randNumber.Next(1, 9);
                oldPublicKeyObject.DeviceKey = _licenseKey;
                //oldPublicKeyObject.ActivationID5 = (DateTime.Today.AddDays(1).Ticks) + obfuscatorPI;
                oldPublicKeyObject.ActivationID4 = (new DateTime(oldPublicKeyObject.ActivationID1 - obfuscatorPI).AddDays(-7.56455)).Ticks+obfuscatorPI; //convert ID 1 to ID4
                var key = keyGen.GetCreateHarshfromString(_deviceKey + (oldPublicKeyObject.ActivationID4 - obfuscatorPI).ToString().Substring(0, 6)+2).Substring(0, 29);

                //test Is Partial Key
            if (_licenseKey == keyGen.GetCreateHarshfromString(_deviceKey + (new DateTime(oldPublicKeyObject.ActivationID1 - obfuscatorPI).AddDays(-7.56455)).Ticks.ToString().Substring(0, 6) + 3).Substring(0, 29))
            {
                if (DateTime.Now > new DateTime(oldPublicKeyObject.ActivationID4 - obfuscatorPI).AddYears(1))
                {
                    MessageboxHeading = "Error Licencing";
                    return "The entered Licence Key is Expired";

                }
                keyGen.saveRegistraionFile(keyGen.createRegistrationFile(oldPublicKeyObject));


                MessageboxHeading = "Licencing Successfull";
                return $"Thank you for registering your software Your License will expire on {new DateTime(oldPublicKeyObject.ActivationID4 - obfuscatorPI).AddYears(1).ToShortDateString()}. Please restart BillTrick POS for the changes to take effect";

            }
            //test Is Partial Key 2 years
            else if (_licenseKey == keyGen.GetCreateHarshfromString(_deviceKey + (new DateTime(oldPublicKeyObject.ActivationID1 - obfuscatorPI).AddDays(-7.56455)).Ticks.ToString().Substring(0, 6) + 3 + 2).Substring(0, 29))
                {

                    if (DateTime.Now > new DateTime(oldPublicKeyObject.ActivationID4 - obfuscatorPI).AddYears(1))
                    {
                        MessageboxHeading = "Error Licencing";
                        return "The entered Licence Key is expired";

                    }
                    keyGen.saveRegistraionFile(keyGen.createRegistrationFile(oldPublicKeyObject));


                    MessageboxHeading = "Licencing Successfull";
                    return $"Thank you for registering your software Your License will expire on {new DateTime(oldPublicKeyObject.ActivationID4 - obfuscatorPI).AddYears(2).ToShortDateString()}. Please restart BillTrick POS for the changes to take effect";


                }

            else if (_licenseKey == keyGen.GetCreateHarshfromString(_deviceKey + (new DateTime(oldPublicKeyObject.ActivationID1 - obfuscatorPI).AddDays(-7.56455)).Ticks.ToString().Substring(0, 6)).Substring(0, 29))
                {
                    if (DateTime.Now > new DateTime(oldPublicKeyObject.ActivationID4 - obfuscatorPI).AddYears(1))
                    {
                        MessageboxHeading = "Error Licencing";
                        return "The entered Licence Key is Already expired";

                    }
                    keyGen.saveRegistraionFile(keyGen.createRegistrationFile(oldPublicKeyObject));


                    MessageboxHeading = "Licencing Successfull";
                    return $"Thank you for registering your software Your License will expire on {new DateTime(oldPublicKeyObject.ActivationID4 - obfuscatorPI).AddYears(1).ToShortDateString()}. Please restart BillTrick POS for the changes to take effect";

                }
                //test full activation for 2 years
            else if (_licenseKey == keyGen.GetCreateHarshfromString(_deviceKey + (new DateTime(oldPublicKeyObject.ActivationID1 - obfuscatorPI).AddDays(-7.56455)).Ticks.ToString().Substring(0, 6) + 2).Substring(0, 29))
                {
                    if (DateTime.Now > new DateTime(oldPublicKeyObject.ActivationID4 - obfuscatorPI).AddYears(1))
                    {
                        MessageboxHeading = "Error Licencing";
                        return "The entered Licence Key is Already expired";

                    }
                    keyGen.saveRegistraionFile(keyGen.createRegistrationFile(oldPublicKeyObject));


                    MessageboxHeading = "Licencing Successfull";
                    return $"Thank you for registering your software Your License will expire on {new DateTime(oldPublicKeyObject.ActivationID4 - obfuscatorPI).AddYears(2).ToShortDateString()}. Please restart BillTrick POS for the changes to take effect";

                }
                MessageboxHeading = "Error Licencing";
            return "The entered Licence Key is Invalid";
        }
        catch (Exception)
        {
            MessageboxHeading = "Error Licensing";
            return "Could not register license.";
        }
        MessageboxHeading = "";
        return "";
    }

    private void CloseDialog()
    {
        Dialog?.CloseAsync(null);
    }

    private void ShowStatus(string message, string type)
    {
        _statusMessage = message;
        _statusClass = type;
        
        // Clear status after 5 seconds
        Task.Delay(5000).ContinueWith(_ => {
            _statusMessage = "";
            _statusClass = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private bool _hasToken => !string.IsNullOrEmpty(_generatedToken);
}

