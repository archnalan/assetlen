@using assetlen.Shared.Models.Models
@inject IAuthorizationApi _auth
@inject NavigationManager _nav
@inject ILogger<ResetPasswordForm> _logger

<div class="authform">
    <header class="authform__head">
        <span class="al-eyebrow">Password reset</span>
        <h2 class="authform__title">Create a new password</h2>
        <p class="authform__sub">Choose something you have not used here before.</p>
    </header>

    <div class="authform__body">
        <div class="al-field">
            <label class="al-label" for="rp-new">New password</label>
            <input id="rp-new" class="al-input" type="password" autocomplete="new-password"
                   placeholder="••••••••" disabled="@isLoading"
                   @bind-value="newPassword" @bind-value:event="oninput" />
        </div>

        <div class="al-field">
            <label class="al-label" for="rp-confirm">Confirm password</label>
            <input id="rp-confirm" class="al-input" type="password" autocomplete="new-password"
                   placeholder="••••••••" disabled="@isLoading"
                   @bind-value="confirmPassword" @bind-value:event="oninput" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="al-alert al-alert--error" role="alert">
                <Icon Name="error" Size="18" />
                <span>@errorMessage</span>
            </div>
        }

        <button type="button" class="al-btn al-btn--primary al-btn--lg al-btn--block"
                disabled="@isLoading" @onclick="HandleResetPassword">
            @if (isLoading)
            {
                <span class="al-spinner"></span><span>Resetting…</span>
            }
            else
            {
                <span>Reset password</span>
            }
        </button>

        @if (!string.IsNullOrEmpty(ResetToken))
        {
            <button type="button" class="al-btn al-btn--default al-btn--block"
                    disabled="@isLoading" @onclick="OnCancel">
                Cancel
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string Identifier { get; set; } = "";
    [Parameter] public string? ResetToken { get; set; }
    [Parameter] public string? VerificationCode { get; set; }
    [Parameter] public EventCallback OnSuccess { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string newPassword = "";
    private string confirmPassword = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleResetPassword()
    {
        try
        {
            errorMessage = "";

            // Validate inputs
            if (string.IsNullOrWhiteSpace(newPassword))
            {
                errorMessage = "Password is required";
                return;
            }

            if (newPassword.Length < 4)
            {
                errorMessage = "Password must be at least 4 characters";
                return;
            }

            if (newPassword != confirmPassword)
            {
                errorMessage = "Passwords do not match";
                return;
            }

            if (string.IsNullOrEmpty(Identifier))
            {
                errorMessage = "Invalid reset request";
                return;
            }

            isLoading = true;
            StateHasChanged();

            var resetDto = new ResetPasswordDto
            {
                Identifier = Identifier,
                Password = newPassword,
                ResetToken = ResetToken,
                VerificationCode = VerificationCode
            };

            var result = await _auth.ResetPassword(resetDto);

            if (result.IsSuccessStatusCode)
            {
                await OnSuccess.InvokeAsync();
            }
            else
            {
                var error = result.Error?.Content;
                if (!string.IsNullOrEmpty(error))
                {
                    try
                    {
                        var errorObj = Newtonsoft.Json.JsonConvert.DeserializeObject<Newtonsoft.Json.Linq.JToken>(error);
                        errorMessage = errorObj?["message"]?.ToString() ?? "Failed to reset password";
                    }
                    catch
                    {
                        errorMessage = "Failed to reset password";
                    }
                }
                else
                {
                    errorMessage = "Failed to reset password";
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error resetting password");
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}