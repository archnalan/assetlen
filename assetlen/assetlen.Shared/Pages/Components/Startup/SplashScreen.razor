@implements IDialogContentComponent<SplashScreenContent>

<div class="rounded-3" style="background: var(--neutral-layer-1);">
	<FluentDialogHeader Style="display:none"></FluentDialogHeader>
	<FluentDialogBody>
		<div class="w-100 h-100 d-flex flex-column justify-content-center align-items-center gap-2">
			<h2>@Content.Title</h2>
			<h5>@Content.SubTitle</h5>
			<FluentProgressRing></FluentProgressRing>
			<p>@Content.LoadingText</p>
			<div class="text-center h6 mb-3">@Content.Message</div>
			<img src="@Content.Logo" alt="Logo" style="height:3rem" />
		</div>
	</FluentDialogBody>
	<FluentDesignTheme @bind-Mode="@Mode"
					   @bind-officeColor="Color"
					   StorageName="" />

	<FluentDialogFooter Style="display:none"></FluentDialogFooter>
</div>

@code {
	[Parameter]
	public SplashScreenContent Content { get; set; } = default!;
	private DesignThemeModes Mode = DesignThemeModes.Dark;
	private OfficeColor? Color = OfficeColor.Word;
}