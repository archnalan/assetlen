@using System.ComponentModel.DataAnnotations
@implements IDialogContentComponent<DialogMessageDto>

<!-- Header -->
<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon  Color="Color.Error" Value="@(HeaderIcon)" />
        <FluentLabel Color="Color.Error" Typo="Typography.PaneHeader">
            @Content.DialogTitle
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

<!-- Body -->
<FluentDialogBody>
    <EditForm EditContext="@_editContext" >
      

        <FluentLabel Style="margin-bottom: 16px;">
           @Content.DialogMessage
        </FluentLabel>

        <div style="margin-top:3rem; width:100%; display:flex; justify-content:center">
            <FluentIcon Color="Color.Error" Value="@(themeIcon)" />
        </div>

        

       
    </EditForm>
</FluentDialogBody>

<!-- Footer -->
<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Accent"
                  Disabled="@(!_editContext.Validate())"
                  Color="Color.Error"
                  OnClick="@SaveAsync" 
                   IconEnd="new Icons.Regular.Size24.CheckboxChecked()" >
        @(Content.DialogButtonPrimary??"Confirm")
    </FluentButton>
    <FluentButton Appearance="Appearance.Neutral"
                  OnClick="@CancelAsync">
        @(Content.DialogButtonCancel ?? "Cancel")
    </FluentButton>
</FluentDialogFooter>

@code
{
    private EditContext _editContext = default!;

    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;

    [Parameter]
    public DialogMessageDto Content { get; set; } = default!;
    private Icon themeIcon { get; set; }
    private Icon HeaderIcon { get; set; }


    protected override void OnInitialized()
    {
        _editContext = new EditContext(Content);
        themeIcon = Content.IsWarning ? (new Icons.Regular.Size48.Warning()) : (new Icons.Regular.Size48.CheckmarkCircle());
        HeaderIcon = Content.IsWarning ? (new Icons.Regular.Size24.Warning()) : (new Icons.Regular.Size24.CheckmarkCircle());
    
    }

    private async Task SaveAsync()
    {        
            await Dialog.CloseAsync(Content);        
    }

    private async Task CancelAsync()
    {
        await Dialog.CancelAsync();
    }

  
}
