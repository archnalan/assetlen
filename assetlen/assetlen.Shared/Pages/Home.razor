@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ShellState Shell
@inject AttentionState Attention
@inject ProjectMenuState Menu
@inject ILogger<Home> Logger

@*
    One home, several readings.

    What changes per reader is *emphasis*, exactly as the Client Brief changes
    emphasis over one set of facts (assetlen.md §5). Nobody gets a different
    truth.

    Order is the same for everyone: what needs you, then what you own, then what
    moved. Peter opens this for under a minute (Peter.md, "the daily loop"), so
    the thing he must act on cannot sit below a grid of cards.

    The projects come from ShellState, not from a list of this page's own, so
    the arrangement here and the arrangement in the rail are the same list.
*@

<PageTitle>Your projects — ASSETLEN</PageTitle>

<div class="al-page">

    <TitleBlock Eyebrow="@Eyebrow" Title="@Title" Subtitle="@Subtitle">
        <Meta>
            <div class="al-meta">
                <span class="al-label">Projects</span>
                <span class="al-meta__value">@Shell.Cards.Count</span>
            </div>
            @if (ShowMoney)
            {
                <div class="al-meta">
                    <span class="al-label">Committed</span>
                    <span class="al-meta__value">@Fmt.MoneyShort(portfolio?.TotalCapitalDeployed ?? 0)</span>
                </div>
            }
            <div class="al-meta">
                <span class="al-label">Today</span>
                <span class="al-meta__value">@Fmt.Date(DateTime.Now)</span>
            </div>
        </Meta>

        <Actions>
            @if (CanCreateProject)
            {
                <a href="/project/create" class="al-btn al-btn--default">
                    <Icon Name="plus" Size="16" /> New project
                </a>
            }
        </Actions>
    </TitleBlock>

    <StateBlock Phase="phase" OnRetry="LoadAsync"
                ErrorTitle="Your projects didn't load"
                ErrorMessage="@errorMessage"
                EmptyIcon="project"
                EmptyTitle="No projects yet"
                EmptyBody="A project holds the stages you fund, the drawings you approve and the record of what was agreed. Create one, then invite whoever is building it.">
        <Loading>
            <div class="home__ghosts">
                <div class="al-shimmer al-ghost-row"></div>
                <div class="al-grid">
                    <div class="al-shimmer al-ghost-card"></div>
                    <div class="al-shimmer al-ghost-card"></div>
                </div>
            </div>
        </Loading>

        <ChildContent>

            @* ── 1. What needs you ─────────────────────────────────────── *@
            @if (Attention.Count > 0)
            {
                <section class="home__section">
                    <div class="al-rule">
                        <span class="al-label">Needs you</span>
                        @if (Attention.OverdueCount > 0)
                        {
                            <span class="al-badge al-badge--danger">@Attention.OverdueCount overdue</span>
                        }
                    </div>

                    <div class="al-sheet al-sheet--ticked">
                        <div class="al-register">
                            @foreach (var item in Attention.Owed.Take(4))
                            {
                                <a class="al-register__row al-register__row--needs-you" href="@item.Href">
                                    <Icon Name="@item.Icon" Size="18" Class="home__need-icon" />
                                    <span class="al-register__main">
                                        <span class="al-register__title">@item.Title</span>
                                        <span class="al-register__sub">
                                            <span>@item.ProjectName</span>
                                            @if (item.Detail is not null)
                                            {
                                                <span>@item.Detail</span>
                                            }
                                        </span>
                                    </span>
                                    <span class="al-register__end">
                                        @if (item.DueLabelShort is not null)
                                        {
                                            <span class="al-badge @item.BadgeClass">@item.DueLabelShort</span>
                                        }
                                        <Icon Name="chevron-right" Size="16" Class="al-subtle" />
                                    </span>
                                </a>
                            }
                        </div>

                        @if (Attention.Count > 4)
                        {
                            <div class="al-sheet__foot">
                                <a class="al-btn al-btn--link" href="/needs-you">
                                    @(Attention.Count - 4) more waiting on you
                                </a>
                            </div>
                        }
                    </div>
                </section>
            }

            @* ── 2. The projects ───────────────────────────────────────── *@
            @if (Shell.PinnedCount > 0)
            {
                <section class="home__section">
                    <div class="al-rule">
                        <span class="al-label">Pinned</span>
                    </div>

                    @* Pinned cards are outside the sortable list: a pin is a
                       statement that this one stays put. *@
                    <div class="al-grid al-grid--wide">
                        @foreach (var project in Shell.Pinned)
                        {
                            <ProjectCard Project="project" ShowMoney="ShowMoney"
                                         Draggable="false" Eager="true" OnMenu="OpenMenu" />
                        }
                    </div>
                </section>
            }

            <section class="home__section">
                <div class="al-rule">
                <span class="al-label">@(Shell.PinnedCount > 0 ? "Other projects" : "Your projects")</span>
                    @if (UnpinnedCards.Count > 1 && !hintDismissed)
                    {
                        <span class="home__hint">
                            <Icon Name="grip" Size="13" />
                            <span>Drag to rearrange. Right-click for more.</span>
                        </span>
                    }
                </div>

                <div class="al-grid al-grid--wide home__sortable" @ref="sortHost">
                    @{ var first = true; }
                    @foreach (var project in UnpinnedCards)
                    {
                        var eager = first && Shell.PinnedCount == 0;
                        first = false;

                        <div class="pcard__slot" data-al-drag="@project.Id">
                            <ProjectCard Project="project" ShowMoney="ShowMoney"
                                         Eager="eager" OnMenu="OpenMenu" />
                        </div>
                    }
                </div>
            </section>

            @* ── 3. What moved ─────────────────────────────────────────── *@
            <section class="home__section">
                <div class="al-rule">
                    <span class="al-label">What moved</span>
                </div>

                @if (recent.Count == 0)
                {
                    <div class="al-empty">
                        <Icon Name="camera" Size="40" Class="al-empty__icon" Weight="1.25" />
                        <h3 class="al-empty__title">Nothing posted yet</h3>
                        <p class="al-empty__body">
                            @(IsClientSide
                                ? "When work is captured against a stage you funded, it lands here — and in the daily brief, whether or not anyone remembers to send it."
                                : "Capture against a stage and it appears here for everyone on this side.")
                        </p>
                    </div>
                }
                else
                {
                    <div class="al-sheet">
                        <div class="al-register">
                            @foreach (var entry in recent)
                            {
                                <a class="al-register__row" href="/project/@entry.ProjectId/entry/@entry.Id">
                                    <span class="al-register__index">@Fmt.DateShort(entry.DateTimeCreated)</span>
                                    <span class="al-register__main">
                                        <span class="al-register__title al-clamp-2">@entry.Description</span>
                                        <span class="al-register__sub">
                                            <span>@ProjectNameFor(entry.ProjectId)</span>
                                            @if (!string.IsNullOrEmpty(entry.StageName))
                                            {
                                                <span>@entry.StageName</span>
                                            }
                                            @if (entry.ImageCount > 0)
                                            {
                                                <span>@entry.ImageCount @(entry.ImageCount == 1 ? "frame" : "frames")</span>
                                            }
                                        </span>
                                    </span>
                                    <span class="al-register__end">
                                        @if (entry.HasIssues)
                                        {
                                            <span class="al-badge al-badge--warning">Issue</span>
                                        }
                                        <Icon Name="chevron-right" Size="16" Class="al-subtle" />
                                    </span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </section>

        </ChildContent>
    </StateBlock>
</div>

@code {
    private PortfolioSummaryDto? portfolio;
    private readonly List<ProgressUpdateDto> recent = new();
    private LoadPhase phase = LoadPhase.Loading;
    private string? errorMessage;

    private ElementReference sortHost;
    private DotNetObjectReference<Home>? selfRef;
    private bool sortRegistered;
    private bool dragging;
    private bool hintDismissed;

    private List<ProjectCardDto> UnpinnedCards => Shell.Unpinned.ToList();

    protected override void OnInitialized()
    {
        _sd.OnUserUpdated += Refresh;
        Attention.OnChange += Refresh;
        Shell.OnChange += Refresh;
    }

    public async ValueTask DisposeAsync()
    {
        _sd.OnUserUpdated -= Refresh;
        Attention.OnChange -= Refresh;
        Shell.OnChange -= Refresh;

        if (sortRegistered)
        {
            try { await JS.InvokeVoidAsync("assetlen.dragsort.unregister", SortId); }
            catch (Exception ex) { Logger.LogDebug(ex, "Could not release the home sortable"); }
        }

        selfRef?.Dispose();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // ── Arranging ───────────────────────────────────────────────────────────

    private const string SortId = "home-projects";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (sortRegistered || phase != LoadPhase.Ready || Shell.Cards.Count == 0) return;

        sortRegistered = true;
        selfRef ??= DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync("assetlen.dragsort.register", SortId, sortHost, selfRef);
        }
        catch (Exception ex)
        {
            sortRegistered = false;
            Logger.LogDebug(ex, "Could not attach the home sortable");
        }
    }

    /// <summary>Called by the sortable on drop, with positions within the unpinned list.</summary>
    [JSInvokable]
    public async Task OnReorder(int from, int to)
    {
        hintDismissed = true;

        if (!await Shell.ReorderAsync(from, to))
            ToastService.ShowWarning("That order didn't save. It will go back on the next refresh.");
    }

    [JSInvokable]
    public Task OnDragStateChanged(bool isDragging)
    {
        dragging = isDragging;
        if (isDragging) hintDismissed = true;
        return InvokeAsync(StateHasChanged);
    }

    private void OpenMenu((ProjectCardDto Project, MouseEventArgs Pointer) request)
    {
        // A menu anchored to a pointer that has moved on would open in the wrong place.
        if (dragging) return;
        Menu.Open(request.Project, request.Pointer.ClientX, request.Pointer.ClientY);
    }

    private async Task LoadAsync()
    {
        phase = LoadPhase.Loading;
        errorMessage = null;
        recent.Clear();
        StateHasChanged();

        try
        {
            var response = await _projectsRSApi.GetPortfolioDashboard();

            if (!response.IsSuccessStatusCode || response.Content is null)
            {
                phase = LoadPhase.Error;
                errorMessage = _apiResponseHandler.GetApiErrorMessage(response);
                return;
            }

            portfolio = response.Content;
            Shell.SetProjects(portfolio.Projects);

            if (Shell.Cards.Count == 0)
            {
                phase = LoadPhase.Empty;
                return;
            }

            phase = LoadPhase.Ready;
            StateHasChanged();

            // Additive: the page is usable the moment the projects render, and
            // neither of these can hold it up. "Needs you" reads the shared scan
            // rather than assembling a second copy that could disagree with the
            // number in the rail.
            await Task.WhenAll(
                Attention.RefreshAsync(Shell.Cards),
                LoadRecentAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Home failed to load");
            phase = LoadPhase.Error;
            errorMessage = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task LoadRecentAsync()
    {
        foreach (var project in AllProjects())
        {
            try
            {
                var page = await _progressApi.GetProgressUpdates(project.Id, null, 0, 4);
                if (page.IsSuccessStatusCode && page.Content?.Data is not null)
                    recent.AddRange(page.Content.Data);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not read recent activity for {ProjectId}", project.Id);
            }
        }

        recent.Sort((a, b) => (b.DateTimeCreated ?? DateTime.MinValue).CompareTo(a.DateTimeCreated ?? DateTime.MinValue));
        if (recent.Count > 6) recent.RemoveRange(6, recent.Count - 6);

        StateHasChanged();
    }

    /// <summary>
    /// Top-level projects and their sub-projects, flattened — a guest wing has
    /// its own stages and its own activity. Snapshotted because the shell reads
    /// the dashboard too and replaces the list mid-scan.
    /// </summary>
    private List<ProjectCardDto> AllProjects()
        => Shell.Cards.Concat(Shell.Cards.SelectMany(p => p.SubProjects)).ToList();

    private string ProjectNameFor(string? projectId)
        => Shell.Find(projectId)?.Name ?? "—";

    // ── Emphasis per reader ────────────────────────────────────────────────

    private UserRolesDto? Roles => _sd.CurrentUser?.RolesDto;
    private bool IsClientSide => Roles?.IsExternal == true;

    /// <summary>Crew and Guest have no financial visibility anywhere (CLAUDE.md §5.5).</summary>
    private bool ShowMoney => Roles?.CanSeeFinancials == true;

    private bool CanCreateProject => Roles is { } r && (r.Contractor || r.Manager || r.SystemAdmin);

    private string Eyebrow
    {
        get
        {
            var name = _sd.CurrentUser?.FirstName;
            return string.IsNullOrWhiteSpace(name) ? "Home" : $"Good day, {name}";
        }
    }

    private string Title => Roles switch
    {
        { Contractor: true } => "Your projects",
        { Client: true } => "Your projects",
        _ => "Your work"
    };

    private string Subtitle => Roles switch
    {
        { Contractor: true } =>
            "What needs a decision, what you have funded, and what moved since you last looked.",
        { Client: true } =>
            "The choices you owe, the specs you set, and what has been fitted since you last looked.",
        { Manager: true } =>
            "Everything crossing to the client side carries your name. Open questions first.",
        _ =>
            "What is open on site, and what has been captured against it."
    };

}
