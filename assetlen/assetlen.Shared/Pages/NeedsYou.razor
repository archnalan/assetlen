@page "/needs-you"
@attribute [Authorize]
@implements IDisposable
@inject AttentionState Attention
@inject ILogger<NeedsYou> Logger

@*
    Everything waiting on the person reading, across every project.

    *"I have to go somewhere to find decisions I owe"* is listed as a failure
    condition in [Peter.md](Peter.md). This is the somewhere, and it is one tap
    from every screen — the deliberate answer to that.

    Ordered by deadline, soonest first, with anything already overdue at the
    top. Undated items sit last: an idea nobody is waiting on must never be
    allowed to nag (Law 4).

    The list itself comes from [[AttentionState]] rather than being assembled
    here. This page and Home each used to run their own per-project loop over
    the same two endpoints, which meant the number in the rail, the number on
    Home and the rows on this page were three separate answers to one question
    and could disagree.
*@

<PageTitle>Needs you — ASSETLEN</PageTitle>

<div class="al-page">

    <TitleBlock Eyebrow="Across all your projects"
                Title="Needs you"
                Subtitle="Decisions you owe, and money waiting to be acknowledged.">
        <Meta>
            <div class="al-meta">
                <span class="al-label">Waiting</span>
                <span class="al-meta__value">@Attention.Count</span>
            </div>
            <div class="al-meta">
                <span class="al-label">Overdue</span>
                <span class="al-meta__value">@Attention.OverdueCount</span>
            </div>
        </Meta>
    </TitleBlock>

    <StateBlock Phase="phase" OnRetry="LoadAsync"
                ErrorTitle="This didn't load"
                ErrorMessage="@errorMessage"
                EmptyIcon="check-circle"
                EmptyTitle="Nothing is waiting on you"
                EmptyBody="When a choice blocks work, costs money or moves a date, it appears here with its by-when and what it holds up.">
        <ChildContent>

            @foreach (var group in Attention.Owed.GroupBy(i => i.ProjectName))
            {
                <section class="needs__group">
                    <div class="al-rule">
                        <span class="al-label">@group.Key</span>
                    </div>

                    <div class="al-sheet al-sheet--ticked">
                        <div class="al-register">
                            @foreach (var item in group)
                            {
                                <a class="al-register__row al-register__row--needs-you" href="@item.Href">
                                    <Icon Name="@item.Icon" Size="18" Class="needs__icon" />
                                    <span class="al-register__main">
                                        <span class="al-register__title">@item.Title</span>
                                        <span class="al-register__sub">
                                            @if (item.Detail is not null)
                                            {
                                                <span>@item.Detail</span>
                                            }
                                            @if (item.Consequence is not null)
                                            {
                                                <span>@item.Consequence</span>
                                            }
                                        </span>
                                    </span>
                                    <span class="al-register__end">
                                        <span class="al-badge @item.BadgeClass">@item.DueLabel</span>
                                        <Icon Name="chevron-right" Size="16" Class="al-subtle" />
                                    </span>
                                </a>
                            }
                        </div>
                    </div>
                </section>
            }

        </ChildContent>
    </StateBlock>
</div>

@code {
    private LoadPhase phase = LoadPhase.Loading;
    private string? errorMessage;

    protected override void OnInitialized() => Attention.OnChange += Refresh;
    public void Dispose() => Attention.OnChange -= Refresh;

    private void Refresh() => InvokeAsync(() => { Settle(); StateHasChanged(); });

    protected override async Task OnInitializedAsync()
    {
        // The shell scans at boot, so in the normal case this page has its
        // answer before it is opened and renders with no wait at all. Only a
        // deep link straight to /needs-you has to ask.
        if (!Attention.Loaded) await LoadAsync();
        else Settle();
    }

    private async Task LoadAsync()
    {
        phase = LoadPhase.Loading;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var response = await _projectsRSApi.GetPortfolioDashboard();

            if (!response.IsSuccessStatusCode || response.Content is null)
            {
                phase = LoadPhase.Error;
                errorMessage = _apiResponseHandler.GetApiErrorMessage(response);
                return;
            }

            await Attention.RefreshAsync(response.Content.Projects);
            Settle();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Needs-you failed to load");
            phase = LoadPhase.Error;
            errorMessage = ex.Message;
        }
        finally { StateHasChanged(); }
    }

    /// <summary>
    /// Empty here is the good outcome, so it gets its own state rather than an
    /// empty list under a heading. But "nothing is waiting on you" must never be
    /// shown before the scan has answered — that would be a lie with a tick next
    /// to it, which is worse than a skeleton.
    /// </summary>
    private void Settle()
    {
        if (phase == LoadPhase.Error) return;
        if (!Attention.Loaded) { phase = LoadPhase.Loading; return; }
        phase = Attention.Count == 0 ? LoadPhase.Empty : LoadPhase.Ready;
    }
}
