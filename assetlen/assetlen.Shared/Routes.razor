@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Layout.AppShell).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="typeof(Layout.AppShell)">
                <NotAuthorized>
                    <div class="al-page al-page--reading">
                        <TitleBlock Eyebrow="Not signed in"
                                    Title="This page belongs to a project"
                                    Subtitle="Sign in with the account that was invited to it." />
                        <a class="al-btn al-btn--primary" href="/login">Go to sign in</a>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Layout.AppShell)">
                <div class="al-page al-page--reading">
                    <TitleBlock Eyebrow="404"
                                Title="Nothing at this address"
                                Subtitle="The link may be out of date, or the project may have been renamed." />
                    <a class="al-btn al-btn--primary" href="/">Back to your projects</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
