@using Microsoft.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components
@using mowt.Shared.Layout
@inject NavigationService NavService

<FluentAutocomplete Id="nav-search"
                    @ref="navSearchAutocomplete"
                    TOption="NavItem"
                    Style="max-width:15rem"
                    Placeholder="Search navigation items..."
                    OnOptionsSearch="@OnSearch"
                    AutoComplete="off"
                    OptionText="@(item => item.Title)"
                    OptionStyle="min-height: 40px; width:100%"
                    @bind-SelectedOption="@SelectedItem">

    @* Template used with the Selected item *@
    <SelectedOptionTemplate>
        <div class="selected-item" style="max-width:15rem">
            @if (context.Icon != null)
            {
                <FluentIcon Value="@context.Icon" Color="Color.Accent" />
            }
            <span>@context.Title</span>
            <span class="item-path">@context.GroupPath</span>
        </div>
    </SelectedOptionTemplate>

    @* Template used with each Option item *@
    <OptionTemplate>
        <div class="option-item" onclick="@(() => OnItemChanged(context))" style="max-width:15rem">
            @if (context.Icon != null)
            {
                <FluentIcon Value="@context.Icon" Color="Color.Accent" />
            }
            <div class="option-content">
                <div class="option-title">@context.Title</div>
                @if (!string.IsNullOrEmpty(context.GroupPath))
                {
                    <div class="option-path">@context.GroupPath</div>
                }
            </div>
        </div>
    </OptionTemplate>

    @* Content display at the top of the Popup area *@
    <HeaderContent>
        <FluentLabel Color="Color.Accent"
                     Style="padding: 8px; font-size: 11px; border-bottom: 1px solid var(--neutral-fill-stealth-hover);">
            Navigation items
        </FluentLabel>
    </HeaderContent>

    @* Content display at the bottom of the Popup area *@
    <FooterContent>
        @if (!context.Any())
        {
            <FluentLabel Style="font-size: 11px; text-align: center; width: 100%;">
                No results found
            </FluentLabel>
        }
    </FooterContent>
</FluentAutocomplete>

@code {
    private FluentAutocomplete<NavItem>? navSearchAutocomplete;
    private NavItem? SelectedItem;
    private List<NavItem> allItems = new();

    protected override void OnInitialized()
    {
        allItems = NavService.GetAllNavigationItems();
    }

    private void OnItemChanged(NavItem item)
    {
        if (item != null && !string.IsNullOrEmpty(item.Href))
        {
            _nav.NavigateTo(item.Href);
            SelectedItem = null;
        }
    }

    private void OnSearch(OptionsSearchEventArgs<NavItem> e)
    {
        if (string.IsNullOrWhiteSpace(e.Text))
        {
            e.Items = allItems;
            return;
        }

        var query = e.Text.Trim().ToLower();
        e.Items = allItems
            .Where(item =>
                item.Title.ToLower().Contains(query) ||
                (!string.IsNullOrEmpty(item.GroupPath) && item.GroupPath.ToLower().Contains(query)) ||
                item.Href.ToLower().Contains(query))
            .OrderByDescending(item => item.Title.ToLower().StartsWith(query)) // Prioritize items that start with the query
            .ThenBy(item => item.Title);
    }
}

<style>
   
    .option-item {
        display: flex;
        align-items: center;
        padding: 4px 0;
        gap: 8px;
    }

    .option-content {
        display: flex;
        flex-direction: column;
    }

    .option-title {
        font-weight: 500;
    }

    .option-path {
        font-size: 0.75rem;
        color: var(--neutral-foreground-hint);
    }

    .selected-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .item-path {
        font-size: 0.75rem;
        color: var(--neutral-foreground-hint);
        margin-left: 8px;
    }
</style>
