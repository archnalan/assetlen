@page "/setup"
@using Microsoft.Extensions.Configuration
@using System.Data.SqlClient
@inject IConfiguration Configuration
@inject HttpClient Http
@inject ILogger<PostInstallWizard> Logger
@using Microsoft.Win32;
@using System.Security.Principal;
@using System.Runtime.InteropServices
@using System.Text
@inject IFormFactor _formFactor
@implements IDialogContentComponent<string>

@if (Dialog != null)
{

    <FluentDialogHeader Style="display:none"></FluentDialogHeader>

}
<FluentDialogBody>
    <FluentDesignSystemProvider Style="">
        <div class="wizard-container" style="max-width:30rem ; align-self:center">
            @if (currentStep == 1)
            {
                <OperationModeSelection OperationMode="@operationMode"
                OperationModeChanged="@(op => operationMode = op)" />
            }
            else if (currentStep == 2)
            {
                @if (operationMode == OperationMode.Composite ||
        operationMode == OperationMode.Server)
                {
                    <SqlInstallationStep SqlInstalled="@sqlInstalled"
                    SqlInstalledChanged="@(installed => sqlInstalled = installed)"
                    UseExistingDatabase="@useExistingDatabase"
                    UseExistingDatabaseChanged="@(use => useExistingDatabase = use)"
                    InstallationInProgress="@installationInProgress"
                    InstallationProgress="@installationProgress"
                    InstallationStatus="@installationStatus"
                    _selectedFilePath="@_selectedFilePath"
                    SelectedFilePathChanged="@(selected=> _selectedFilePath = selected)"
                    InstallationComplete="@installationComplete" />
                }
                else
                {
                    <ClientConfigurationStep ServerAddress="@serverAddress"
                    ServerAddressChanged="@(addr => serverAddress = addr)"
                    SetCurrentStep="@(number => currentStep=number)"
                    FinishSetup = "FinishSetup"
                    HandleRestartApp="HandleRestartApp"
                    OperationMode="@operationMode" />
                }
            }
            else if (currentStep == 3)
            {
                <ConnectionConfigurationStep ServerName="@serverName"
                ServerNameChanged="@(s => serverName = s)"
                InstanceName="@instanceName"
                InstanceNameChanged="@(i => instanceName = i)"
                UseWindowsAuth="@useWindowsAuth"
                UseWindowsAuthChanged="@(auth => useWindowsAuth = auth)"
                SqlUsername="@sqlUsername"
                SqlUsernameChanged="@(u => sqlUsername = u)"
                SqlPassword="@sqlPassword"
                SqlPasswordChanged="@(p => sqlPassword = p)"
                ConnectionTested="@connectionTested"
                ConnectionValid="@connectionValid"
                ConnectionStatus="@connectionStatus"
                CanProceedChanged="@((bool v)=>canProceed=v)"
                OnTestConnection="@TestConnection" />
            }
            else if (currentStep == 4)
            {
                <SummaryStep OperationMode="@operationMode"
                ServerName="@serverName"
                InstanceName="@instanceName"
                UseWindowsAuth="@useWindowsAuth"
                SqlUsername="@sqlUsername"
                ServerAddress="@serverAddress"
                ConnectionValid="@connectionValid"
                CanProceed="@canProceed"
                CanProceedChanged="@(cp => canProceed = cp)" />
            }

            <div class="wizard-navigation d-flex align-items-center gap-1 mt-2">
                @if (currentStep > 1 && currentStep < 5)
                {
                    <FluentButton Disabled="@(!CanProceed || installationInProgress)" IconStart="@(new Icons.Regular.Size20.ArrowLeft())" Appearance="Appearance.Neutral" @onclick="GoBack">
                        Back
                    </FluentButton>
                }
                @if (currentStep < 4)
                {
                    <FluentButton Appearance="Appearance.Accent" @onclick="GoNext" IconEnd="@(currentStep ==3? new Icons.Regular.Size20.DatabasePlugConnected(): new Icons.Regular.Size20.ArrowRight())"
                    Disabled="@(!CanProceed || installationInProgress || currentStep==3 && !connectionValid)">
                        @(currentStep == 3 ? "Connect" : "Next")
                    </FluentButton>
                }
                else
                {
                    <FluentButton Appearance="Appearance.Accent" @onclick="FinishSetUpAndRestart" IconEnd="@(new Icons.Regular.Size20.Save())"
                    Disabled="@(!canProceed)">
                        Finish Setup
                    </FluentButton>
                }
            </div>
        </div>
    </FluentDesignSystemProvider>
</FluentDialogBody>
@if (Dialog != null)
{

    <FluentDialogFooter Style="display:none"></FluentDialogFooter>
}

@code {
    private string _selectedFilePath { get; set; }
    private int currentStep = 1;
    private OperationMode operationMode;
    private bool sqlInstalled;
    private bool useExistingDatabase = true;
    private string serverName = ".";
    private string instanceName = "SQLEXPRESS";
    private string databaseName = "BilltrickV2-db01";
    private bool useWindowsAuth = true;
    private string sqlUsername = "sa";
    private string sqlPassword = "BillV2Data";
    private string serverAddress = "http://localhost:5140";
    private bool connectionTested;
    private bool connectionValid;
    private string connectionStatus = string.Empty;
    private bool canProceed;
    private bool installationInProgress;
    private bool installationComplete;
    private int installationProgress;
    private string installationStatus = string.Empty;



    [Parameter]
    public string Content { get; set; } = default!;

    [CascadingParameter]
    public FluentDialog? Dialog { get; set; }


    protected override async Task OnInitializedAsync()
    {
        if ((_formFactor.GetFormFactor().ToLower().Contains("web")))
        {
            return;
        }
        // Check if running as admin
        if (!IsRunningAsAdmin())
        {

            var exePath = System.Diagnostics.Process.GetCurrentProcess().MainModule.FileName;
            var startInfo = new ProcessStartInfo(exePath)
                {
                    Verb = "runas", // Triggers UAC
                    UseShellExecute = true,
                    Arguments = "--install-sql" // Optional: pass a flag to trigger InstallSqlServer again
                };

            try
            {
                Process.Start(startInfo);
                // Exit current process if relaunching
                Environment.Exit(0);
            }
            catch (Exception ex)
            {
                installationStatus = "Elevation required to install SQL Server.";
                Logger.LogError(ex, "User declined UAC or error occurred.");
                return;
            }
        }
        await Task.CompletedTask;
    }

    private bool CanProceed => currentStep switch
    {
        1 => operationMode != OperationMode.NotSelected,
        2 => true, // Always allow proceeding to trigger installation
        3 => connectionTested && connectionValid,
        _ => true
    };

    private void GoBack()
    {
        if (currentStep > 1) currentStep--;
    }

    private async Task GoNext()
    {
        if (currentStep == 2)
        {
            if ((operationMode == OperationMode.Composite || operationMode == OperationMode.Server) && !sqlInstalled)
            {
                await InstallSqlServer();
                // Only proceed if installation was successful
                if (!installationComplete) return;
            }
        }

        if (currentStep < 4) currentStep++;
    }
    private async Task InstallSqlServer2()
    {
        installationInProgress = true;
        installationStatus = "Starting installation...";
        installationProgress = 0;
        StateHasChanged();

        try
        {
            // Update UI: Download starting
            installationStatus = "Downloading SQL Server Express...";
            installationProgress = 25;
            StateHasChanged();

            var installerPath = Path.Combine(Path.GetTempPath(), "SqlExpressSetup.exe");

            if (string.IsNullOrEmpty(_selectedFilePath))
            {
                var downloadUrl = Configuration["SqlExpressDownloadUrl"];
                var response = await Http.GetAsync(downloadUrl);

                if (!response.IsSuccessStatusCode)
                {
                    installationStatus = "Download failed!";
                    return;
                }

                //Update UI: Install starting
                installationStatus = "Installing SQL Server...";
                installationProgress = 50;
                StateHasChanged();


                await using var stream = await response.Content.ReadAsStreamAsync();
                await using var fileStream = File.Create(installerPath);
                await stream.CopyToAsync(fileStream);
            }

         

            // Run silent installation
            var process = new Process();
            process.StartInfo.FileName = installerPath;
            process.StartInfo.Arguments = "/Q /IACCEPTSQLSERVERLICENSETERMS /ACTION=Install " +
                                          $"/FEATURES=SQLENGINE /INSTANCENAME={instanceName} " +
                                          $"/SECURITYMODE=SQL /SAPWD={sqlPassword} " +
                                          "/TCPENABLED=1";
            process.StartInfo.UseShellExecute = false;
            process.StartInfo.CreateNoWindow = false;
            process.Start();
            await process.WaitForExitAsync();

            // Verify successful installation
            if (process.ExitCode == 0)
            {
                installationProgress = 100;
                installationStatus = "Installation completed successfully!";
                sqlInstalled = true;
                installationComplete = true;
                instanceName = "SQLEXPRESS";
            }
            else
            {
                installationStatus = $"Installation failed with code: {process.ExitCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SQL Server installation failed");
            installationStatus = $"Installation failed: {ex.Message}";
        }
        finally
        {
            installationInProgress = false;
            StateHasChanged();
        }
    }
    private async Task HandleRestartApp()
    {
        Logger.LogInformation("Restarting the application from the Post-Install component");

        try
        {
            foreach (var proc in Process.GetProcessesByName("Billtrickv2.API"))
            {
                if (proc.HasExited) continue;

                proc.CloseMainWindow();

                if (!proc.WaitForExit(5000))
                {
                    proc.Kill(true);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Problem shutting down Billtrickv2.API");
        }

        var exePath = Process.GetCurrentProcess().MainModule?.FileName ?? string.Empty;

        var startInfo = new ProcessStartInfo(exePath)
            {
                Arguments = string.Join(' ', Environment.GetCommandLineArgs().Skip(1)),
                UseShellExecute = true
            };

        try
        {
            Process.Start(startInfo);
            Environment.Exit(0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while restarting the application");
        }

        await Task.CompletedTask;
    }

    private async Task InstallSqlServer()
    {
        installationInProgress = true;
        installationStatus = "Starting installation...";
        installationProgress = 0;
        StateHasChanged();
        var instances = GetLocalSqlInstancesFromRegistry();
        //Test connection to exisiting sql server instances and skip download and installing if we can connect
        installationStatus = "Checking exisiting SQL installations ...";
        installationProgress = 5;
        string selectedServerName = string.Empty;
        foreach (var server in instances)
        {
            var test = await TestSqlConnection(server);

            if(test)
            {
                selectedServerName = server;
                break;
            }
        }
        if (selectedServerName != string.Empty)
        {
            // We have a valid instance, skip installation
            serverName = ".";
            instanceName = selectedServerName;
            sqlInstalled = true;
            installationComplete = true;
            installationInProgress = false;
            installationStatus = "SQL Server instance found and connected successfully!";
            ToastService.ShowInfo("An existing Server was discovered and connected to. Install skipped.");
            canProceed = true;
            StateHasChanged();
            return;
        }


        var installerPath = Path.Combine(Path.GetTempPath(), "SqlExpressSetup.exe");
        try
        {
            // Update UI: Download starting

            if (string.IsNullOrEmpty(_selectedFilePath))
            {
                installationStatus = "Downloading SQL Server Express...";
                installationProgress = 25;
                StateHasChanged();

                var downloadUrl = Configuration["BackendConfig:SqlExpressDownloadUrl"];
                var response = await Http.GetAsync(downloadUrl);

                if (!response.IsSuccessStatusCode)
                {
                    installationStatus = "Download failed!";
                    return;
                }




                await using var stream = await response.Content.ReadAsStreamAsync();
                await using var fileStream = File.Create(installerPath);
                await stream.CopyToAsync(fileStream);
            }
            else
            {

                installerPath = _selectedFilePath;
            }


            //Update UI: Install starting
            installationStatus = "Installing SQL Server...";
            installationProgress = 50;
            StateHasChanged();


            // var installerPath = "D:\\Projects\\BilltrickV2\\SQLEXPR_x64_ENU.exe";

            var process = new Process
                {
                    StartInfo = new ProcessStartInfo
                    {
                        FileName = installerPath,
                        Arguments = "/Q /IACCEPTSQLSERVERLICENSETERMS /ACTION=Install " +
                                    $"/FEATURES=SQLENGINE /INSTANCENAME={instanceName} " +
                                    $"/SECURITYMODE=SQL /SAPWD={sqlPassword} /TCPENABLED=1",
                        UseShellExecute = true,
                        Verb = "runas", // Ensures the installer itself runs elevated
                        CreateNoWindow = true
                    }
                };

            process.Start();
            await process.WaitForExitAsync();

            if (process.ExitCode == 0)
            {
                installationProgress = 100;
                installationStatus = "Installation completed successfully!";
                sqlInstalled = true;
                installationComplete = true;
            }
            else
            {
                installationStatus = $"Installation failed with code: {process.ExitCode}";
                ToastService.ShowError($"Installation failed with code: {process.ExitCode}");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SQL Server installation failed");
            installationStatus = $"Installation failed: {ex.Message}";
            ToastService.ShowError($"Installation failed: {ex.Message}");
            StateHasChanged();
        }
        finally
        {
            installationInProgress = false;
            StateHasChanged();

            //cleanup
            if (File.Exists(installerPath)) File.Delete(installerPath);
        }
    }

    public List<string> GetLocalSqlInstancesFromRegistry()
    {
        var instances = new List<string>();
        const string instanceKeyPath = @"SOFTWARE\Microsoft\Microsoft SQL Server\Instance Names\SQL";

        using (RegistryKey key = Registry.LocalMachine.OpenSubKey(instanceKeyPath))
        {
            if (key != null)
            {

                foreach (var instanceName in key.GetValueNames())
                {
                    instances.Add(instanceName);
                    // if (instanceName == "MSSQLSERVER")
                    //     instances.Add(Environment.MachineName); // Default instance
                    // else
                    //     instances.Add($"{Environment.MachineName}\\{instanceName}"); // Named instance
                }
            }
        }

        return instances;
    }

    private bool IsRunningAsAdmin()
    {
        using var identity = WindowsIdentity.GetCurrent();
        var principal = new WindowsPrincipal(identity);
        return principal.IsInRole(WindowsBuiltInRole.Administrator);
    }

    private async Task TestConnection()
    {
        try
        {
            var name = string.IsNullOrEmpty(instanceName) ? string.Empty : "\\" + instanceName  ;
            // Build connection string
            var connectionString = useWindowsAuth
                ? $"Data Source={serverName}{name};Integrated Security=True;"
                : $"Data Source={serverName}{name};User Id={sqlUsername};Password={sqlPassword};";

            // Test connection
            using var connection = new SqlConnection(connectionString);
            await connection.OpenAsync();
            connectionValid = true;
            connectionStatus = "Connection successful!";
            await connection.CloseAsync();
            canProceed = true;
        }
        catch (Exception ex)
        {
            connectionValid = false;
            connectionStatus = $"Connection failed: {ex.Message}";
        }
        finally
        {

            connectionTested = true;
            StateHasChanged();
        }
    }

    private async Task<bool> TestSqlConnection( string instanceName)
    {
        var connectionString = $"Data Source=.\\{instanceName};Integrated Security=True;";
        using var connection = new SqlConnection(connectionString);
        try
        {
            // Build connection string

            // Test connection
            await connection.OpenAsync();
            return true;

        }
        catch (Exception ex)
        {
            Logger.LogError("Error testing SQL connection for instance {instanceName}: {ex}", instanceName, ex.Message); 
            return false;
        }
        finally
        {
            await connection.CloseAsync();


        }
    }
    private async Task FinishSetUpAndRestart()
    {
        try
        {
            FinishSetup();
            ToastService.ShowSuccess("Your configuration settings have been saved successfully. Application will restart to apply the settings");
            await Task.Delay(3000);
            await HandleRestartApp();
        }
        catch (Exception ex)
        {
            Logger.LogError("Error while saving server configurationn {ex}", ex);
            ToastService.ShowError($"An error occured while saving your configuration {ex.Message}");
        }
    }

    private void FinishSetup()
    {
        // Update app settings
        UpdateAppSettings();


    }

    private void UpdateAppSettings()
    {
        // Update backend appsettings.json
        var backendSettings = new BackendAppSettings();

        if (operationMode == OperationMode.Composite ||
            operationMode == OperationMode.Server)
        {
            var connectionString = BuildConnectionString();
            backendSettings.ConnectionStrings.DefaultConnection = connectionString;
            backendSettings.ConnectionStrings.DefaultConnectionHangfire = connectionString.Replace("Trust Server Certificate=True;", "").Replace("Encrypt=True;","");
            backendSettings.AppMode = (int)operationMode;
            backendSettings.LogIngestUrl = "https://logs.billtrick.com/ingest/otlp/v1/logs";
        }

        // Update frontend appsettings.json
        var frontendSettings = new FrontendAppSettings
            {
                BackendConfig = new BackendConfig
                {
                    Mode = (int)operationMode,
                    ApiUrl = operationMode == OperationMode.OnlineClient
                        ? "https://api.billtrick.com"
                        : serverAddress
                }
            };
        frontendSettings.BackendConfig.PrinterServerPath = GetPrinterServerPath();
        frontendSettings.BackendConfig.ExecutablePath = GetApiPath();

        if (operationMode == OperationMode.AdditionalClient)
        {
            backendSettings.AppMode = 3;
            frontendSettings.BackendConfig.Mode = 3;

        }

        //compute api running path
        var apiPath = GetApiPath();


        var appDataPath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.CommonApplicationData),
            "BilltrickV2");

        if (!Directory.Exists(appDataPath)) Directory.CreateDirectory(appDataPath);

        // Save files
        if (operationMode == OperationMode.Composite ||
             operationMode == OperationMode.Server) File.WriteAllText(Path.Combine(appDataPath, "appsettings-api.json"), JsonSerializer.Serialize(backendSettings));
        File.WriteAllText(Path.Combine(appDataPath, "appsettings-terminal.json"), JsonSerializer.Serialize(frontendSettings));

        if(operationMode == OperationMode.Server)
        {

            // Install the background worker service
            var bgWorkerPath = GetBGWorkerPath();
            if (!string.IsNullOrEmpty(bgWorkerPath))
            {

                InstallService("BilltrickV2.BGWorker", bgWorkerPath);
            }
            else
            {
                Logger.LogError("Background worker executable not found at expected path: {bgWorkerPath}", bgWorkerPath);
            }
        }
    }
    private  string GetApiPath()
    {
        //get folder path of the current executable
        string currentPath = AppDomain.CurrentDomain.BaseDirectory;
        var frontEndSubPath = "BilltrickV2\\BilltrickV2\\BilltrickV2\\bin\\Debug\\net9.0-windows10.0.19041.0\\win10-x64";
        var apiSubPath = "BilltrickV2\\BillTrickV2.API\\bin\\Debug\\net9.0";

        if (currentPath.Contains(frontEndSubPath))
        {
            currentPath = currentPath.Replace(frontEndSubPath, apiSubPath);


        }
        else
        {

            currentPath = Path.Combine(currentPath, "DAL");
        }

        if (File.Exists(Path.Combine(currentPath, "BilltrickV2.API.exe")))
        {
            return Path.Combine(currentPath, "BilltrickV2.API.exe");
        }
        Logger.LogError("API executable not found at expected path: {currentPath}", currentPath);
        return "";
    }
