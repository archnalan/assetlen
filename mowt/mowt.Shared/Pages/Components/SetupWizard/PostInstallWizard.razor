    #endregion
    void CopyDirectory(string sourceDir, string destinationDir)
    {
        foreach (var dir in Directory.GetDirectories(sourceDir, "*", SearchOption.AllDirectories))
        {
            Directory.CreateDirectory(dir.Replace(sourceDir, destinationDir));
        }

        foreach (var file in Directory.GetFiles(sourceDir, "*.*", SearchOption.AllDirectories))
        {
            var destFile = file.Replace(sourceDir, destinationDir);
            File.Copy(file, destFile, true);
        }
    }
    public void InstallService(
        string serviceName,
        string binPath
        )
    {
        try
        {

            // Stop and delete existing service
            ExecuteScCommand($"stop \"{serviceName}\"", true);
            ExecuteScCommand($"delete \"{serviceName}\"", true);

            // Create service
            try { 
                var commonAppData = Environment.GetFolderPath(Environment.SpecialFolder.CommonApplicationData);
                var serviceTargetDir = Path.Combine(commonAppData, "BilltrickV2","BGWorker");

                Directory.CreateDirectory(serviceTargetDir);
                var currentDir = Path.GetDirectoryName( binPath);
                // Copy all files and subdirectories
                CopyDirectory(currentDir, serviceTargetDir);
                var serviceTargetPath = Path.Combine(serviceTargetDir, "BilltrickV2.BGWorker.exe");

                ExecuteScCommand($"create \"{serviceName}\" binpath= \"{serviceTargetPath}\" start= auto");
            }
            catch (Exception ex)
            {
                Logger.LogError("Failed to create service. Please check the service name and binary path., {ex}", ex);
                ToastService.ShowError("Failed to create Background service. Please restart you PC first and try again or contact Support");
                InstallService(
                serviceName,
                binPath
                );
                return;
            }

            // Start service
            var (exitCode, output) = ExecuteScCommand($"start \"{serviceName}\"");

            if (exitCode == 0)
            {
                Logger.LogInformation("Service installed and started successfully");
                ToastService.ShowSuccess("Billtrick BG Service installed. Remember to change the logon account for the service in windows Services");

            }
            else
            {
                Logger.LogError($"Service start failed (Error: {exitCode}). Check path: {binPath}");
                ToastService.ShowError($"Failed to start service. Check path: {binPath}");
                return;
            }
        }
        catch (Exception ex)
        {


            Logger.LogError("Installation failed: {ex}", ex);
            ToastService.ShowError($"Installation failed: {ex}");


        }
    }

   
   
    private (int exitCode, string output) ExecuteScCommand(string arguments, bool suppressErrors = false)
    {
        using (var process = new Process())
        {
            process.StartInfo = new ProcessStartInfo
                {
                    FileName = "sc.exe",
                    Arguments = arguments,
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                    UseShellExecute = false,
                    CreateNoWindow = true
                };

            process.Start();
            string output = process.StandardOutput.ReadToEnd();
            process.WaitForExit();

            if (!suppressErrors && process.ExitCode != 0)
            {
                string error = process.StandardError.ReadToEnd();
                throw new Exception($"sc.exe command failed (Error {process.ExitCode}): {arguments}\n{error}");
            }

            return (process.ExitCode, output);
        }
    }

    private string BuildConnectionString()
    {
        var name = string.IsNullOrEmpty(instanceName) ? string.Empty : "\\" + instanceName  ;

        return useWindowsAuth
            ? $"Data Source={serverName}{name};Initial Catalog={databaseName};Integrated Security=True;Encrypt=True;Trust Server Certificate=True;"
            : $"Data Source={serverName}{name};Initial Catalog={databaseName};User Id={sqlUsername};Password={sqlPassword};Encrypt=True;Trust Server Certificate=True;";
    }



