@using mowt.Shared.Models.Models
@inject IAuthorizationApi _auth
@inject NavigationManager _nav
@inject ILogger<ForgotPasswordForm> _logger

<div class="form-header">
    <h2>Reset Your Password</h2>
    <p>Enter your email or phone number to receive reset instructions</p>
</div>

<div class="form-fields" style="margin-top: 1.5rem;">
    <div class="field-group">
        <label>Email or Phone Number</label>
        <FluentTextField @bind-Value="identifier" Placeholder="email@example.com or +256..." Style="width:100%;"
                         Disabled="@isLoading" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message" style="color: var(--error-color, #e53e3e); font-size: 14px; margin-top: 0.5rem;">
            @errorMessage
        </div>
    }

    <FluentButton Appearance="Appearance.Accent" Style="width: 100%; min-height: 2.5rem; margin-top: 1rem;"
                  OnClick="HandleSubmit"                  Loading="@isLoading">
        Send Reset Instructions
    </FluentButton>

    <FluentButton Appearance="Appearance.Outline" Style="width: 100%; min-height: 2.5rem; margin-top: 0.75rem;"
                  OnClick="OnBackToLogin"                  Disabled="@isLoading">
        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowLeft())" Style="margin-right: 0.5rem;" />
        Back to Sign In
    </FluentButton>
</div>

@code {
    [Parameter] public EventCallback OnBackToLogin { get; set; }
    [Parameter] public EventCallback<string> OnEmailSent { get; set; }
    [Parameter] public EventCallback<PhoneResetData> OnPhoneSent { get; set; }

    private string identifier = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleSubmit()
    {
        try
        {
            errorMessage = "";

            if (string.IsNullOrWhiteSpace(identifier))
            {
                errorMessage = "Please enter your email or phone number";
                return;
            }

            isLoading = true;
            StateHasChanged();

            // Get the origin domain for the reset link
            var originDomain = _nav.BaseUri.TrimEnd('/');

            var result = await _auth.InitiatePasswordReset(identifier.Trim(), originDomain);

            if (result.IsSuccessStatusCode)
            {
                var message = result.Content ?? "Reset instructions sent";

                // Check if it's email or phone based on the response
                if (message.Contains("email", StringComparison.OrdinalIgnoreCase))
                {
                    // Email path - show success message
                    await OnEmailSent.InvokeAsync(identifier);
                }
                else if (message.Contains("phone", StringComparison.OrdinalIgnoreCase))
                {
                    // Phone path - move to OTP verification
                    await OnPhoneSent.InvokeAsync(new PhoneResetData { PhoneNumber = identifier });
                }
                else
                {
                    // Generic success
                    await OnEmailSent.InvokeAsync(identifier);
                }
            }
            else
            {
                var error = result.Error?.Content;
                if (!string.IsNullOrEmpty(error))
                {
                    try
                    {
                        var errorObj = Newtonsoft.Json.JsonConvert.DeserializeObject<Newtonsoft.Json.Linq.JToken>(error);
                        errorMessage = errorObj?["message"]?.ToString() ?? "Failed to send reset instructions";
                    }
                    catch
                    {
                        errorMessage = "Failed to send reset instructions";
                    }
                }
                else
                {
                    errorMessage = "Failed to send reset instructions";
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error initiating password reset");
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public class PhoneResetData
    {
        public string PhoneNumber { get; set; }
    }
}