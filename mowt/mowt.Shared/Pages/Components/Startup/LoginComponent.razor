@using System.Security.Cryptography
@using System.Text
@using Microsoft.Extensions.Configuration
@using mowt.Shared.Layout;
@using mowt.Shared.Models.Models
@using mowt.Shared.Models.statics
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@using System.Security.Claims
@inject CustomAuthStateProvider _custAuth
@inject ISD _sd
@page "/login"
@layout EmptyLayout
@inject ILogger<LoginComponent> _logger
@inject IConfiguration _config
@inject IStorageService _storageService

<div class="login-page">
    <FluentDesignTheme @bind-Mode="@Mode" @bind-officeColor="ThemeColor" StorageName="" />

    <!-- Left: Illustration / Branding Panel -->
    <div class="login-brand-panel">
        <div class="brand-content">
            <div class="brand-logo">
               <img src="~/Ministry_of_Works.png" alt="Ministry of Works and Transport"/>
            </div>
            <h1 class="brand-title">MoWT Digital Library</h1>
            <p class="brand-description">
                Access Uganda's official Ministry of Works and Transport's road manuals, specifications, and guidelines - all
                in one digital platform.
            </p>
            <div class="brand-features">
                <div class="brand-feature">
                    <FluentIcon Value="@(new Icons.Regular.Size20.BookOpen())" Color="Color.Custom"
                                CustomColor="rgba(255,255,255,0.9)" />
                    <span>Official MoWT documents</span>
                </div>
                <div class="brand-feature">
                    <FluentIcon Value="@(new Icons.Regular.Size20.PhoneDesktop())" Color="Color.Custom"
                                CustomColor="rgba(255,255,255,0.9)" />
                    <span>Read on any device</span>
                </div>
                <div class="brand-feature">
                    <FluentIcon Value="@(new Icons.Regular.Size20.CloudSync())" Color="Color.Custom"
                                CustomColor="rgba(255,255,255,0.9)" />
                    <span>Sync your progress</span>
                </div>
            </div>
            <!-- Decorative illustration -->
            <div class="brand-illustration">
                <svg width="280" height="200" viewBox="0 0 280 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Book stack -->
                    <rect x="60" y="120" width="160" height="16" rx="3" fill="rgba(255,255,255,0.12)" />
                    <rect x="70" y="104" width="140" height="16" rx="3" fill="rgba(255,255,255,0.1)" />
                    <rect x="80" y="88" width="120" height="16" rx="3" fill="rgba(255,255,255,0.08)" />
                    <!-- Open book -->
                    <path d="M100 60 L140 75 L180 60 L180 88 L140 103 L100 88Z" fill="rgba(255,255,255,0.15)"
                          stroke="rgba(255,255,255,0.25)" stroke-width="1.5" />
                    <line x1="140" y1="75" x2="140" y2="103" stroke="rgba(255,255,255,0.2)" stroke-width="1" />
                    <!-- Reading lines -->
                    <line x1="108" y1="70" x2="135" y2="80" stroke="rgba(255,255,255,0.15)" stroke-width="1.5" />
                    <line x1="110" y1="76" x2="133" y2="85" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" />
                    <line x1="145" y1="80" x2="172" y2="70" stroke="rgba(255,255,255,0.15)" stroke-width="1.5" />
                    <line x1="147" y1="85" x2="170" y2="76" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" />
                    <!-- Floating dots -->
                    <circle cx="50" cy="50" r="4" fill="rgba(255,255,255,0.08)" />
                    <circle cx="230" cy="40" r="6" fill="rgba(255,255,255,0.06)" />
                    <circle cx="40" cy="140" r="3" fill="rgba(255,255,255,0.1)" />
                    <circle cx="240" cy="130" r="5" fill="rgba(255,255,255,0.07)" />
                </svg>
            </div>
        </div>
    </div>

    <!-- Right: Auth Forms Panel -->
    <div class="login-form-panel">
        <div class="form-container">
            @if (!string.IsNullOrEmpty(statics.startUpErrorMessage))
            {
                <div class="startup-error">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Color="Color.Custom" CustomColor="#e53e3e" />
                    <span>@statics.startUpErrorMessage</span>
                </div>
            }

            @if (showVerification)
            {
                <!-- Email Verification View -->
                <EmailVerificationForm Email="@unverifiedEmail"
                                       OnVerificationComplete="OnVerificationComplete"
                                       OnBackToLogin="() => { showVerification = false; ClearErrors(); }" />
            }
            else if (showForgotPassword)
            {
                @if (forgotPasswordStep == ForgotPasswordStep.InitialRequest)
                {
                    <ForgotPasswordForm OnBackToLogin="() => { showForgotPassword = false; forgotPasswordStep = ForgotPasswordStep.InitialRequest; }"
                                        OnEmailSent="HandleEmailSent"
                                        OnPhoneSent="HandlePhoneSent" />
                }
                else if (forgotPasswordStep == ForgotPasswordStep.EmailSent)
                {
                    <div class="form-header">
                        <h2>Check Your Email</h2>
                        <p>We've sent password reset instructions to <strong>@resetIdentifier</strong></p>
                    </div>
                    <div style="margin-top: 1.5rem; text-align: center;">
                        <FluentIcon Value="@(new Icons.Regular.Size48.CheckmarkCircle())" Color="Color.Success" />
                        <p style="margin-top: 1rem; color: var(--neutral-foreground-rest); font-size: 14px;">
                            The email may take a few minutes to arrive. Please check your spam folder if you don't see it.
                        </p>
                        <FluentButton Appearance="Appearance.Outline" 
                                      Style="width: 100%; min-height: 2.5rem; margin-top: 1.5rem;" 
                                      @onclick="() => { showForgotPassword = false; forgotPasswordStep = ForgotPasswordStep.InitialRequest; }">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowLeft())" Style="margin-right: 0.5rem;" />
                            Back to Sign In
                        </FluentButton>
                    </div>
                }
                else if (forgotPasswordStep == ForgotPasswordStep.PhoneVerification)
                {
                    <PhoneResetVerification PhoneNumber="@resetIdentifier"
                                            OnBackToForgot="() => forgotPasswordStep = ForgotPasswordStep.InitialRequest"
                                            OnVerified="HandlePhoneVerified" />
                }
                else if (forgotPasswordStep == ForgotPasswordStep.ResetPassword)
                {
                    <ResetPasswordForm Identifier="@resetIdentifier"
                                       ResetToken="@resetToken"
                                       VerificationCode="@verificationCode"
                                       OnSuccess="HandleResetSuccess"
                                       OnCancel="() => { showForgotPassword = false; forgotPasswordStep = ForgotPasswordStep.InitialRequest; }" />
                }
            }
            else if (!showSignup)
            {
                <!-- Sign In View -->
                <div class="form-header">
                    <h2>Welcome back</h2>
                    <p>Sign in to continue to your digital library</p>
                </div>

                <LoginForm LoginDto="_loginDto" HandleLogin="HandleLogin" EditContext="editContext" isLoading="loading"
                           ClearErrors="OnErrorsClear" OnForgotPassword="ShowForgotPassword" />

                <div class="auth-divider">
                    <span>or</span>
                </div>

                <FluentButton Appearance="Appearance.Outline" Loading=loading
                              Style="width: 100%; min-height: 2.5rem; font-weight: 500; margin-bottom: 0.75rem;"
                              @onclick="SignInWithGoogle">
                    <svg width="18" height="18" viewBox="0 0 18 18" style="margin-right: 0.5rem;">
                        <path
                        d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615Z"
                        fill="#4285F4" />
                        <path
                        d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18Z"
                        fill="#34A853" />
                        <path
                        d="M3.964 10.706A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.706V4.962H.957A8.997 8.997 0 0 0 0 9c0 1.452.348 2.827.957 4.038l3.007-2.332Z"
                        fill="#FBBC05" />
                        <path
                        d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.962L3.964 7.294C4.672 5.166 6.656 3.58 9 3.58Z"
                        fill="#EA4335" />
                    </svg>
                    Continue with Google
                </FluentButton>

                <FluentButton Appearance="Appearance.Outline" Style="width: 100%; min-height: 2.5rem; font-weight: 500;"
                              @onclick="() => showSignup = true">
                    <FluentIcon Value="@(new Icons.Regular.Size20.PersonAdd())" Style="margin-right: 0.5rem;" />
                    Create an account
                </FluentButton>
            }
            else
            {
                <!-- Sign Up View -->
                <div class="form-header">
                    <h2>Create your account</h2>
                    <p>Choose how you'd like to sign up</p>
                </div>

                <SignupForm OnSignupComplete="OnSignupComplete" OnBackToLogin="() => showSignup = false"
                            OnSignupWithGoogle="HandleLoginWithGoogle" />
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string returnUrl { get; set; } = "";

    [SupplyParameterFromQuery]
    public string? token { get; set; }

    [SupplyParameterFromQuery]
    public string? email { get; set; }

    private UserLogin _loginDto = new();
    private EditContext editContext = default!;
    private ValidationMessageStore messageStore = default!;
    private bool loading;
    private bool showSignup = false;
    private bool showVerification = false;
    private bool showForgotPassword = false;
    private string unverifiedUserId = string.Empty;
    private string unverifiedEmail = string.Empty;
    private DesignThemeModes Mode = DesignThemeModes.Dark;
    private OfficeColor? ThemeColor = OfficeColor.Word;

    // Forgot password flow
    private ForgotPasswordStep forgotPasswordStep = ForgotPasswordStep.InitialRequest;
    private string resetIdentifier = "";
    private string? resetToken = null;
    private string? verificationCode = null;

    private enum ForgotPasswordStep
    {
        InitialRequest,
        EmailSent,
        PhoneVerification,
        ResetPassword
    }

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(_loginDto);
        messageStore = new ValidationMessageStore(editContext);

        var uri = _nav.ToAbsoluteUri(_nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var code = query["code"];

        if (!string.IsNullOrEmpty(code))
        {
            await HandleGoogleLoginCallback(code);
        }
        // Check if this is a password reset link from email
        else if (!string.IsNullOrEmpty(token) && !string.IsNullOrEmpty(email))
        {
            showForgotPassword = true;
            forgotPasswordStep = ForgotPasswordStep.ResetPassword;
            resetIdentifier = email;
            resetToken = token;
            StateHasChanged();
        }
    }

    private async Task HandleGoogleLoginCallback(string code)
    {
        var verifier = await _localStorage.GetItemAsync<string>("pkce_verifier");

        var result = await _auth.ExternalLoginCallback(new GoogleAuthRequestDto { CodeVerifier = verifier, Code = code });
        await _localStorage.RemoveItemAsync("pkce_verifier");

        if (result.IsSuccessStatusCode)
        {
            var userObj = await _custAuth.GetAuthenticatedUser(result.Content);
            await ((CustomAuthStateProvider)_authStateProvider).MarkUserAsAuthenticated(result.Content);
            userObj.RolesDto = await GetRolesForUserById(userObj.Id);
            _sd.SetUser(userObj);

            // Navigate to return URL or home
            _nav.NavigateTo(string.IsNullOrEmpty(returnUrl) ? "/" : returnUrl);
        }
    }
    private async Task<UserRolesDto> GetRolesForUserById(string userId)
    {

        if (!string.IsNullOrEmpty(userId))
        {
            loading = true;

            var rolesTask = await _auth.GetRolesForUserByUserId(userId);

            loading = false;

            if (rolesTask.IsSuccessStatusCode)
            {
                return rolesTask.Content;
            }
            else if ((int)rolesTask.StatusCode < 500)
            {
                ToastService.ShowError(JsonConvert.DeserializeObject<JToken>(rolesTask.Error.Content)?["message"]?.ToString());
            }
            else ToastService.ShowError("Unknown error occurred. Please contact Admin");

        }
        return null;
    }
    private async Task HandleLogin()
    {
        try
        {
            ClearErrors();
            if (!editContext.Validate()) return;

            loading = true;
            StateHasChanged();

            var result = await _auth.Login(_loginDto);
            loading = false;

            if (result.IsSuccessStatusCode)
            {
                var userObj = await _custAuth.GetAuthenticatedUser(result.Content);
                await ((CustomAuthStateProvider)_authStateProvider).MarkUserAsAuthenticated(result.Content);
                userObj.RolesDto = await GetRolesForUserById(userObj.Id);
                _sd.SetUser(userObj);

                // Navigate to return URL or home
                _nav.NavigateTo(string.IsNullOrEmpty(returnUrl) ? "/" : returnUrl);
            }
            else
            {
                ClearErrors();
                var error = result.Error?.Content;
                if (!string.IsNullOrEmpty(error))
                {
                    try
                    {
                        var errors = JsonConvert.DeserializeObject<JToken>(error);
                        string message = errors?["message"]?.ToString() ?? "Invalid credentials";
                        
                        // Check if this is an email verification error
                        if (message.Contains("verify your email", StringComparison.OrdinalIgnoreCase) ||
                            message.Contains("verify your phone", StringComparison.OrdinalIgnoreCase))
                        {
                            // Try to find the user by email to get userId
                            unverifiedEmail = _loginDto.Email;
                            await ShowVerificationForm();
                        }
                        else
                        {
                            SetError(message);
                        }
                    }
                    catch
                    {
                        SetError("Invalid credentials");
                    }
                }
                else
                {
                    SetError("Invalid credentials");
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            loading = false;
            _logger.LogError(ex, "Error during login");
            ToastService.ShowError($"Login error: {ex.Message}");
        }
    }

    private async Task ShowVerificationForm()
    {
        // Simply show the verification form with the user's email
        unverifiedEmail = _loginDto.Email;
        showVerification = true;
        StateHasChanged();
    }

    private void OnVerificationComplete()
    {
        showVerification = false;
        unverifiedEmail = string.Empty;
        ToastService.ShowSuccess("Email verified! You can now log in.");
        StateHasChanged();
    }

    private void OnSignupComplete()
    {
        showSignup = false;
        ToastService.ShowSuccess("Account created! Please sign in.");
        StateHasChanged();
    }

    private async Task SignInWithGoogle()
    {
        try
        {
            loading = true;
            await HandleLoginWithGoogle();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error during Google sign-in");
            ToastService.ShowError("Google sign-in failed. Please try again.");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleLoginWithGoogle()
    {
        var verifier = GenerateCodeVerifier();
        var challenge = GenerateCodeChallenge(verifier);

        // store verifier temporarily
        await _storageService.SetItemAsync("pkce_verifier", verifier);

        var clientId = _config["Authentication:Google:ClientId"];
        var redirectUri = Uri.EscapeDataString(_nav.BaseUri + "login");
        var scope = Uri.EscapeDataString("openid email profile");

        var url =
            $"https://accounts.google.com/o/oauth2/v2/auth" +
            $"?client_id={clientId}" +
            $"&redirect_uri={redirectUri}" +
            $"&response_type=code" +
            $"&scope={scope}" +
            $"&code_challenge={challenge}" +
            $"&code_challenge_method=S256";

        _nav.NavigateTo(url, true);
    }

    string GenerateCodeVerifier()
    {
        var bytes = RandomNumberGenerator.GetBytes(32);
        return Base64UrlEncode(bytes);
    }

    string GenerateCodeChallenge(string verifier)
    {
        using var sha256 = SHA256.Create();
        var hash = sha256.ComputeHash(Encoding.ASCII.GetBytes(verifier));
        return Base64UrlEncode(hash);
    }

    string Base64UrlEncode(byte[] bytes)
    {
        return Convert.ToBase64String(bytes)
            .Replace("+", "-")
            .Replace("/", "_")
            .Replace("=", "");
    }

    private void SetError(string error)
    {
        messageStore.Clear();
        messageStore.Add(editContext.Field(""), error);
        editContext.NotifyValidationStateChanged();
    }

    private void ClearErrors()
    {
        messageStore.Clear();
        editContext.NotifyValidationStateChanged();
    }

    private void OnErrorsClear() => ClearErrors();

    private void ShowForgotPassword()
    {
        showForgotPassword = true;
        forgotPasswordStep = ForgotPasswordStep.InitialRequest;
        ClearErrors();
    }

    private void HandleEmailSent(string identifier)
    {
        resetIdentifier = identifier;
        forgotPasswordStep = ForgotPasswordStep.EmailSent;
        StateHasChanged();
    }

    private void HandlePhoneSent(ForgotPasswordForm.PhoneResetData data)
    {
        resetIdentifier = data.PhoneNumber;
        forgotPasswordStep = ForgotPasswordStep.PhoneVerification;
        StateHasChanged();
    }

    private void HandlePhoneVerified(string token)
    {
        // Store the verification code for password reset
        // The token returned is actually the reset token we need
        resetToken = token;
        forgotPasswordStep = ForgotPasswordStep.ResetPassword;
        StateHasChanged();
    }

    private void HandleResetSuccess()
    {
        showForgotPassword = false;
        forgotPasswordStep = ForgotPasswordStep.InitialRequest;
        resetIdentifier = "";
        resetToken = null;
        verificationCode = null;
        ToastService.ShowSuccess("Password reset successfully! You can now sign in with your new password.");
        StateHasChanged();
    }
}