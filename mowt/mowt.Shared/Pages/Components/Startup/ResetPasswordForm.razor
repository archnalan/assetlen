@using mowt.Shared.Models.Models
@inject IAuthorizationApi _auth
@inject NavigationManager _nav
@inject ILogger<ResetPasswordForm> _logger

<div class="form-header">
    <h2>Create New Password</h2>
    <p>Enter your new password below</p>
</div>

<div class="form-fields" style="margin-top: 1.5rem;">
    <div class="field-group">
        <label>New Password</label>
        <FluentTextField @bind-Value="newPassword" TextFieldType="TextFieldType.Password"
                         Placeholder="Enter new password" Style="width:100%;" Disabled="@isLoading" />
    </div>

    <div class="field-group">
        <label>Confirm Password</label>
        <FluentTextField @bind-Value="confirmPassword" TextFieldType="TextFieldType.Password"
                         Placeholder="Confirm new password" Style="width:100%;" Disabled="@isLoading" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message" style="color: var(--error-color, #e53e3e); font-size: 14px; margin-top: 0.5rem;">
            @errorMessage
        </div>
    }

    <FluentButton Appearance="Appearance.Accent" Style="width: 100%; min-height: 2.5rem; margin-top: 1rem;"
                  OnClick="HandleResetPassword"                  Loading="@isLoading">
        Reset Password
    </FluentButton>

    @if (!string.IsNullOrEmpty(ResetToken))
    {
        <FluentButton Appearance="Appearance.Outline" Style="width: 100%; min-height: 2.5rem; margin-top: 0.75rem;"
                      OnClick="OnCancel"                      Disabled="@isLoading">
            Cancel
        </FluentButton>
    }
</div>

@code {
    [Parameter] public string Identifier { get; set; } = "";
    [Parameter] public string? ResetToken { get; set; }
    [Parameter] public string? VerificationCode { get; set; }
    [Parameter] public EventCallback OnSuccess { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string newPassword = "";
    private string confirmPassword = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleResetPassword()
    {
        try
        {
            errorMessage = "";

            // Validate inputs
            if (string.IsNullOrWhiteSpace(newPassword))
            {
                errorMessage = "Password is required";
                return;
            }

            if (newPassword.Length < 4)
            {
                errorMessage = "Password must be at least 4 characters";
                return;
            }

            if (newPassword != confirmPassword)
            {
                errorMessage = "Passwords do not match";
                return;
            }

            if (string.IsNullOrEmpty(Identifier))
            {
                errorMessage = "Invalid reset request";
                return;
            }

            isLoading = true;
            StateHasChanged();

            var resetDto = new ResetPasswordDto
            {
                Identifier = Identifier,
                Password = newPassword,
                ResetToken = ResetToken,
                VerificationCode = VerificationCode
            };

            var result = await _auth.ResetPassword(resetDto);

            if (result.IsSuccessStatusCode)
            {
                await OnSuccess.InvokeAsync();
            }
            else
            {
                var error = result.Error?.Content;
                if (!string.IsNullOrEmpty(error))
                {
                    try
                    {
                        var errorObj = Newtonsoft.Json.JsonConvert.DeserializeObject<Newtonsoft.Json.Linq.JToken>(error);
                        errorMessage = errorObj?["message"]?.ToString() ?? "Failed to reset password";
                    }
                    catch
                    {
                        errorMessage = "Failed to reset password";
                    }
                }
                else
                {
                    errorMessage = "Failed to reset password";
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error resetting password");
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}