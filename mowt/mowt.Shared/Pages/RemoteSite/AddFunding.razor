@page "/project/{ProjectId}/add-funding"
@using mowt.Shared.Models.Models.RemoteSite
@using mowt.Shared.Models.Models.ViewModels.RemoteSiteDtos
@layout RemoteSiteLayout
@attribute [Authorize(Roles = "Investor")]
@inject NavigationManager Nav
@inject ILogger<AddFunding> Logger

<PageTitle>Record Deposit — Remote Site</PageTitle>

<div class="rs-page-header">
    <div>
        <a href="/project/@ProjectId" class="rs-btn rs-btn-link" style="padding:0;font-size:0.85rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Project
        </a>
        <h1 class="rs-page-title rs-mt-xs">Record Deposit</h1>
        <p class="rs-page-subtitle">Track a capital payment to your project</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="rs-alert rs-alert-error rs-mt-md">@errorMessage</div>
}

<div class="rs-card rs-mt-md">
    <div class="rs-card-body">
        <!-- Stage Selection -->
        <div class="rs-form-group">
            <label class="rs-label">Allocate to Stage *</label>
            @if (stages == null)
            {
                <div class="rs-skeleton rs-skeleton-line" style="height:40px;"></div>
            }
            else
            {
                <select class="rs-input" @bind="model.StageId">
                    <option value="">Select a stage...</option>
                    @foreach (var stage in stages)
                    {
                        <option value="@stage.Id">@stage.StageName — Budget: @((stage.BudgetAmount ?? 0).ToString("N0"))</option>
                    }
                </select>
            }
        </div>

        <!-- Amount -->
        <div class="rs-form-group">
            <label class="rs-label">Amount *</label>
            <input class="rs-input" type="number" step="any" @bind="model.Amount" placeholder="0" />
        </div>

        <!-- Payment Date -->
        <div class="rs-form-group">
            <label class="rs-label">Payment Date *</label>
            <input class="rs-input" type="date" @bind="model.PaymentDate" />
        </div>

        <!-- Notes -->
        <div class="rs-form-group">
            <label class="rs-label">Notes</label>
            <textarea class="rs-input rs-textarea" @bind="model.Notes" rows="2"
                      placeholder="e.g. Bank transfer ref #12345, Mobile Money, etc."></textarea>
        </div>
    </div>
</div>

<div class="rs-card rs-mt-sm">
    <div class="rs-card-body" style="text-align:center;">
        <div class="rs-text-xs rs-text-muted">
            Your project manager will need to confirm this deposit once materials are received.
        </div>
    </div>
</div>

<div class="rs-form-actions rs-mt-md rs-mb-lg">
    <a href="/project/@ProjectId" class="rs-btn rs-btn-secondary">Cancel</a>
    <button class="rs-btn rs-btn-primary" @onclick="SubmitFunding" disabled="@(isSaving || !CanSubmit)">
        @if (isSaving)
        {
            <span class="rs-spinner"></span>
            <text>Recording...</text>
        }
        else
        {
            <text>Record Deposit</text>
        }
    </button>
</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private FundingEntryCreateDto model = new()
    {
        PaymentDate = DateTime.Today
    };

    private List<StageDto>? stages;
    private bool isSaving;
    private string? errorMessage;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(model.StageId) && model.Amount > 0;

    protected override async Task OnInitializedAsync()
    {
        model.ProjectId = ProjectId;
        try
        {
            var resp = await _stagesApi.GetStagesByProjectId(ProjectId);
            if (resp.IsSuccessStatusCode)
                stages = resp.Content;
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading stages"); }
    }

    private async Task SubmitFunding()
    {
        if (isSaving || !CanSubmit) return;
        isSaving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var resp = await _fundingApi.AddFundingEntry(model);
            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo($"/project/{ProjectId}?tab=funding");
            }
            else
            {
                errorMessage = _apiResponseHandler.GetApiErrorMessage(resp) ?? "Failed to record deposit.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error recording deposit");
            errorMessage = "An unexpected error occurred.";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}
