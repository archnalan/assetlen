@page "/pm"
@using mowt.Shared.Models.Models.RemoteSite
@using mowt.Shared.Models.Models.ViewModels.RemoteSiteDtos
@layout RemoteSiteLayout
@attribute [Authorize(Roles = "ProjectManager")]
@inject NavigationManager Nav
@inject ILogger<PMDashboard> Logger

<PageTitle>Manager Dashboard — Remote Site</PageTitle>

@if (isLoading)
{
    <div class="rs-page-header">
        <div class="rs-skeleton rs-skeleton-line" style="width:220px;height:28px;"></div>
    </div>
    <div class="rs-summary-row">
        @for (int i = 0; i < 3; i++)
        {
            <div class="rs-skeleton rs-skeleton-stat"></div>
        }
    </div>
    <div class="rs-skeleton rs-skeleton-card" style="height:200px;margin-top:16px;"></div>
}
else if (dashboard == null)
{
    <div class="rs-empty">
        <h3 class="rs-empty-title">Unable to load dashboard</h3>
        <button class="rs-btn rs-btn-primary" @onclick="LoadDashboard">Retry</button>
    </div>
}
else
{
    <!-- Header -->
    <div class="rs-page-header">
        <div>
            <h1 class="rs-page-title">Manager Hub</h1>
            <p class="rs-page-subtitle">Your assigned projects</p>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="rs-summary-row">
        <div class="rs-stat-card">
            <div class="rs-stat-label">Active Projects</div>
            <div class="rs-stat-value">@dashboard.AssignedProjects.Count</div>
        </div>
        <div class="rs-stat-card">
            <div class="rs-stat-label">Pending Confirmations</div>
            <div class="rs-stat-value @(dashboard.PendingFundingCount > 0 ? "yellow" : "")">@dashboard.PendingFundingCount</div>
        </div>
        <div class="rs-stat-card">
            <div class="rs-stat-label">Recent Comments</div>
            <div class="rs-stat-value">@dashboard.RecentComments.Count</div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="rs-quick-actions rs-mt-md">
        @if (dashboard.PendingFundingCount > 0)
        {
            <div class="rs-quick-action-card" @onclick="@(() => activeSection = "funding")">
                <div class="rs-quick-action-icon yellow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div>
                    <div style="font-weight:600;">Confirm Deposits</div>
                    <div class="rs-text-xs rs-text-muted">@dashboard.PendingFundingCount awaiting confirmation</div>
                </div>
            </div>
        }
        @foreach (var project in dashboard.AssignedProjects.Take(3))
        {
            <div class="rs-quick-action-card" @onclick="() => NavigateToUpload(project.Id)">
                <div class="rs-quick-action-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
                <div>
                    <div style="font-weight:600;">Upload Progress</div>
                    <div class="rs-text-xs rs-text-muted">@project.ProjectName</div>
                </div>
            </div>
        }
    </div>

    <!-- Section Toggle -->
    <div class="rs-tabs rs-mt-lg">
        <button class="rs-tab @(activeSection == "projects" ? "active" : "")" @onclick='() => activeSection = "projects"'>My Projects</button>
        <button class="rs-tab @(activeSection == "funding" ? "active" : "")" @onclick="() => SwitchToFunding()">
            Pending Deposits
            @if (dashboard.PendingFundingCount > 0)
            {
                <span class="rs-badge-count">@dashboard.PendingFundingCount</span>
            }
        </button>
        <button class="rs-tab @(activeSection == "comments" ? "active" : "")" @onclick='() => activeSection = "comments"'>Comments</button>
    </div>

    <div class="rs-tab-content">
        @switch (activeSection)
        {
            case "projects":
                @RenderProjectsList();
                break;
            case "funding":
                @RenderPendingFunding();
                break;
            case "comments":
                @RenderComments();
                break;
        }
    </div>
}

@code {
    private PMDashboardDto? dashboard;
    private List<FundingEntryDto>? pendingFunding;
    private bool isLoading = true;
    private bool loadingFunding;
    private string activeSection = "projects";

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        try
        {
            var resp = await _progressApi.GetPMDashboard();
            if (resp.IsSuccessStatusCode && resp.Content != null)
                dashboard = resp.Content;
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading PM dashboard"); }
        finally { isLoading = false; }
    }

    private void SwitchToFunding()
    {
        activeSection = "funding";
        if (pendingFunding == null) _ = LoadPendingFunding();
    }

    private async Task LoadPendingFunding()
    {
        loadingFunding = true;
        StateHasChanged();
        try
        {
            var resp = await _fundingApi.GetPendingConfirmations();
            if (resp.IsSuccessStatusCode)
                pendingFunding = resp.Content;
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading pending funding"); }
        finally { loadingFunding = false; StateHasChanged(); }
    }

    // ─── PROJECTS LIST ──────────────────────────────────────────────
    private RenderFragment RenderProjectsList() => __builder =>
    {
        @if (dashboard!.AssignedProjects.Count == 0)
        {
            <div class="rs-empty rs-mt-md">
                <h3 class="rs-empty-title">No assigned projects</h3>
                <p class="rs-empty-desc">You'll see projects here once an investor assigns you as their project manager.</p>
            </div>
        }
        else
        {
            <div class="rs-projects-grid">
                @foreach (var project in dashboard.AssignedProjects)
                {
                    <div class="rs-project-card" @onclick="@(() => Nav.NavigateTo($"/project/{project.Id}"))">
                        <div class="rs-project-card-body" style="padding:16px;">
                            <div class="rs-project-card-header">
                                <h3 class="rs-project-card-title">@project.ProjectName</h3>
                                <span class="rs-risk-badge @project.RiskLevel.ToString().ToLower()">
                                    <span class="rs-risk-dot @project.RiskLevel.ToString().ToLower()"></span>
                                    @project.RiskLevel
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(project.Location))
                            {
                                <div class="rs-project-card-location">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    @project.Location
                                </div>
                            }
                            <div class="rs-project-card-metrics rs-mt-sm">
                                <div class="rs-metric">
                                    <span class="rs-metric-label">Funded</span>
                                    <span class="rs-metric-value">@project.FundedPercentage%</span>
                                </div>
                                <div class="rs-metric">
                                    <span class="rs-metric-label">Completed</span>
                                    <span class="rs-metric-value">@project.CompletedPercentage%</span>
                                </div>
                            </div>
                            <div class="rs-progress-bar rs-mt-sm">
                                <div class="rs-progress-fill @GetProgressColor(project.CompletedPercentage)"
                                     style="width:@(Math.Min(project.CompletedPercentage, 100))%"></div>
                            </div>
                            <div class="rs-project-card-footer rs-mt-sm">
                                <span class="rs-stage-badge">@project.CurrentStageName</span>
                                <button class="rs-btn rs-btn-primary rs-btn-sm" @onclick:stopPropagation @onclick="() => NavigateToUpload(project.Id)">
                                    + Update
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    };

    // ─── PENDING FUNDING ────────────────────────────────────────────
    private RenderFragment RenderPendingFunding() => __builder =>
    {
        @if (loadingFunding)
        {
            <div class="rs-skeleton rs-skeleton-card" style="height:100px;"></div>
        }
        else if (pendingFunding == null || !pendingFunding.Any())
        {
            <div class="rs-empty rs-mt-md">
                <h3 class="rs-empty-title">All clear</h3>
                <p class="rs-empty-desc">No pending deposit confirmations.</p>
            </div>
        }
        else
        {
            <div class="rs-funding-list">
                @foreach (var entry in pendingFunding)
                {
                    <div class="rs-funding-item">
                        <div class="rs-funding-header">
                            <div>
                                <div class="rs-funding-amount">@FormatCurrency(entry.Amount)</div>
                                <div class="rs-text-xs rs-text-muted">
                                    @(entry.PaymentDate?.ToString("MMM dd, yyyy") ?? "—") · @entry.ProjectName
                                    @if (!string.IsNullOrEmpty(entry.StageName)) { <text> · @entry.StageName</text> }
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(entry.Notes))
                        {
                            <div class="rs-text-sm rs-mt-xs">@entry.Notes</div>
                        }
                        <div class="rs-form-actions rs-mt-sm" style="justify-content:flex-end;padding:0;">
                            <button class="rs-btn rs-btn-danger-ghost rs-btn-sm" @onclick="() => ConfirmFunding(entry.Id, false)">Reject</button>
                            <button class="rs-btn rs-btn-primary rs-btn-sm" @onclick="() => ConfirmFunding(entry.Id, true)">Confirm</button>
                        </div>
                    </div>
                }
            </div>
        }
    };

    private async Task ConfirmFunding(string fundingId, bool confirm)
    {
        try
        {
            var dto = new FundingConfirmDto { FundingEntryId = fundingId, IsConfirmed = confirm };
            var resp = await _fundingApi.ConfirmFunding(dto);
            if (resp.IsSuccessStatusCode)
            {
                pendingFunding?.RemoveAll(f => f.Id == fundingId);
                if (dashboard != null) dashboard.PendingCount--;
                StateHasChanged();
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Error confirming funding"); }
    }

    // ─── COMMENTS ───────────────────────────────────────────────────
    private RenderFragment RenderComments() => __builder =>
    {
        @if (dashboard!.RecentComments.Count == 0)
        {
            <div class="rs-empty rs-mt-md">
                <h3 class="rs-empty-title">No recent comments</h3>
                <p class="rs-empty-desc">Investor comments on your updates will appear here.</p>
            </div>
        }
        else
        {
            <div class="rs-comment-list">
                @foreach (var comment in dashboard.RecentComments)
                {
                    <div class="rs-comment-item">
                        <div class="rs-avatar-sm">@(comment.AuthorName?[0])</div>
                        <div style="flex:1;">
                            <div style="display:flex;justify-content:space-between;">
                                <span style="font-weight:500;">@comment.AuthorName</span>
                                <span class="rs-text-xs rs-text-muted">@FormatTimeAgo(comment.DateTimeCreated)</span>
                            </div>
                            <p class="rs-text-sm rs-mt-xs" style="margin:0;">@comment.CommentText</p>
                        </div>
                    </div>
                }
            </div>
        }
    };

    // ─── HELPERS ────────────────────────────────────────────────────
    private void NavigateToUpload(string projectId)
    {
        Nav.NavigateTo($"/project/{projectId}/progress/add");
    }

    private string FormatCurrency(decimal amount)
    {
        if (amount >= 1_000_000_000) return $"{amount / 1_000_000_000:N1}B";
        if (amount >= 1_000_000) return $"{amount / 1_000_000:N1}M";
        if (amount >= 1_000) return $"{amount / 1_000:N1}K";
        return amount.ToString("N0");
    }

    private string FormatTimeAgo(DateTime? date)
    {
        if (!date.HasValue) return "—";
        var diff = DateTime.UtcNow - date.Value;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return date.Value.ToString("MMM dd");
    }

    private string GetProgressColor(decimal pct) =>
        pct >= 75 ? "green" : pct >= 40 ? "yellow" : "";
}
